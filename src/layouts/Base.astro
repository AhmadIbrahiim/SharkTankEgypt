---
import { t, googleVerification, type Lang } from '../config';
interface Props { lang: Lang; title?: string; description?: string; altPath: string; image?: string; jsonld?: object }
const { lang, title, description, altPath, image, jsonld } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const s = t[lang];
const other: Lang = lang === 'ar' ? 'en' : 'ar';
const abs = (path: string) => new URL(`${base}${path}`, Astro.site).href;
const url = new URL(Astro.url.pathname, Astro.site).href;
const altUrl = abs(altPath);
const [arUrl, enUrl] = lang === 'ar' ? [url, altUrl] : [altUrl, url];
const fullTitle = title ? `${title} | ${s.title}` : `${s.title} | ${t[other].title}`;
const desc = description ?? s.tagline;
---
<!doctype html>
<html lang={lang} dir={lang === 'ar' ? 'rtl' : 'ltr'}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={desc} />
    <link rel="canonical" href={url} />
    <link rel="alternate" hreflang="ar" href={arUrl} />
    <link rel="alternate" hreflang="en" href={enUrl} />
    <link rel="alternate" hreflang="x-default" href={arUrl} />
    <link rel="sitemap" href={`${base}/sitemap.xml`} />
    {googleVerification && <meta name="google-site-verification" content={googleVerification} />}
    <meta property="og:type" content={title ? 'article' : 'website'} />
    <meta property="og:site_name" content={s.title} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={desc} />
    <meta property="og:url" content={url} />
    <meta property="og:locale" content={lang === 'ar' ? 'ar_EG' : 'en_US'} />
    <meta property="og:locale:alternate" content={lang === 'ar' ? 'en_US' : 'ar_EG'} />
    {image && <meta property="og:image" content={abs(image)} />}
    <meta name="twitter:card" content={image ? 'summary_large_image' : 'summary'} />
    {jsonld && <script type="application/ld+json" set:html={JSON.stringify(jsonld)} />}
    <link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><text y='.9em' font-size='90'>🦈</text></svg>" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;600;800&display=swap" rel="stylesheet" />
  </head>
  <body>
    <header>
      <a class="brand" href={`${base}/${lang}/`}>🦈 {s.title}</a>
      <a class="lang" href={`${base}${altPath}`}>{s.switchLang}</a>
    </header>
    <main><slot /></main>
    <footer>
      <a href="https://github.com/AhmadIbrahiim/SharkTankEgypt">GitHub</a> ·
      <a href="https://github.com/AhmadIbrahiim/SharkTankEgypt/edit/main/src/data/startups.json">{s.edit}</a>
    </footer>
  </body>
</html>
<style is:global>
  :root {
    --bg: #f6f8fb; --card: #fff; --text: #14202e; --muted: #5b6b7c; --accent: #0a6cbd;
    --line: #dfe5ec; --ok: #12805c; --no: #a33a3a;
    color-scheme: light dark;
  }
  @media (prefers-color-scheme: dark) {
    :root { --bg: #0d1520; --card: #16212e; --text: #e6edf5; --muted: #95a5b6; --accent: #5aaeff; --line: #26354a; --ok: #4cc79a; --no: #ef8a8a; }
  }
  * { box-sizing: border-box; }
  body { margin: 0; font-family: Cairo, system-ui, sans-serif; background: var(--bg); color: var(--text); line-height: 1.6; }
  a { color: var(--accent); }
  header, main, footer { max-width: 1200px; margin: 0 auto; padding: 16px; }
  header { display: flex; justify-content: space-between; align-items: center; gap: 12px; }
  .brand { font-weight: 800; font-size: 1.2rem; text-decoration: none; color: var(--text); }
  .lang { border: 1px solid var(--line); border-radius: 999px; padding: 4px 14px; text-decoration: none; }
  footer { color: var(--muted); text-align: center; }
  .badge { display: inline-block; font-size: .8rem; padding: 1px 10px; border-radius: 999px; border: 1px solid var(--line); color: var(--muted); }
  .badge.ok { color: var(--ok); border-color: var(--ok); }
  .badge.no { color: var(--no); border-color: var(--no); }
  .shot { width: 100%; aspect-ratio: 16/10; object-fit: cover; object-position: top; background: var(--line); display: grid; place-items: center; font-size: 2.5rem; font-weight: 800; color: var(--muted); }
</style>

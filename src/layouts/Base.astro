---
import { t, goatcounter, googleVerification, categories, catSlug, category, seasons, seasonLabel, startups, sharks, founders, num, dataUpdated, type Lang, type Card } from '../config';
import { siteNodes, ID } from '../schema';
// Self-hosted variable font (Arabic + Latin subsets load on demand): no render-blocking third-party CSS.
import '@fontsource-variable/readex-pro/wght.css';
import '@fontsource-variable/source-serif-4/wght.css';
import '@fontsource-variable/noto-naskh-arabic/wght.css';
import fontAr from '@fontsource-variable/readex-pro/files/readex-pro-arabic-wght-normal.woff2?url';
import fontLatin from '@fontsource-variable/readex-pro/files/readex-pro-latin-wght-normal.woff2?url';
import serifAr from '@fontsource-variable/noto-naskh-arabic/files/noto-naskh-arabic-arabic-wght-normal.woff2?url';
import serifLatin from '@fontsource-variable/source-serif-4/files/source-serif-4-latin-wght-normal.woff2?url';
interface Props { lang: Lang; title?: string; description?: string; altPath: string; image?: string; jsonld?: object; card?: Card }
const { lang, title, description, altPath, image, jsonld, card } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const s = t[lang];
const other: Lang = lang === 'ar' ? 'en' : 'ar';
const abs = (path: string) => new URL(`${base}${path}`, Astro.site).href;
const url = new URL(Astro.url.pathname, Astro.site).href;
const altUrl = abs(altPath);
const [arUrl, enUrl] = lang === 'ar' ? [url, altUrl] : [altUrl, url];
const fullTitle = title ? `${title} | ${s.short}` : `${s.title} | ${t[other].title}`;
const desc = description ?? s.tagline;
// Search results show ~155 characters: cut at a word boundary (structured data keeps the full text).
const metaDesc = desc.length <= 158 ? desc : `${desc.slice(0, 157).replace(/[\s,،.؛;:–-]+\S*$/, '')}…`;
// Every page gets its own share image at /og/<path>.jpg, rendered from `og` after the build (scripts/og.mjs).
const og = card ?? { kind: 'page', title: title ?? s.title, sub: description ?? s.tagline, photo: image };
const ogPath = `/og/${Astro.url.pathname.slice(base.length).replace(/^\/|\/$/g, '') || 'index'}.jpg`;
// One @graph per page: site + publisher + show, this WebPage, its breadcrumb trail and the page's own entity.
const segs = Astro.url.pathname.slice(base.length).split('/').filter(Boolean);
const label = (k: string, prev?: string, prev2?: string): string | null => {
  if (!prev) return ({ sharks: s.navSharks, founders: s.navFounders, faq: s.navFaq, deals: s.navDeals } as Record<string, string>)[k] ?? startups.find((x) => x.id === k)?.name[lang] ?? null;
  if (prev === 'season') return seasonLabel(Number(k), lang);
  if (prev === 'episode') return lang === 'ar' ? `الحلقة ${num(Number(k), lang)}` : `Episode ${k}`;
  if (prev === 'category' || prev === 'sector') { const c = categories.find((c) => catSlug(c) === k); return c ? category(c, lang) : null; }
  if (prev === 'sharks' && !prev2) return sharks.find((p) => p.id === k)?.name[lang] ?? null;
  if (prev === 'founders' && !prev2) return founders.find((p) => p.id === k)?.name[lang] ?? null;
  return null; // "season", "category", "vs", "top"…: path levels with no page of their own
};
const crumbs = [{ name: s.home, url: abs(`/${lang}/`) }];
const startup = segs.length === 2 ? startups.find((x) => x.id === segs[1]) : undefined;
// Startup pages sit under their season, as in the visible breadcrumb.
if (startup) crumbs.push({ name: seasonLabel(startup.season, lang), url: abs(`/${lang}/season/${startup.season}/`) });
segs.slice(1).forEach((k, i, a) => {
  const name = label(k, a[i - 1], a[i - 2]) ?? (i === a.length - 1 ? title : null);
  if (name) crumbs.push({ name, url: abs(`/${segs.slice(0, i + 2).join('/')}/`) });
});
const { '@context': _ctx, ...entity } = (jsonld ?? {}) as Record<string, any>;
const pageTypes = ['FAQPage', 'CollectionPage', 'ProfilePage', 'WebPage'];
const isPage = pageTypes.includes(entity['@type']);
const isPerson = entity['@type'] === 'Person';
const page = {
  '@type': isPage ? entity['@type'] : isPerson ? 'ProfilePage' : segs.length <= 1 ? 'CollectionPage' : 'WebPage',
  '@id': `${url}#webpage`, url, name: fullTitle, description: desc, inLanguage: lang, isPartOf: { '@id': ID.site }, dateModified: dataUpdated,
  primaryImageOfPage: { '@type': 'ImageObject', url: abs(ogPath), width: 1200, height: 630 },
  ...(crumbs.length > 1 && { breadcrumb: { '@id': `${url}#breadcrumb` } }),
  ...(isPage ? (({ '@type': _t, ...rest }) => rest)(entity) : jsonld ? { mainEntity: { '@id': entity['@id'] ?? `${url}#main` } } : {}),
};
const graph = { '@context': 'https://schema.org', '@graph': [
  ...siteNodes(lang), page,
  ...(crumbs.length > 1 ? [{ '@type': 'BreadcrumbList', '@id': `${url}#breadcrumb`, itemListElement: crumbs.map((c, i) => ({ '@type': 'ListItem', position: i + 1, name: c.name, item: c.url })) }] : []),
  ...(jsonld && !isPage ? [{ '@id': `${url}#main`, ...entity, mainEntityOfPage: { '@id': `${url}#webpage` } }] : []),
] };
const section = /\/(sharks|founders|faq|deals)\//.exec(Astro.url.pathname)?.[1] ?? 'startups';
---
<!doctype html>
<html lang={lang} dir={lang === 'ar' ? 'rtl' : 'ltr'}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="preload" href={lang === 'ar' ? fontAr : fontLatin} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={lang === 'ar' ? serifAr : serifLatin} as="font" type="font/woff2" crossorigin />
    <meta name="theme-color" content="#FBF8F2" media="(prefers-color-scheme: light)" />
    <meta name="application-name" content={s.brandName} />
    <meta name="theme-color" content="#FBF8F2" media="(prefers-color-scheme: dark)" />
    <title>{fullTitle}</title>
    <meta name="description" content={metaDesc} />
    <link rel="canonical" href={url} />
    <link rel="alternate" hreflang="ar" href={arUrl} />
    <link rel="alternate" hreflang="en" href={enUrl} />
    <link rel="alternate" hreflang="x-default" href={arUrl} />
    <link rel="sitemap" href={`${base}/sitemap.xml`} />
    {googleVerification && <meta name="google-site-verification" content={googleVerification} />}
    <meta property="og:type" content={title ? 'article' : 'website'} />
    <meta property="og:site_name" content={s.title} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={metaDesc} />
    <meta property="og:url" content={url} />
    <meta property="og:locale" content={lang === 'ar' ? 'ar_EG' : 'en_US'} />
    <meta property="og:locale:alternate" content={lang === 'ar' ? 'en_US' : 'ar_EG'} />
    <meta property="og:image" content={abs(ogPath)} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={fullTitle} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={abs(ogPath)} />
    <script type="application/json" id="og-card" set:html={JSON.stringify(og)} />
    <script type="application/ld+json" set:html={JSON.stringify(graph)} />
    <link rel="icon" href={`${base}/favicon.svg`} type="image/svg+xml" />
    <link rel="icon" href={`${base}/favicon-32.png`} sizes="32x32" type="image/png" />
    <link rel="apple-touch-icon" href={`${base}/apple-touch-icon.png`} />
    <link rel="manifest" href={`${base}/site.webmanifest`} />
    {goatcounter && <script is:inline data-goatcounter={`https://${goatcounter}.goatcounter.com/count`} async src="//gc.zgo.at/count.js"></script>}
  </head>
  <body>
    <a class="skip" href="#main">{lang === 'ar' ? 'تخطَّ إلى المحتوى' : 'Skip to content'}</a>
    <header class="site-header">
      <div class="container bar">
        <a class="brand" href={`${base}/${lang}/`} aria-label={`${s.brandName} – ${s.brandSub}`}>
          <img class="mark" src={`${base}/favicon.svg`} alt="" width="40" height="40" />
          <span class="word"><b>{s.brandName}</b><small>{s.brandSub}</small></span>
        </a>
        <nav class="nav" aria-label={s.navMain}>
          <a href={`${base}/${lang}/`} aria-current={section === 'startups' ? 'page' : undefined}>{s.navStartups}</a>
          <a href={`${base}/${lang}/sharks/`} aria-current={section === 'sharks' ? 'page' : undefined}>{s.navSharks}</a>
          <a href={`${base}/${lang}/founders/`} aria-current={section === 'founders' ? 'page' : undefined}>{s.navFounders}</a>
          <a href={`${base}/${lang}/deals/`} aria-current={section === 'deals' ? 'page' : undefined}>{s.navDeals}</a>
          <a href={`${base}/${lang}/faq/`} aria-current={section === 'faq' ? 'page' : undefined}>{s.navFaqTab}</a>
        </nav>
        <a class="search-btn" href={`${base}/${lang}/#q`} aria-label={s.search} title={s.search}>
          <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" d="m20 20-4.2-4.2M11 18a7 7 0 1 0 0-14 7 7 0 0 0 0 14Z"/></svg>
        </a>
        <a class="lang" href={`${base}${altPath}`} hreflang={other} lang={other}>
          <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true"><path fill="none" stroke="currentColor" stroke-width="1.8" d="M12 3a9 9 0 1 0 0 18 9 9 0 0 0 0-18Zm-9 9h18M12 3c2.5 2.6 3.8 5.6 3.8 9s-1.3 6.4-3.8 9c-2.5-2.6-3.8-5.6-3.8-9S9.5 5.6 12 3Z"/></svg>
          {s.switchLang}
        </a>
      </div>
    </header>
    <script>
      // Phones: the two-row header slides away while scrolling down and comes back on scroll up.
      const h = document.querySelector('.site-header')!;
      let last = scrollY;
      // --hdr: the header's visible height, for sticky bars below it (0 while the phone header is slid away).
      const phone = matchMedia('(max-width: 640px)');
      const setH = () => document.documentElement.style.setProperty('--hdr', `${phone.matches && h.classList.contains('away') ? 0 : h.offsetHeight}px`);
      addEventListener('scroll', () => { const y = scrollY; const away = y > last && y > 120; if (away !== h.classList.contains('away')) { h.classList.toggle('away', away); setH(); } last = y; }, { passive: true });
      addEventListener('resize', setH); setH();
    </script>

    <main id="main"><slot /></main>

    <footer class="site-footer">
      <div class="container">
        <div class="contribute">
          <div>
            <h2>{s.contributeTitle}</h2>
            <p>{s.contributeText}</p>
          </div>
          <a class="btn btn-primary" href="https://github.com/AhmadIbrahiim/SharkTankEgypt/edit/main/src/data/startups.json">{s.edit}</a>
        </div>
        <div class="foot-grid">
          <div class="foot-brand">
            <a class="brand big" href={`${base}/${lang}/`}>
              <img class="mark" src={`${base}/logo-reversed.svg`} alt={`${s.brandName} – ${s.brandSub}`} width="150" height="108" loading="lazy" />
            </a>
            <p>{s.footerTagline}</p>
            <a class="gh" href="https://github.com/AhmadIbrahiim/SharkTankEgypt">
              <svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true"><path fill="currentColor" d="M8 0a8 8 0 0 0-2.53 15.59c.4.07.55-.17.55-.38v-1.35c-2.23.48-2.7-1.07-2.7-1.07-.36-.92-.89-1.17-.89-1.17-.73-.5.06-.49.06-.49.8.06 1.23.83 1.23.83.72 1.22 1.88.87 2.34.66.07-.52.28-.87.5-1.07-1.78-.2-3.65-.89-3.65-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82a7.6 7.6 0 0 1 4 0c1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.28.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48v2.2c0 .21.15.46.55.38A8 8 0 0 0 8 0Z"/></svg>
              {s.openSource}
            </a>
          </div>
          <nav aria-label={s.explore}>
            <h3>{s.explore}</h3>
            <a href={`${base}/${lang}/`}>{s.navStartups}</a>
            <a href={`${base}/${lang}/sharks/`}>{s.navSharks}</a>
            <a href={`${base}/${lang}/founders/`}>{s.navFounders}</a>
            <a href={`${base}/${lang}/deals/`}>{lang === 'ar' ? 'كل الصفقات' : 'All deals'}</a>
            <a href={`${base}/${lang}/compare/`}>{lang === 'ar' ? 'قارن بين الشركات' : 'Compare startups'}</a>
            <a href={`${base}/${lang}/faq/`}>{s.navFaq}</a>
            <a href={`${base}${altPath}`} hreflang={other} lang={other}>{s.switchLang}</a>
          </nav>
          <nav aria-label={s.browseSeasons}>
            <h3>{s.browseSeasons}</h3>
            {[...seasons].sort((a, b) => (a.season || 3.5) - (b.season || 3.5)).map((x) => <a href={`${base}/${lang}/season/${x.season}/`}>{seasonLabel(x.season, lang)}</a>)}
          </nav>
          <nav aria-label={s.browseSectors} class="sectors">
            <h3>{s.browseSectors}</h3>
            <p>{categories.map((c) => <a href={`${base}/${lang}/category/${catSlug(c)}/`}>{category(c, lang)}</a>)}</p>
          </nav>
        </div>
        <p class="fine">© {num(new Date().getFullYear(), lang).replace(/[٬,]/g, '')} {s.brandName} · {s.madeWith} · {lang === 'ar' ? 'آخر تحديث للبيانات' : 'Data updated'} <time datetime={dataUpdated}>{dataUpdated}</time> · <a href={`${base}/data/deals.csv`} lang="en">CSV</a> · <a href={`${base}/llms.txt`} lang="en">llms.txt</a></p>
      </div>
    </footer>
  </body>
</html>

<style is:global>
  /* Bite Stamp palette: crimson and cream like an archive stamp, sea teal for the water, green for deals, gold for highlights. One theme. */
  :root {
    --bg: #f4efe6; --surface: #fbf8f2; --surface-2: #ece4d6; --line: #e3d7c3; --rule: #8e1b1b;
    --ink: #2a1a14; --ink-2: #6b5b4f;
    --crimson: #8e1b1b; --sun: #8e1b1b; --sun-ink: #8e1b1b; --sun-soft: #f3e1dc;
    --navy: #2a1a14; --gold: #c8962e; --gold-ink: #6e4f0f;
    --nile: #1f5f66; --nile-soft: #dbe9ea;
    --ok: #2f6b3a; --ok-soft: #e2eee3;
    --shadow: 0 1px 2px rgb(42 26 20 / .06), 0 6px 18px -8px rgb(42 26 20 / .18);
    --shadow-lift: 0 2px 4px rgb(42 26 20 / .08), 0 14px 30px -12px rgb(42 26 20 / .28);
    --radius: 6px;
    --gap-sec: 48px;
    --serif: 'Source Serif 4 Variable', 'Noto Naskh Arabic Variable', Georgia, serif;
    color-scheme: light;
  }
  [dir='rtl'] { --serif: 'Noto Naskh Arabic Variable', 'Source Serif 4 Variable', serif; }
  *, *::before, *::after { box-sizing: border-box; }
  html { -webkit-text-size-adjust: 100%; }
  body {
    margin: 0; min-height: 100vh; display: flex; flex-direction: column;
    font-family: 'Readex Pro Variable', system-ui, sans-serif; font-weight: 350; line-height: 1.65;
    background: var(--bg); color: var(--ink);
  }
  main { flex: 1; }
  h1, h2, h3 { line-height: 1.2; font-weight: 650; margin: 0; text-wrap: balance; }
  h1 { font-weight: 800; letter-spacing: -.02em; }
  h2 { font-family: var(--serif); font-weight: 700; letter-spacing: -.01em; }
  [dir='rtl'] h1, [dir='rtl'] h2 { letter-spacing: 0; }
  [dir='rtl'] h2 { line-height: 1.45; }
  @media (max-width: 640px) { :root { --gap-sec: 34px; } }
  p { text-wrap: pretty; }
  a { color: var(--sun-ink); text-underline-offset: 3px; }
  img { max-width: 100%; display: block; }
  :focus-visible { outline: 2px solid var(--sun); outline-offset: 2px; }
  .container { width: 100%; max-width: 1180px; margin-inline: auto; padding-inline: 20px; }
  .skip { position: absolute; inset-inline-start: 12px; top: -60px; background: var(--ink); color: var(--bg); padding: 8px 14px; z-index: 50; }
  .skip:focus { top: 12px; }

  /* Masthead: solid paper, a heavy rule under it. */
  .site-header { position: sticky; top: 0; z-index: 20; background: var(--surface); border-bottom: 3px solid var(--crimson); }
  .site-header .word b { color: var(--crimson); }
  .site-header .nav a { color: var(--ink-2); }
  .site-header .nav a[aria-current='page'], .site-header .nav a:hover { color: var(--crimson); }
  .site-header .search-btn, .site-header .lang { color: var(--ink); border-color: var(--line); }
  .site-header .search-btn:hover, .site-header .lang:hover { border-color: var(--crimson); }
  .bar { display: flex; align-items: center; justify-content: space-between; height: 64px; }
  .brand { display: flex; align-items: center; gap: 10px; color: var(--ink); text-decoration: none; }
  .mark { width: 38px; height: 38px; display: block; }
  .word { display: flex; flex-direction: column; line-height: 1.1; }
  .word b { font-weight: 900; font-size: 1.05rem; letter-spacing: .03em; text-transform: uppercase; }
  [dir='rtl'] .word b { letter-spacing: 0; font-size: 1.15rem; }
  .word small { font-size: .68rem; font-weight: 500; color: var(--ink-2); margin-top: 3px; }
  [dir='rtl'] .word small { text-transform: none; letter-spacing: 0; font-size: .74rem; }
  .brand.big .mark { width: 44px; height: 44px; }
  .brand.big .word b { font-size: 1.45rem; }
  .nav { display: flex; gap: 22px; margin-inline: auto 22px; }
  .nav a { display: inline-flex; align-items: center; min-height: 40px; color: var(--ink-2); text-decoration: none; font-size: .93rem; white-space: nowrap; border-bottom: 2px solid transparent; }
  .nav a:hover { color: var(--ink); }
  .nav a[aria-current='page'] { font-weight: 600; border-bottom-color: var(--crimson); }
  .search-btn { display: inline-grid; place-items: center; width: 36px; height: 36px; margin-inline-end: 8px; color: var(--ink); border: 1px solid var(--line); }
  .search-btn:hover { border-color: var(--ink); }
  .site-header { transition: transform .25s ease; }
  @media (max-width: 640px) { .site-header.away { transform: translateY(-100%); } }
  @media (max-width: 640px) { .bar { flex-wrap: wrap; height: auto; padding-block: 6px 0; gap: 6px; } .brand { margin-inline-end: auto; } .site-header .mark { width: 30px; height: 30px; } .nav { order: 3; width: 100%; gap: 0; justify-content: safe center; margin: 0; overflow-x: auto; scrollbar-width: none; border-top: 1px solid var(--line); } .nav a { flex: 1 1 auto; justify-content: center; min-height: 40px; padding: 0 6px; font-size: .82rem; } .site-header .word small { display: none; } .site-header .word b { font-size: .9rem; letter-spacing: .03em; } .lang { padding: 6px 10px; } .lang svg { display: none; } .search-btn { width: 34px; height: 34px; margin-inline-end: 6px; } }
  @media (max-width: 370px) { .nav a { padding: 0 4px; font-size: .76rem; } .site-header .word b { font-size: .98rem; } }
  .lang { display: inline-flex; align-items: center; gap: 6px; padding: 6px 12px; border: 1px solid var(--line); color: var(--ink); text-decoration: none; font-size: .9rem; }
  .lang:hover { border-color: var(--ink); }

  .btn { display: inline-flex; align-items: center; justify-content: center; gap: 8px; padding: 10px 18px; border-radius: 0; font: inherit; font-weight: 500; text-decoration: none; border: 1px solid transparent; cursor: pointer; transition: background .15s, border-color .15s; white-space: nowrap; }
  .btn-primary { background: var(--sun); color: #fff; font-weight: 600; border-radius: var(--radius); }
  .btn-primary:hover { background: var(--ink); }
  .btn-ghost { background: var(--surface); color: var(--sun-ink); border: 1px solid var(--line); border-radius: var(--radius); }
  .btn-ghost:hover { border-color: var(--sun); }

  /* Labels: small, ruled, no pills. */
  .badge { display: inline-flex; align-items: center; gap: 5px; font-size: .72rem; font-weight: 600; padding: 2px 7px; border-radius: 3px; background: var(--surface-2); color: var(--ink-2); white-space: nowrap; letter-spacing: .03em; }
  .badge.ok { background: var(--ok); color: #fff; }
  .badge.nile { background: var(--nile-soft); color: var(--nile); }

  /* Screenshot or pitch still, framed like a photo in print. */
  .frame { background: var(--surface-2); overflow: hidden; border-radius: var(--radius); }
  .frame-bar { display: none; }
  .shot { width: 100%; height: auto; aspect-ratio: 16 / 9; object-fit: cover; object-position: top; background: var(--surface); }
  .frame.video { position: relative; background: #000; }
  .frame.video .shot { object-position: center; }
  .play { position: absolute; inset-inline-start: 10px; bottom: 10px; width: 34px; height: 34px; border-radius: 50%; background: rgb(0 0 0 / .65); border: 1.5px solid rgb(255 255 255 / .85); }
  .play::after { content: ''; position: absolute; inset: 0; margin: auto; translate: 2px 0; width: 0; height: 0; border-block: 7px solid transparent; border-left: 11px solid #fff; }
  a:hover .play, button:hover .play { background: var(--sun); }
  .ph { display: grid; place-items: center; padding: 16px; text-align: center; font-size: clamp(1.2rem, 2.6vw, 1.6rem); font-weight: 800; line-height: 1.2; color: var(--bg); background: #24403f; position: relative; }
  .ph .og { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }

  .avatar { display: inline-grid; place-items: center; width: 28px; height: 28px; border-radius: 50%; font-size: .72rem; font-weight: 600; color: var(--ink); background: var(--surface-2); border: 1px solid var(--line); }

  .site-footer { margin-top: 72px; padding-block: 36px 28px; background: #2a1a14; color: #e8ddcf; --ink: #f4efe6; --ink-2: #bfae9d; --line: rgb(244 239 230 / .16); --surface: rgb(244 239 230 / .06); --sun-ink: var(--gold); }
  .site-footer .btn-primary { background: var(--crimson); color: #f4efe6; }
  .site-footer .brand.big .mark { width: 150px; height: auto; }
  .contribute { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 20px; padding-bottom: 28px; border-bottom: 1px solid var(--line); }
  .contribute h2 { font-size: 1.35rem; }

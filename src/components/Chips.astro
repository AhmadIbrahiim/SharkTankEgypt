---
// A titled row of pill links, used to cross-link the long-tail pages.
interface Props { title: string; links: { href: string; label: string }[] }
const { title, links } = Astro.props;
---
{links.length > 0 && (
  <nav class="chips" aria-label={title}>
    <h2>{title}</h2>
    <p>{links.map((l) => <a href={l.href}>{l.label}</a>)}</p>
  </nav>
)}
<style>
  .chips { margin-top: var(--gap-sec); }
  .chips h2 { font-size: 1.25rem; margin-bottom: 10px; padding-bottom: 6px; border-bottom: 1px solid var(--ink); }
  .chips p { display: flex; flex-wrap: wrap; gap: 4px 18px; margin: 0; }
  .chips a { display: inline-flex; align-items: center; min-height: 32px; color: var(--ink); text-decoration: none; font-size: .95rem; }
  .chips a:hover { color: var(--sun-ink); text-decoration: underline; }
</style>

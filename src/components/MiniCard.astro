---
import Shot from './Shot.astro';
import { t, money, pct, seasonLabel, category, type Lang, type Startup, pre } from '../config';
interface Props { x: Startup; lang: Lang }
const { x, lang } = Astro.props;
const s = t[lang];
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<a class="mini" href={`${base}${pre(lang)}/${x.id}/`}>
  <Shot id={x.id} name={x.name[lang]} lang={lang} video={x.video} />
  <span class="mb">
    <strong>{x.name[lang]}</strong>
    <small>{seasonLabel(x.season, lang)}{x.category && ` · ${category(x.category, lang)}`}</small>
    {x.deal?.made && x.deal.amountEGP != null && <em>{s.deal}: {money(x.deal.amountEGP, lang)}{x.deal.equityPct != null && ` · ${pct(x.deal.equityPct, lang)}`}</em>}
    {x.deal?.made === false && <small><b>{s.noDeal}</b></small>}
    {x.deal?.made == null && <small class="unk">{s.unknownOutcome}</small>}
    {!x.deal?.made && x.ask?.amountEGP != null && <small class="amount">{s.asked} {money(x.ask.amountEGP, lang)}{x.ask.equityPct != null && ` · ${pct(x.ask.equityPct, lang)}`}</small>}
    {x.deal?.made && x.deal.amountEGP == null && <em>{s.deal}</em>}
  </span>
</a>
<style>
  .mini { display: flex; flex-direction: column; height: 100%; padding-top: 10px; border-top: 2px solid var(--ink); color: inherit; text-decoration: none; }
  .mini:hover strong { color: var(--sun-ink); text-decoration: underline; text-decoration-thickness: 1px; }
  .mini :global(.frame-bar) { display: none; }
  .mb { display: flex; flex-direction: column; gap: 2px; padding: 10px 0 4px; }
  strong { font-family: var(--serif); font-weight: 700; font-size: 1.1rem; line-height: 1.25; }
  small { color: var(--ink-2); font-size: .82rem; }
  em { font-style: normal; color: var(--ok); font-weight: 600; font-size: .88rem; }
  em, .amount { font-family: var(--serif); }
  small b { font-weight: 600; color: var(--ink); }
  .unk { font-style: italic; }
  @media (max-width: 560px) { .mini { padding-top: 8px; } .mb { padding: 8px 0 2px; } strong { font-size: .92rem; line-height: 1.25; } small, em { font-size: .78rem; } }
</style>

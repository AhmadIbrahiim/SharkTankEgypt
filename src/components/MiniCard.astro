---
import Shot from './Shot.astro';
import { t, money, pct, seasonLabel, category, type Lang, type Startup } from '../config';
interface Props { x: Startup; lang: Lang }
const { x, lang } = Astro.props;
const s = t[lang];
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<a class="mini" href={`${base}/${lang}/${x.id}/`}>
  <Shot id={x.id} name={x.name[lang]} video={x.video} />
  <span class="mb">
    <strong>{x.name[lang]}</strong>
    <small>{seasonLabel(x.season, lang)}{x.category && ` · ${category(x.category, lang)}`}</small>
    {x.deal?.made && x.deal.amountEGP != null && <em>{money(x.deal.amountEGP, lang)}{x.deal.equityPct != null && ` · ${pct(x.deal.equityPct, lang)}`}</em>}
    {x.deal?.made === false && <small>{s.noDeal}</small>}
  </span>
</a>
<style>
  .mini { display: flex; flex-direction: column; height: 100%; padding: 8px; border-radius: 16px; background: var(--surface); box-shadow: var(--shadow); color: inherit; text-decoration: none; transition: transform .2s, box-shadow .2s; }
  .mini:hover { transform: translateY(-3px); box-shadow: var(--shadow-lift); }
  .mini :global(.frame-bar) { display: none; }
  .mb { display: flex; flex-direction: column; gap: 2px; padding: 10px 6px 4px; }
  strong { font-weight: 600; }
  small { color: var(--ink-2); font-size: .82rem; }
  em { font-style: normal; color: var(--ok); font-weight: 600; font-size: .88rem; }
</style>

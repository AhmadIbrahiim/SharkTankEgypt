---
import { screenshot } from '../config';
interface Props { id: string; name: string }
const { id, name } = Astro.props;
const src = screenshot(id);
---
{src
  ? <img class="shot" src={`${import.meta.env.BASE_URL.replace(/\/$/, '')}${src}`} alt={name} loading="lazy" />
  : <div class="shot" aria-hidden="true">{name.slice(0, 2)}</div>}

---
import { googleVerification } from '../config';
// Root redirects to Arabic; it also carries the Search Console tag, which Google checks on this URL.
const to = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/ar/`;
---
<!doctype html>
<html lang="ar">
  <head>
    <meta charset="utf-8" />
    <title>Shark Tank Egypt Directory · دليل شارك تانك مصر</title>
    <meta name="robots" content="noindex" />
    <meta name="google-site-verification" content={googleVerification} />
    <link rel="canonical" href={new URL(to, Astro.site).href} />
    <meta http-equiv="refresh" content={`0;url=${to}`} />
  </head>
  <body><a href={to}>دليل شارك تانك مصر</a></body>
</html>

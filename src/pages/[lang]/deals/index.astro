---
// Every recorded deal on one page: the table assistants and readers cite for "list of Shark Tank Egypt deals".
import Base from '../../../layouts/Base.astro';
import Faq from '../../../components/Faq.astro';
import { ROOT, ID } from '../../../schema';
import { langs, startups, sharks, seasons, money, pct, num, seasonLabel, shark, valuation, dataUpdated, category, categories, catSlug, type Lang } from '../../../config';
import { programFaq, list } from '../../../faq';

export const getStaticPaths = () => langs.map((lang) => ({ params: { lang } }));
const lang = Astro.params.lang as Lang;
const ar = lang === 'ar';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const deals = startups.filter((x) => x.deal?.made).sort((a, b) => (b.deal!.amountEGP ?? -1) - (a.deal!.amountEGP ?? -1) || a.season - b.season);
const noDeals = startups.filter((x) => x.deal?.made === false).length;
const unknown = startups.length - deals.length - noDeals;
const total = deals.reduce((a, x) => a + (x.deal!.amountEGP ?? 0), 0);
const bySeason = [...seasons].sort((a, b) => (a.season || 3.5) - (b.season || 3.5)).map((s) => {
  const xs = startups.filter((x) => x.season === s.season), d = xs.filter((x) => x.deal?.made);
  return { s, pitched: xs.length, deals: d.length, sum: d.reduce((a, x) => a + (x.deal!.amountEGP ?? 0), 0) };
});
const bySharks = sharks.filter((p) => p.deals.length).map((p) => ({ p, n: p.deals.length, sum: p.deals.reduce((a, x) => a + (x.deal?.amountEGP ?? 0), 0) }));
// Analytics. Unknown values are left out of every figure; each row says how many deals it covers.
const median = (xs: number[]) => { const a = [...xs].sort((p, q) => p - q), m = a.length >> 1; return a.length ? (a.length % 2 ? a[m] : (a[m - 1] + a[m]) / 2) : null; };
const mean = (xs: number[]) => (xs.length ? xs.reduce((p, q) => p + q, 0) / xs.length : null);
const amounts = deals.flatMap((x) => (x.deal!.amountEGP != null ? [x.deal!.amountEGP] : []));
const vals = deals.flatMap((x) => { const v = valuation(x.deal!.amountEGP, x.deal!.equityPct); return v ? [v] : []; });
const both = deals.filter((x) => x.deal!.amountEGP != null && x.ask?.amountEGP);
const eqBoth = deals.filter((x) => x.deal!.equityPct != null && x.ask?.equityPct != null);
const ratio = median(both.map((x) => x.deal!.amountEGP! / x.ask!.amountEGP!));
const eqAsk = mean(eqBoth.map((x) => x.ask!.equityPct!)), eqGot = mean(eqBoth.map((x) => x.deal!.equityPct!));
const bySector = categories.map((c) => {
  const xs = startups.filter((x) => x.category === c), d = xs.filter((x) => x.deal?.made), known = xs.filter((x) => x.deal?.made != null);
  return { c, pitched: xs.length, deals: d.length, rate: known.length ? d.length / known.length : null, sum: d.reduce((a, x) => a + (x.deal!.amountEGP ?? 0), 0) };
}).sort((a, b) => b.deals - a.deals);
const fx = (n: number, d = 1) => new Intl.NumberFormat(ar ? 'ar-EG' : 'en-US', { maximumFractionDigits: d }).format(n);
const title = ar ? 'كل صفقات شارك تانك مصر' : 'Every Shark Tank Egypt deal';
const intro = ar
  ? `${num(deals.length, lang)} صفقة مسجلة من ${num(startups.length, lang)} شركة عرضت في البرنامج، باستثمارات معلنة ${money(total, lang)}. خرجت ${num(noDeals, lang)} شركة دون صفقة، ولم يؤكد أي مصدر نتيجة ${num(unknown, lang)} عرضاً بعد.`
  : `${deals.length} recorded deals from ${startups.length} startups that pitched, worth ${money(total, lang)} in disclosed investment. ${noDeals} left without a deal; ${unknown} outcomes are not yet confirmed by any source.`;
const faq = programFaq(lang).general.filter((x) => /deal|invest|صفق|استثمر|ضخ/i.test(x.q));
const jsonld = {
  '@context': 'https://schema.org', '@type': 'Dataset', '@id': `${ROOT}en/deals/#dataset`,
  name: title, description: intro, inLanguage: ['ar', 'en'], dateModified: dataUpdated, isAccessibleForFree: true,
  license: 'https://creativecommons.org/licenses/by/4.0/', creator: { '@id': ID.org }, about: { '@id': ID.series },
  keywords: ['Shark Tank Egypt', 'شارك تانك مصر', 'startups', 'investment', 'Egypt'],
  distribution: [
    { '@type': 'DataDownload', encodingFormat: 'text/csv', contentUrl: `${ROOT}data/deals.csv` },
    { '@type': 'DataDownload', encodingFormat: 'application/json', contentUrl: `${ROOT}data/startups.json` },
  ],
};
---
<Base lang={lang} title={title} description={intro} jsonld={jsonld} altPath={`/${ar ? 'en' : 'ar'}/deals/`}>
  <div class="container">
    <header class="intro">
      <h1>{title}</h1>
      <p>{intro}</p>
      <p class="dl">
        <a href={`${base}/data/deals.csv`} download>⬇ CSV</a>
        <a href={`${base}/data/startups.json`}>⬇ JSON</a>
        <a href={`${base}/${lang}/compare/?ids=${deals.slice(0, 2).map((x) => x.id).join(',')}`}>{ar ? 'قارن بين الشركات' : 'Compare startups'}</a>
        <span>{ar ? 'آخر تحديث للبيانات' : 'Data updated'}: <time datetime={dataUpdated}>{dataUpdated}</time></span>
      </p>
    </header>

    <section>
      <h2>{ar ? 'كم صفقة في كل موسم؟' : 'How many deals were made in each season?'}</h2>
      <div class="scroll"><table>
        <thead><tr><th>{ar ? 'الموسم' : 'Season'}</th><th>{ar ? 'شركات عرضت' : 'Pitched'}</th><th>{ar ? 'صفقات' : 'Deals'}</th><th>{ar ? 'الاستثمار المعلن' : 'Disclosed investment'}</th></tr></thead>
        <tbody>{bySeason.map((r) => <tr><td><a href={`${base}/${lang}/season/${r.s.season}/`}>{seasonLabel(r.s.season, lang)}</a></td><td>{num(r.pitched, lang)}</td><td>{num(r.deals, lang)}</td><td>{money(r.sum, lang) ?? '—'}</td></tr>)}</tbody>
      </table></div>
    </section>

    <section>
      <h2>{ar ? 'كم صفقة أبرم كل مستثمر؟' : 'How many deals has each shark made?'}</h2>
      <div class="scroll"><table>
        <thead><tr><th>{ar ? 'المستثمر' : 'Shark'}</th><th>{ar ? 'صفقات' : 'Deals'}</th><th>{ar ? 'قيمة الصفقات التي شارك فيها' : 'Value of deals joined'}</th></tr></thead>
        <tbody>{bySharks.map((r) => <tr><td><a href={`${base}/${lang}/sharks/${r.p.id}/`}>{r.p.name[lang]}</a></td><td>{num(r.n, lang)}</td><td>{money(r.sum, lang) ?? '—'}</td></tr>)}</tbody>
      </table></div>
    </section>

    <section>
      <h2>{ar ? 'أرقام الصفقات في سطور' : 'Deals in numbers'}</h2>
      <dl class="kpis">
        <div><dt>{ar ? 'متوسط الصفقة' : 'Average deal'}</dt><dd>{money(mean(amounts), lang)}<small>{ar ? `${num(amounts.length, lang)} صفقة بمبلغ معلن` : `${amounts.length} deals with a disclosed amount`}</small></dd></div>
        <div><dt>{ar ? 'الصفقة الوسيطة' : 'Median deal'}</dt><dd>{money(median(amounts), lang)}<small>{ar ? 'نصف الصفقات أقل منها' : 'half the deals are smaller'}</small></dd></div>
        <div><dt>{ar ? 'التقييم الوسيط' : 'Median valuation'}</dt><dd>{money(median(vals), lang)}<small>{ar ? `${num(vals.length, lang)} صفقة بمبلغ ونسبة` : `${vals.length} deals with amount and equity`}</small></dd></div>
        <div><dt>{ar ? 'المبلغ المتفق عليه ÷ المطلوب' : 'Agreed ÷ asked amount'}</dt><dd>{ratio != null ? `${fx(ratio, 2)}×` : '—'}<small>{ar ? `الوسيط، ${num(both.length, lang)} صفقة` : `median, ${both.length} deals`}</small></dd></div>
        <div><dt>{ar ? 'الحصة: المعروضة ← المتفق عليها' : 'Equity: offered → agreed'}</dt><dd>{eqAsk != null && eqGot != null ? `${fx(eqAsk)}% ${ar ? '←' : '→'} ${fx(eqGot)}%` : '—'}<small>{ar ? `المتوسط، ${num(eqBoth.length, lang)} صفقة` : `average, ${eqBoth.length} deals`}</small></dd></div>
      </dl>
    </section>

    <section>
      <h2>{ar ? 'الصفقات حسب المجال' : 'Deals by sector'}</h2>
      <div class="scroll"><table>
        <thead><tr><th>{ar ? 'المجال' : 'Sector'}</th><th>{ar ? 'شركات عرضت' : 'Pitched'}</th><th>{ar ? 'صفقات' : 'Deals'}</th><th>{ar ? 'نسبة الصفقات*' : 'Deal rate*'}</th><th>{ar ? 'الاستثمار المعلن' : 'Disclosed investment'}</th></tr></thead>
        <tbody>{bySector.map((r) => <tr><td><a href={`${base}/${lang}/category/${catSlug(r.c)}/`}>{category(r.c, lang)}</a></td><td>{num(r.pitched, lang)}</td><td>{num(r.deals, lang)}</td><td>{r.rate != null ? pct(r.rate * 100, lang) : '—'}</td><td>{money(r.sum, lang) ?? '—'}</td></tr>)}</tbody>
      </table></div>
    </section>

    <section class="method">
      <h2>{ar ? 'كيف نحسب هذه الأرقام' : 'How these numbers are calculated'}</h2>
      <ul>{(ar ? [
        'الصفقة هي اتفاق أُعلن على الهواء ويذكره مصدر علني؛ لا نتتبع ما إذا اكتمل الاستثمار قانونيًا بعد البرنامج.',
        'الاستثمار المعلن هو مجموع مبالغ الصفقات المعلنة فقط، فهو حدّ أدنى وليس إجماليًا.',
        'التقييم = المبلغ ÷ (الحصة ÷ ١٠٠)، ويُحسب فقط عند معرفة المبلغ والحصة معًا.',
        '* نسبة الصفقات = الصفقات ÷ العروض معروفة النتيجة؛ العروض غير المؤكدة لا تُحتسب صفقةً ولا رفضًا.',
        'كل رقم يذكر عدد الصفقات التي يغطيها، والقيم غير المعروفة مستبعدة ولا تُقدَّر.',
      ] : [
        'A deal is an agreement made on air and stated by a public source; whether the investment later closed legally is not tracked.',
        'Disclosed investment sums only the deals whose amount is public, so it is a floor, not a total.',
        'Valuation = amount ÷ (equity ÷ 100), shown only when both are known.',
        '* Deal rate = deals ÷ pitches with a known outcome; unconfirmed pitches count as neither deal nor no-deal.',
        'Each figure states how many deals it covers; unknown values are left out, never estimated.',
      ]).map((li) => <li>{li}</li>)}</ul>
    </section>

    <section>
      <h2>{ar ? 'حاسبة التقييم' : 'Valuation calculator'}</h2>
      <form class="calc" id="calc" onsubmit="return false">
        <label>{ar ? 'المبلغ (جنيه)' : 'Amount (EGP)'}<input id="ca" type="number" inputmode="decimal" min="1" step="any" value="1000000" /></label>
        <label>{ar ? 'الحصة (%)' : 'Equity (%)'}<input id="ce" type="number" inputmode="decimal" min="0.01" max="100" step="any" value="20" /></label>
        <output id="co" aria-live="polite"></output>
      </form>
      <p class="note">{ar ? 'التقييم بعد الاستثمار = المبلغ ÷ (الحصة ÷ ١٠٠)؛ التقييم قبل الاستثمار = التقييم بعد الاستثمار − المبلغ.' : 'Post-money valuation = amount ÷ (equity ÷ 100); pre-money valuation = post-money − amount.'}</p>
    </section>

    <section>
      <h2>{ar ? 'قائمة كل الصفقات' : 'All deals'}</h2>
      <div class="scroll"><table class="all">
        <thead><tr><th>{ar ? 'الشركة' : 'Startup'}</th><th>{ar ? 'الموسم' : 'Season'}</th><th>{ar ? 'المستثمرون' : 'Sharks'}</th><th>{ar ? 'المبلغ' : 'Amount'}</th><th>{ar ? 'الحصة' : 'Equity'}</th><th>{ar ? 'التقييم' : 'Valuation'}</th></tr></thead>
        <tbody>{deals.map((x) => {
          const v = valuation(x.deal!.amountEGP, x.deal!.equityPct);
          return <tr>
            <td><a href={`${base}/${lang}/${x.id}/`}>{x.name[lang]}</a></td>
            <td>{seasonLabel(x.season, lang, true)}{x.episode != null && ` · ${ar ? 'ح' : 'E'}${num(x.episode, lang)}`}</td>
            <td>{x.deal!.sharks?.length ? list(x.deal!.sharks.map((n) => shark(n, lang)), lang) : (ar ? 'غير مذكور' : 'not named')}</td>
            <td>{money(x.deal!.amountEGP, lang) ?? '—'}</td>
            <td>{x.deal!.equityPct != null ? pct(x.deal!.equityPct, lang) : '—'}</td>
            <td>{v ? money(v, lang) : '—'}</td>
          </tr>;
        })}</tbody>
      </table></div>
      <p class="note">{ar ? 'تُسجَّل الصفقة فقط عندما يذكرها مصدر علني صراحة؛ مصادر كل شركة في صفحتها.' : 'A deal is recorded only when a public source states it; each startup page lists its sources.'}</p>
    </section>

    <Faq lang={lang} items={faq} />
  </div>
</Base>

<script>
  // Valuation calculator: post = amount / (equity / 100), pre = post - amount.
  const ar = document.documentElement.lang === 'ar';
  const nf = new Intl.NumberFormat(ar ? 'ar-EG' : 'en-US', { maximumFractionDigits: 0 });
  const a = document.getElementById('ca') as HTMLInputElement, e = document.getElementById('ce') as HTMLInputElement, o = document.getElementById('co')!;
  const run = () => {
    const amt = +a.value, eq = +e.value;
    if (!(amt > 0) || !(eq > 0 && eq <= 100)) { o.textContent = ar ? 'أدخل مبلغًا أكبر من صفر وحصة بين ٠ و١٠٠٪.' : 'Enter an amount above 0 and equity between 0 and 100%.'; return; }
    const post = amt / (eq / 100);
    o.textContent = ar ? `بعد الاستثمار: ${nf.format(post)} جنيه · قبل الاستثمار: ${nf.format(post - amt)} جنيه` : `Post-money: EGP ${nf.format(post)} · Pre-money: EGP ${nf.format(post - amt)}`;
  };
  a.addEventListener('input', run); e.addEventListener('input', run); run();
</script>
<style>
  .intro { margin: 28px 0 8px; }
  .intro h1 { font-size: clamp(1.9rem, 4.4vw, 2.9rem); }
  .dl { display: flex; flex-wrap: wrap; gap: 8px 16px; align-items: center; color: var(--ink-2); font-size: .92rem; }
  .dl a { font-weight: 600; }
  section { margin-top: var(--gap-sec); }
  h2 { font-size: 1.2rem; margin-bottom: 10px; }
  .scroll { overflow-x: auto; border-top: 2px solid var(--ink); border-bottom: 1px solid var(--ink); }
  table { width: 100%; border-collapse: collapse; font-size: .93rem; }
  th, td { padding: 9px 12px; border-top: 1px solid var(--line); text-align: start; white-space: nowrap; }
  thead th { border-top: 0; color: var(--ink-2); font-weight: 500; font-size: .85rem; }
  table.all td:nth-child(3) { white-space: normal; min-width: 12rem; }
  .note { color: var(--ink-2); font-size: .88rem; margin-top: 8px; }
  .kpis { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 200px), 1fr)); gap: 12px; margin: 0; }
  .kpis div { padding: 10px 0 4px; border-top: 2px solid var(--ink); }
  .kpis dt { color: var(--ink-2); font-size: .85rem; }
  .kpis dd { margin: 4px 0 0; font-size: 1.35rem; font-weight: 650; }
  .kpis small { display: block; margin-top: 2px; color: var(--ink-2); font-size: .8rem; font-weight: 400; }
  .method ul { margin: 0; padding-inline-start: 20px; color: var(--ink-2); max-width: 75ch; }
  .calc { display: flex; flex-wrap: wrap; gap: 12px 16px; align-items: end; padding: 16px 0; border-block: 1px solid var(--ink); }
  .calc label { display: flex; flex-direction: column; gap: 4px; font-size: .88rem; color: var(--ink-2); }
  .calc input { font: inherit; width: 11rem; padding: 8px 12px; border: 1px solid var(--line); border-radius: 2px; background: var(--bg); color: var(--ink); }
  .calc output { flex: 1 1 260px; font-weight: 600; color: var(--ink); }
</style>

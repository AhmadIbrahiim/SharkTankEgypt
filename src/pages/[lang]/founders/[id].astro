---
import Base from '../../../layouts/Base.astro';
import { ID, photo, startupRef } from '../../../schema';
import Avatar from '../../../components/Avatar.astro';
import Links from '../../../components/Links.astro';
import MiniCard from '../../../components/MiniCard.astro';
import Faq from '../../../components/Faq.astro';
import { founderFaq, summary, list } from '../../../faq';
import { langs, founders, t, founderId, suggestUrl, seasonLabel, type Lang, digits } from '../../../config';

export const getStaticPaths = () => langs.flatMap((lang) => founders.map((p) => ({ params: { lang, id: p.id }, props: { p } })));
const lang = Astro.params.lang as Lang;
const { p } = Astro.props as { p: typeof founders[number] };
const s = t[lang];
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const partners = [...new Set(p.startups.flatMap((x) => x.founders ?? []))].filter((n) => founderId(n) !== p.id);
const byId = new Map(founders.map((f) => [f.id, f]));
const { website, ...links } = (p.links ?? {}) as Record<string, string>;
const title = p.title?.[lang] ?? p.startups.map((x) => x.name[lang]).join(lang === 'ar' ? '، ' : ', ');
const jsonld = {
  '@context': 'https://schema.org', '@type': 'Person', '@id': ID.founder(p.id), url: new URL(`${base}/${lang}/founders/${p.id}/`, Astro.site).href, name: p.name[lang], alternateName: p.name[lang === 'ar' ? 'en' : 'ar'], ...(p.title && { jobTitle: p.title.en }),
  ...(p.bio && { description: p.bio[lang] }), sameAs: Object.values(p.links ?? {}),
  worksFor: p.startups.map(startupRef), ...(p.photo && { image: photo(p.photo) }),
};
---
<Base lang={lang} title={`${p.name[lang]} (${p.name[lang === 'ar' ? 'en' : 'ar']}) – ${title}`} description={p.bio?.[lang] ?? `${lang === 'ar' ? `${p.name.ar} من مؤسسي ${list(p.startups.map((x) => x.name.ar), lang)}.` : `${p.name.en} is a founder of ${list(p.startups.map((x) => x.name.en), lang)}.`} ${summary(p.startups[0], lang)}`} jsonld={jsonld}
  card={{ kind: 'person', title: p.name[lang], alt: p.name.ar !== p.name.en ? p.name[lang === 'ar' ? 'en' : 'ar'] : undefined, photo: p.photo?.url, sub: title,
    eyebrow: `${lang === 'ar' ? 'مؤسس في شارك تانك مصر' : 'Founder on Shark Tank Egypt'} · ${seasonLabel(p.startups[0].season, lang)}`,
    badge: p.startups.some((x) => x.deal?.made) ? { tone: 'ok', text: lang === 'ar' ? 'حصل على صفقة' : 'Got a deal' } : p.startups.every((x) => x.deal?.made === false) ? { tone: 'no', text: lang === 'ar' ? 'بدون صفقة' : 'No deal' } : undefined }}
  altPath={`/${lang === 'ar' ? 'en' : 'ar'}/founders/${p.id}/`}>
  <div class="container">
    <nav class="crumbs"><a href={`${base}/${lang}/founders/`}>{s.navFounders}</a> <span>/</span> <span aria-current="page">{p.name[lang]}</span></nav>
    <article class="hero">
      <figure class="pic"><Avatar name={p.name.en} seed={p.id} photo={p.photo} size={128} />{p.photo?.credit && <figcaption><a href={p.photo.creditUrl} rel="nofollow noopener" target="_blank">{p.photo.credit}</a></figcaption>}</figure>
      <div>
        <h1>{p.name[lang]}</h1>
        {p.name.ar !== p.name.en && <p class="alt" lang={lang === 'ar' ? 'en' : 'ar'}>{p.name[lang === 'ar' ? 'en' : 'ar']}</p>}
        <p class="title">{title}</p>
        {p.bio ? <p class="bio">{digits(p.bio[lang], lang)}</p> : <p class="bio muted">{s.profileThin} <a href={suggestUrl}>{s.helpBtn}</a></p>}
        <Links website={website} links={links} lang={lang} label={s.online} />
        {partners.length > 0 && (
          <p class="partners">{s.coFounders}: {partners.map((n, i) => <>{i > 0 && (lang === 'ar' ? '، ' : ', ')}<a href={`${base}/${lang}/founders/${founderId(n)}/`}>{byId.get(founderId(n))?.name[lang] ?? n}</a></>)}</p>
        )}
      </div>
    </article>
    <section>
      <h2>{s.theirStartups}</h2>
      <ul class="grid">{p.startups.map((x) => <li><MiniCard x={x} lang={lang} /></li>)}</ul>
    </section>
    <Faq lang={lang} items={founderFaq(p, lang)} />
  </div>
</Base>
<style>
  .crumbs { display: flex; justify-content: center; gap: 8px; padding-top: 22px; font-size: .9rem; color: var(--ink-2); }
  .crumbs a { color: var(--ink-2); text-decoration: none; }
  .hero { display: grid; grid-template-columns: 1fr; justify-items: center; text-align: center; gap: 18px; padding: 28px 0 8px; }
  .hero :global(.online ul) { justify-content: center; }
  .hero .bio { margin-inline: auto; }
  .pic { margin: 0; text-align: center; }
  .pic figcaption { margin-top: 6px; font-size: .72rem; }
  .pic figcaption a { color: var(--ink-2); }
  h1 { font-size: clamp(1.8rem, 4vw, 2.5rem); }
  .alt { margin: 2px 0 0; color: var(--ink-2); }
  .title { margin: 10px 0 0; font-weight: 500; color: var(--sun-ink); }
  .bio { font-size: 1.05rem; margin: 14px 0 0; max-width: 70ch; }
  .muted { color: var(--ink-2); }
  .partners { margin: 18px 0 0; color: var(--ink-2); }
  h2 { font-size: 1.1rem; margin: 28px 0 12px; }
  .grid { list-style: none; padding: 0; margin: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 220px), 1fr)); gap: 16px; }
</style>

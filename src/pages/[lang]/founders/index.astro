---
import Base from '../../../layouts/Base.astro';
import Avatar from '../../../components/Avatar.astro';
import { langs, founders, t, num, type Lang } from '../../../config';

export const getStaticPaths = () => langs.map((lang) => ({ params: { lang } }));
const lang = Astro.params.lang as Lang;
const s = t[lang];
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<Base lang={lang} title={s.foundersTitle} description={s.foundersIntro} card={{ kind: 'list', title: s.foundersTitle, sub: s.foundersIntro, faces: founders.filter((p) => p.photo).map((p) => p.photo!.url) }} altPath={`/${lang === 'ar' ? 'en' : 'ar'}/founders/`}>
  <div class="container">
    <header class="intro">
      <h1>🚀 {s.foundersTitle}</h1>
      <p>{s.foundersIntro}</p>
      <input id="fq" type="search" placeholder={s.searchPeople} aria-label={s.searchPeople} />
      <p class="count"><b id="fc">{num(founders.length, lang)}</b></p>
    </header>
    <ul class="people" id="fl">
      {founders.map((p) => (
        <li data-text={[p.name.en, p.name.ar, ...p.startups.flatMap((x) => [x.name.en, x.name.ar])].join(' ').toLowerCase()}>
          <a href={`${base}/${lang}/founders/${p.id}/`}>
            <Avatar name={p.name.en} seed={p.id} photo={p.photo} size={52} />
            <span>
              <strong>{p.name[lang]}</strong>
              <small>{p.title?.[lang] ?? p.startups.map((x) => x.name[lang]).join(lang === 'ar' ? '، ' : ', ')}</small>
            </span>
            {p.bio && <i title="bio">✦</i>}
          </a>
        </li>
      ))}
    </ul>
  </div>
</Base>
<script>
  const q = document.getElementById('fq') as HTMLInputElement;
  const items = [...document.querySelectorAll<HTMLElement>('#fl li')];
  const fmt = new Intl.NumberFormat(document.documentElement.lang === 'ar' ? 'ar-EG' : 'en-US');
  q.addEventListener('input', () => {
    const v = q.value.trim().toLowerCase();
    let n = 0;
    for (const li of items) { li.hidden = !!v && !li.dataset.text!.includes(v); if (!li.hidden) n++; }
    document.getElementById('fc')!.textContent = fmt.format(n);
  });
</script>
<style>
  .intro { padding: 40px 0 8px; text-align: center; }
  .intro h1 { font-size: clamp(1.8rem, 4vw, 2.6rem); }
  .intro p { color: var(--ink-2); max-width: 60ch; margin: 10px auto 0; }
  input { width: min(100%, 520px); margin-top: 20px; font: inherit; padding: 12px 20px; border-radius: 999px; border: 1.5px solid var(--line); background: var(--surface); color: var(--ink); box-shadow: var(--shadow); }
  input:focus { outline: none; border-color: var(--sun); }
  .count { font-size: .9rem; }
  .people { list-style: none; padding: 0; margin: 20px 0 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 280px), 1fr)); gap: 12px; }
  .people a { display: flex; align-items: center; gap: 14px; height: 100%; padding: 12px 16px; border-radius: 16px; background: var(--surface); box-shadow: var(--shadow); color: inherit; text-decoration: none; transition: transform .2s; }
  .people a:hover { transform: translateY(-2px); }
  .people span { display: flex; flex-direction: column; min-width: 0; }
  strong { font-weight: 600; }
  small { color: var(--ink-2); font-size: .82rem; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  i { margin-inline-start: auto; color: var(--sun); font-style: normal; }
</style>

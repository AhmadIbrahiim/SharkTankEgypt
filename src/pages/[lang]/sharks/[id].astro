---
import Base from '../../../layouts/Base.astro';
import { ID, photo } from '../../../schema';
import Avatar from '../../../components/Avatar.astro';
import Links from '../../../components/Links.astro';
import MiniCard from '../../../components/MiniCard.astro';
import Faq from '../../../components/Faq.astro';
import { sharkFaq, sharkSeasons, sharkPairs, sharkSectors } from '../../../faq';
import Chips from '../../../components/Chips.astro';
import { langs, sharks, sharkByKey, t, num, money, pct, seasonLabel, category, catSlug, suggestUrl, type Lang } from '../../../config';

export const getStaticPaths = () => langs.flatMap((lang) => sharks.map((p) => ({ params: { lang, id: p.id }, props: { p } })));
const lang = Astro.params.lang as Lang;
const { p } = Astro.props as { p: typeof sharks[number] };
const s = t[lang];
const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const amounts = p.deals.map((x) => x.deal?.amountEGP).filter((n): n is number => n != null);
const equities = p.deals.map((x) => x.deal?.equityPct).filter((n): n is number => n != null);
const total = amounts.reduce((a, b) => a + b, 0);
const avgEq = equities.length ? equities.reduce((a, b) => a + b, 0) / equities.length : null;
const count = <T,>(xs: T[]) => [...xs.reduce((m, k) => m.set(k, (m.get(k) ?? 0) + 1), new Map<T, number>())].sort((a, b) => b[1] - a[1]);
const sectors = count(p.deals.map((x) => x.category).filter(Boolean) as string[]);
const partners = count(p.deals.flatMap((x) => (x.deal?.sharks ?? []).filter((n) => n !== p.key))).slice(0, 6);
const maxSector = sectors[0]?.[1] ?? 1;
const { wikipedia, wikipediaAr, ...links } = (p.links ?? {}) as Record<string, string>;
const other = [wikipedia && { name: 'Wikipedia', url: wikipedia }, wikipediaAr && { name: 'ويكيبيديا', url: wikipediaAr }, ...(p.companies ?? []).filter((c) => c.url).map((c) => ({ name: c.name, url: c.url! }))].filter(Boolean);
const { website, ...social } = links;
const jsonld = {
  '@context': 'https://schema.org', '@type': 'Person', '@id': ID.shark(p.id), url: new URL(`${base}/${lang}/sharks/${p.id}/`, Astro.site).href, name: p.name[lang], alternateName: p.name[lang === 'ar' ? 'en' : 'ar'],
  ...(p.title && { jobTitle: p.title[lang] }), ...(p.bio && { description: p.bio[lang] }), ...(p.photo && { image: photo(p.photo) }),
  ...(sectors.length && { knowsAbout: sectors.map(([c]) => c) }),
  sameAs: Object.values(p.links ?? {}),
};
---
<Base lang={lang} title={`${p.name[lang]} (${p.name[lang === 'ar' ? 'en' : 'ar']})`} description={p.bio?.[lang] ?? `${p.name[lang]} – ${s.sharksTitle}`}
  card={{ kind: 'person', title: p.name[lang], alt: p.name[lang === 'ar' ? 'en' : 'ar'], photo: p.photo?.url, eyebrow: `${lang === 'ar' ? 'مستثمر' : 'Shark'} · ${p.seasons.map((n) => seasonLabel(n, lang, true)).join(' ')}`, sub: p.title?.[lang],
    stats: [[num(p.deals.length, lang), s.dealsCount], ...(total ? [[money(total, lang)!, s.invested] as [string, string]] : []), ...(avgEq != null ? [[pct(Math.round(avgEq), lang), s.avgEquity] as [string, string]] : [])] }} jsonld={jsonld} altPath={`/${lang === 'ar' ? 'en' : 'ar'}/sharks/${p.id}/`}>
  <div class="container">
    <nav class="crumbs"><a href={`${base}/${lang}/sharks/`}>{s.navSharks}</a> <span>/</span> <span aria-current="page">{p.name[lang]}</span></nav>

    <article class="hero">
      <figure>
        <Avatar name={p.name.en} seed={p.id} photo={p.photo} size={168} />
        {p.photo?.credit && <figcaption>{s.photoBy} {p.photo.creditUrl ? <a href={p.photo.creditUrl} rel="nofollow noopener" target="_blank">{p.photo.credit}</a> : p.photo.credit}</figcaption>}
      </figure>
      <div>
        <h1>{p.name[lang]}</h1>
        <p class="alt">{p.name[lang === 'ar' ? 'en' : 'ar']}</p>
        {p.title && <p class="title">{p.title[lang]}</p>}
        <p class="seasons">{s.appearedIn}: {p.seasons.map((n) => <a href={`${base}/${lang}/season/${n}/`}>{seasonLabel(n, lang)}</a>)}</p>
        {p.bio ? <p class="bio">{p.bio[lang]}</p> : <p class="bio muted">{s.profileThin} <a href={suggestUrl}>{s.helpBtn}</a></p>}
        <Links website={website} links={{ ...social, other }} lang={lang} label={s.online} />
      </div>
    </article>

    <section class="stats">
      <div><b>{num(p.deals.length, lang)}</b><span>{s.dealsCount}</span></div>
      <div><b>{total ? money(total, lang) : '—'}</b><span>{s.invested}</span></div>
      <div><b>{avgEq != null ? pct(Math.round(avgEq), lang) : '—'}</b><span>{s.avgEquity}</span></div>
      <div><b>{num(p.seasons.length, lang)}</b><span>{s.appearedIn}</span></div>
    </section>

    {(sectors.length > 0 || partners.length > 0) && (
      <section class="insights">
        {sectors.length > 0 && (
          <div class="card">
            <h2>{s.sectors}</h2>
            <ul class="bars">
              {sectors.map(([c, n]) => (
                <li><span>{category(c, lang)}</span><i style={`--w:${(n / maxSector) * 100}%`}></i><b>{num(n, lang)}</b></li>
              ))}
            </ul>
          </div>
        )}
        {partners.length > 0 && (
          <div class="card">
            <h2>{s.coInvestors}</h2>
            <ul class="partners">
              {partners.map(([n, c]) => {
                const q = sharkByKey.get(n);
                return <li><a href={q ? `${base}/${lang}/sharks/${q.id}/` : undefined}><Avatar name={n} seed={q?.id ?? n} photo={q?.photo} size={40} /><span>{q?.name[lang] ?? n}</span><b>×{num(c, lang)}</b></a></li>;
              })}
            </ul>
          </div>
        )}
      </section>
    )}

    <section>
      <h2 class="h2">{s.portfolio}</h2>
      {p.deals.length ? <ul class="grid">{p.deals.map((x) => <li><MiniCard x={x} lang={lang} /></li>)}</ul> : <p class="muted">{s.noDeals}</p>}
    </section>

    <Chips title={lang === 'ar' ? `صفقات ${p.name[lang]} حسب الموسم` : `${p.name[lang]}'s deals by season`}
      links={sharkSeasons.filter((x) => x.p.id === p.id).map((x) => ({ href: `${base}/${lang}/sharks/${p.id}/season/${x.n}/`, label: seasonLabel(x.n, lang) }))} />
    <Chips title={lang === 'ar' ? `استثمارات ${p.name[lang]} حسب القطاع` : `${p.name[lang]}'s investments by sector`}
      links={sharkSectors.filter((x) => x.p.id === p.id).map((x) => ({ href: `${base}/${lang}/sharks/${p.id}/sector/${catSlug(x.c)}/`, label: category(x.c, lang) }))} />
    <Chips title={lang === 'ar' ? `قارن ${p.name[lang]} مع` : `Compare ${p.name[lang]} with`}
      links={sharkPairs.filter((x) => x.a.id === p.id || x.b.id === p.id).map((x) => ({ href: `${base}/${lang}/sharks/vs/${x.id}/`, label: (x.a.id === p.id ? x.b : x.a).name[lang] }))} />
    <Faq lang={lang} items={sharkFaq(p, lang)} />
  </div>
</Base>
<style>
  .crumbs { display: flex; gap: 8px; padding-top: 22px; font-size: .9rem; color: var(--ink-2); }
  .crumbs a { color: var(--ink-2); text-decoration: none; }
  .hero { display: grid; grid-template-columns: auto 1fr; gap: 36px; align-items: start; padding: 28px 0; }
  @media (max-width: 720px) { .hero { grid-template-columns: 1fr; justify-items: center; text-align: center; } .hero :global(.online ul) { justify-content: center; } }
  figure { margin: 0; text-align: center; }
  figcaption { margin-top: 8px; font-size: .75rem; color: var(--ink-2); }
  figcaption a { color: inherit; }
  h1 { font-size: clamp(2rem, 4.5vw, 2.8rem); }
  .alt { margin: 2px 0 0; color: var(--ink-2); }
  .title { margin: 10px 0 0; font-weight: 500; color: var(--ink); font-style: italic; }
  .seasons { margin: 8px 0 0; color: var(--ink-2); font-size: .92rem; display: flex; flex-wrap: wrap; gap: 6px; align-items: center; }
  .hero .seasons { justify-content: inherit; }
  .seasons a { color: var(--ink); font-size: .88rem; }
  .bio { font-size: 1.05rem; margin: 16px 0 0; max-width: 70ch; }
  .muted { color: var(--ink-2); }
  .stats { display: grid; grid-template-columns: repeat(auto-fit, minmax(150px, 1fr)); gap: 0 26px; }
  .stats div { padding: 10px 0 4px; border-top: 2px solid var(--ink); display: flex; flex-direction: column; }
  .stats b { font-family: var(--serif); font-size: 1.8rem; font-weight: 700; line-height: 1.2; }
  .stats span { color: var(--ink-2); font-size: .88rem; }
  .insights { display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 26px 36px; margin-top: 28px; }
  .card { padding-top: 10px; border-top: 1px solid var(--ink); }
  .card h2, .h2 { font-size: 1.25rem; margin-bottom: 12px; }
  .h2 { margin-top: var(--gap-sec); }
  .bars { list-style: none; margin: 0; padding: 0; display: grid; gap: 8px; }
  .bars li { display: grid; grid-template-columns: 9rem 1fr 2rem; align-items: center; gap: 10px; font-size: .9rem; }
  .bars i { display: block; height: 8px; width: var(--w); background: var(--ink); }
  .bars li:first-child i { background: var(--sun); }
  .bars b { text-align: end; color: var(--ink-2); font-weight: 500; }
  .partners { list-style: none; margin: 0; padding: 0; display: grid; gap: 8px; }
  .partners a { display: flex; align-items: center; gap: 10px; color: var(--ink); text-decoration: none; }
  .partners a:hover span { color: var(--sun-ink); }
  .partners b { margin-inline-start: auto; color: var(--ink-2); font-weight: 500; }
  .grid { list-style: none; padding: 0; margin: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 220px), 1fr)); gap: 16px; }
  @media (max-width: 560px) { .grid { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 10px; } }
</style>

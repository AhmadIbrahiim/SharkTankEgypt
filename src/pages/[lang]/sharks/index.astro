---
import Base from '../../../layouts/Base.astro';
import Avatar from '../../../components/Avatar.astro';
import { langs, sharks, t, num, money, seasonLabel, type Lang } from '../../../config';

export const getStaticPaths = () => langs.map((lang) => ({ params: { lang } }));
const lang = Astro.params.lang as Lang;
const s = t[lang];
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const total = (d: typeof sharks[number]['deals']) => d.reduce((a, x) => a + (x.deal?.amountEGP ?? 0), 0);
---
<Base lang={lang} title={s.sharksTitle} description={s.sharksIntro} card={{ kind: 'list', title: s.sharksTitle, sub: s.sharksIntro, faces: sharks.map((p) => p.photo?.url).filter((u): u is string => !!u) }} altPath={`/${lang === 'ar' ? 'en' : 'ar'}/sharks/`}>
  <div class="container">
    <header class="intro">
      <h1>{s.sharksTitle}</h1>
      <p>{s.sharksIntro}</p>
    </header>
    <ul class="people">
      {sharks.map((p) => (
        <li>
          <a href={`${base}/${lang}/sharks/${p.id}/`}>
            <Avatar name={p.name.en} seed={p.id} photo={p.photo} size={132} />
            <strong>{p.name[lang]}</strong>
            {p.title && <small>{p.title[lang]}</small>}
            <span class="stats">
              <b>{num(p.deals.length, lang)}</b> {lang === 'en' && p.deals.length === 1 ? 'deal' : s.dealsCount}
              {total(p.deals) > 0 && <> · {money(total(p.deals), lang)}</>}
            </span>
            <span class="seasons">{p.seasons.map((n) => <i>{seasonLabel(n, lang, true)}</i>)}</span>
          </a>
        </li>
      ))}
    </ul>
  </div>
</Base>
<style>
  .intro { padding: 36px 0 18px; border-bottom: 1px solid var(--line); }
  .intro h1 { font-size: clamp(1.9rem, 4.4vw, 2.9rem); }
  .intro p { color: var(--ink-2); max-width: 60ch; margin: 10px 0 0; }
  .people { list-style: none; padding: 0; margin: 28px 0 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 200px), 1fr)); gap: 30px 18px; }
  .people a { display: flex; flex-direction: column; align-items: center; text-align: center; gap: 4px; height: 100%; color: inherit; text-decoration: none; }
  .people a :global(.person-avatar) { border: 3px solid var(--line); margin-bottom: 8px; transition: border-color .2s; }
  .people a:hover :global(.person-avatar) { border-color: var(--gold); }
  .people a:hover strong { color: var(--sun-ink); text-decoration: underline; text-decoration-thickness: 1px; }
  strong { font-size: 1.05rem; font-weight: 700; line-height: 1.25; }
  small { color: var(--ink-2); font-size: .85rem; line-height: 1.4; }
  .stats { color: var(--ink-2); font-size: .85rem; }
  .stats b { display: block; font-family: var(--serif); font-size: 2rem; color: var(--sun); line-height: 1.1; }
  .seasons { display: flex; flex-wrap: wrap; justify-content: center; gap: 4px 8px; padding-top: 2px; }
  .seasons i { font-style: normal; font-size: .74rem; color: var(--ink-2); }
</style>

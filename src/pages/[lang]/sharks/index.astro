---
import Base from '../../../layouts/Base.astro';
import Avatar from '../../../components/Avatar.astro';
import Faq from '../../../components/Faq.astro';
import { programFaq, sharkPairs } from '../../../faq';
import { langs, sharks, t, num, money, pct, category, catSlug, seasonLabel, type Lang, digits } from '../../../config';

export const getStaticPaths = () => langs.map((lang) => ({ params: { lang } }));
const lang = Astro.params.lang as Lang;
const s = t[lang];
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const total = (d: typeof sharks[number]['deals']) => d.reduce((a, x) => a + (x.deal?.amountEGP ?? 0), 0);
const ar = lang === 'ar';
// Analysis: one row per shark with deals, and the pairs who most often invest together.
const rows = sharks.filter((p) => p.deals.length).map((p) => {
  const eq = p.deals.map((x) => x.deal?.equityPct).filter((v): v is number => v != null);
  const sec = [...p.deals.reduce((m, x) => x.category ? m.set(x.category, (m.get(x.category) ?? 0) + 1) : m, new Map<string, number>())].sort((a, b) => b[1] - a[1])[0];
  return { p, n: p.deals.length, inv: total(p.deals), eq: eq.length ? Math.round(eq.reduce((a, b) => a + b, 0) / eq.length) : null, sec: sec?.[0] };
});
const maxN = Math.max(...rows.map((r) => r.n));
const pairs = sharkPairs.map((x) => ({ ...x, joint: x.a.deals.filter((d) => x.b.deals.includes(d)).length })).filter((x) => x.joint > 0).sort((a, b) => b.joint - a.joint).slice(0, 6);
const sharkQs = programFaq(lang).general.filter((q) => /shark|مستثمر/i.test(q.q));
---
<Base lang={lang} title={s.sharksTitle} description={s.sharksIntro} card={{ kind: 'list', title: s.sharksTitle, sub: s.sharksIntro, faces: sharks.map((p) => p.photo?.url).filter((u): u is string => !!u) }} altPath={`/${lang === 'ar' ? 'en' : 'ar'}/sharks/`}>
  <div class="container">
    <header class="intro">
      <h1>{s.sharksTitle}</h1>
      <p>{s.sharksIntro}</p>
    </header>
    <ul class="people">
      {sharks.map((p) => (
        <li>
          <a href={`${base}/${lang}/sharks/${p.id}/`}>
            <Avatar name={p.name.en} seed={p.id} photo={p.photo} size={132} />
            <strong>{p.name[lang]}</strong>
            {p.title && <small>{digits(p.title[lang], lang)}</small>}
            <span class="stats">
              <b>{num(p.deals.length, lang)}</b> {lang === 'en' && p.deals.length === 1 ? 'deal' : s.dealsCount}
              {total(p.deals) > 0 && <> · {money(total(p.deals), lang)}</>}
            </span>
            <span class="seasons">{p.seasons.map((n) => <i>{seasonLabel(n, lang, true)}</i>)}</span>
          </a>
        </li>
      ))}
    </ul>

    <section class="sec" aria-labelledby="cmp">
      <h2 id="cmp">{ar ? 'مقارنة المستثمرين' : 'The sharks compared'}</h2>
      <div class="scroll"><table>
        <thead><tr><th>{ar ? 'المستثمر' : 'Shark'}</th><th>{s.dealsCount}</th><th>{s.invested}</th><th>{s.avgEquity}</th><th>{ar ? 'المجال المفضل' : 'Top sector'}</th><th>{ar ? 'المواسم' : 'Seasons'}</th></tr></thead>
        <tbody>{rows.map((r) => (
          <tr>
            <td><a class="nm" href={`${base}/${lang}/sharks/${r.p.id}/`}><Avatar name={r.p.name.en} seed={r.p.id} photo={r.p.photo} size={30} />{r.p.name[lang]}</a></td>
            <td><span class="bar"><i style={`width:${(r.n / maxN) * 100}%`}></i></span><b>{num(r.n, lang)}</b></td>
            <td>{r.inv ? money(r.inv, lang) : '—'}</td>
            <td>{r.eq != null ? pct(r.eq, lang) : '—'}</td>
            <td>{r.sec ? <a href={`${base}/${lang}/category/${catSlug(r.sec)}/`}>{category(r.sec, lang)}</a> : '—'}</td>
            <td>{num(r.p.seasons.filter((n) => n > 0).length, lang)}</td>
          </tr>
        ))}</tbody>
      </table></div>
      <p class="note">{ar ? 'الاستثمار المعلن = مجموع قيمة الصفقات التي شارك فيها المستثمر حين يكون المبلغ معلنًا.' : 'Announced investment = the total value of the deals each shark joined, where the amount is public.'}</p>
    </section>

    {pairs.length > 0 && (
      <section class="sec" aria-labelledby="pairs">
        <h2 id="pairs">{ar ? 'من يستثمر مع من؟' : 'Who invests together?'}</h2>
        <ul class="pairs">{pairs.map((x) => (
          <li><a href={`${base}/${lang}/sharks/vs/${x.id}/`}>
            <span class="faces"><Avatar name={x.a.name.en} seed={x.a.id} photo={x.a.photo} size={40} /><Avatar name={x.b.name.en} seed={x.b.id} photo={x.b.photo} size={40} /></span>
            <span class="pn">{x.a.name[lang]} <em>{ar ? 'و' : '&'}</em> {x.b.name[lang]}</span>
            <b>{num(x.joint, lang)} {ar ? 'صفقات مشتركة' : (x.joint === 1 ? 'joint deal' : 'joint deals')}</b>
          </a></li>
        ))}</ul>
      </section>
    )}

    <Faq lang={lang} items={sharkQs} />
  </div>
</Base>
<style>
  .sec { margin-top: var(--gap-sec); }
  .sec > h2 { font-size: 1.6rem; margin-bottom: 14px; text-align: center; }
  .scroll { overflow-x: auto; border-radius: 12px; border: 1px solid var(--line); background: var(--surface); }
  table { width: 100%; border-collapse: collapse; font-size: .93rem; }
  th, td { padding: 10px 14px; text-align: start; white-space: nowrap; border-top: 1px solid var(--line); }
  thead th { border-top: 0; font-size: .8rem; color: var(--ink-2); font-weight: 600; background: var(--surface-2); }
  .nm { display: inline-flex; align-items: center; gap: 10px; color: var(--ink); font-weight: 600; text-decoration: none; }
  .nm:hover { color: var(--crimson); }
  td a { color: var(--nile); }
  .bar { display: inline-block; vertical-align: middle; width: 90px; height: 8px; margin-inline-end: 8px; border-radius: 4px; background: var(--surface-2); overflow: hidden; }
  .bar i { display: block; height: 100%; background: var(--crimson); border-radius: 4px; }
  .note { margin: 8px 0 0; font-size: .82rem; color: var(--ink-2); text-align: center; }
  .pairs { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 300px), 1fr)); gap: 12px; }
  .pairs a { display: flex; align-items: center; gap: 12px; padding: 12px 14px; border-radius: 12px; background: var(--surface); border: 1px solid var(--line); color: var(--ink); text-decoration: none; }
  .pairs a:hover { border-color: var(--crimson); }
  .faces { display: flex; flex: none; } .faces :global(.person-avatar + .person-avatar) { margin-inline-start: -12px; }
  .pn { flex: 1; font-weight: 600; font-size: .92rem; } .pn em { font-style: normal; color: var(--ink-2); }
  .pairs b { font-size: .8rem; color: var(--ok); white-space: nowrap; }
  .intro { padding: 36px 0 18px; border-bottom: 1px solid var(--line); text-align: center; }
  .intro h1 { font-size: clamp(1.9rem, 4.4vw, 2.9rem); margin-inline: auto; }
  .intro p { color: var(--ink-2); max-width: 60ch; margin: 10px auto 0; }
  .people { list-style: none; padding: 0; margin: 28px 0 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 200px), 1fr)); gap: 30px 18px; }
  .people a { display: flex; flex-direction: column; align-items: center; text-align: center; gap: 4px; height: 100%; color: inherit; text-decoration: none; }
  .people a :global(.person-avatar) { border: 3px solid var(--line); margin-bottom: 8px; transition: border-color .2s; }
  .people a:hover :global(.person-avatar) { border-color: var(--gold); }
  .people a:hover strong { color: var(--sun-ink); text-decoration: underline; text-decoration-thickness: 1px; }
  strong { font-size: 1.05rem; font-weight: 700; line-height: 1.25; }
  small { color: var(--ink-2); font-size: .85rem; line-height: 1.4; }
  .stats { color: var(--ink-2); font-size: .85rem; }
  .stats b { display: block; font-family: var(--serif); font-size: 2rem; color: var(--sun); line-height: 1.1; }
  .seasons { display: flex; flex-wrap: wrap; justify-content: center; gap: 4px 8px; padding-top: 2px; }
  .seasons i { font-style: normal; font-size: .74rem; color: var(--ink-2); }
</style>

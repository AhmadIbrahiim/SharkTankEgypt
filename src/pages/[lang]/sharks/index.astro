---
import Base from '../../../layouts/Base.astro';
import Avatar from '../../../components/Avatar.astro';
import { langs, sharks, t, num, money, seasonLabel, type Lang } from '../../../config';

export const getStaticPaths = () => langs.map((lang) => ({ params: { lang } }));
const lang = Astro.params.lang as Lang;
const s = t[lang];
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const total = (d: typeof sharks[number]['deals']) => d.reduce((a, x) => a + (x.deal?.amountEGP ?? 0), 0);
---
<Base lang={lang} title={s.sharksTitle} description={s.sharksIntro} card={{ kind: 'list', title: s.sharksTitle, sub: s.sharksIntro, faces: sharks.map((p) => p.photo?.url).filter((u): u is string => !!u) }} altPath={`/${lang === 'ar' ? 'en' : 'ar'}/sharks/`}>
  <div class="container">
    <header class="intro">
      <h1>🦈 {s.sharksTitle}</h1>
      <p>{s.sharksIntro}</p>
    </header>
    <ul class="people">
      {sharks.map((p) => (
        <li>
          <a href={`${base}/${lang}/sharks/${p.id}/`}>
            <Avatar name={p.name.en} seed={p.id} photo={p.photo} size={88} />
            <strong>{p.name[lang]}</strong>
            {p.title && <small>{p.title[lang]}</small>}
            <span class="stats">
              <b>{num(p.deals.length, lang)}</b> {lang === 'en' && p.deals.length === 1 ? 'deal' : s.dealsCount}
              {total(p.deals) > 0 && <> · {money(total(p.deals), lang)}</>}
            </span>
            <span class="seasons">{p.seasons.map((n) => <i>{seasonLabel(n, lang, true)}</i>)}</span>
          </a>
        </li>
      ))}
    </ul>
  </div>
</Base>
<style>
  .intro { padding: 40px 0 8px; text-align: center; }
  .intro h1 { font-size: clamp(1.8rem, 4vw, 2.6rem); }
  .intro p { color: var(--ink-2); max-width: 60ch; margin: 10px auto 0; }
  .people { list-style: none; padding: 0; margin: 24px 0 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 230px), 1fr)); gap: 18px; }
  .people a { display: flex; flex-direction: column; align-items: center; gap: 6px; height: 100%; padding: 24px 16px 18px; text-align: center; border-radius: var(--radius); background: var(--surface); box-shadow: var(--shadow); color: inherit; text-decoration: none; transition: transform .2s, box-shadow .2s; }
  .people a:hover { transform: translateY(-4px); box-shadow: var(--shadow-lift); }
  strong { font-size: 1.1rem; font-weight: 650; margin-top: 8px; }
  small { color: var(--ink-2); font-size: .85rem; line-height: 1.4; }
  .stats { color: var(--ok); font-size: .9rem; margin-top: 4px; }
  .seasons { display: flex; flex-wrap: wrap; justify-content: center; gap: 4px; margin-top: auto; padding-top: 8px; }
  .seasons i { font-style: normal; font-size: .75rem; padding: 2px 8px; border-radius: 999px; background: var(--surface-2); color: var(--ink-2); }
</style>

---
import Base from '../../layouts/Base.astro';
import { ID, ROOT } from '../../schema';
import Shot from '../../components/Shot.astro';
import Sharks from '../../components/Sharks.astro';
import Avatar from '../../components/Avatar.astro';
import { langs, listCard, startups, seasons, sharks, founders, founderId, t, num, money, pct, category, seasonLabel, shark, suggestUrl, thumb, type Lang, digits } from '../../config';
import { norm } from '../../search.mjs';

export const getStaticPaths = () => langs.map((lang) => ({ params: { lang } }));
const lang = Astro.params.lang as Lang;
const s = t[lang];
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const categories = [...new Set(startups.map((x) => x.category).filter(Boolean))].sort() as string[];
const deals = startups.filter((x) => x.deal?.made);
const invested = deals.reduce((sum, x) => sum + (x.deal?.amountEGP ?? 0), 0);
// The stage: the biggest disclosed deal that has a pitch video.
const feat = deals.filter((x) => x.video && x.deal?.amountEGP).sort((a, b) => b.deal!.amountEGP! - a.deal!.amountEGP!)[0];
const panel = sharks.filter((p) => p.deals.length).sort((a, b) => b.deals.length - a.deals.length).slice(0, 8);
const rails = [...seasons].map((x) => x.season).filter((n) => n > 0).sort((a, b) => b - a)
  .map((n) => ({ n, items: startups.filter((x) => x.season === n).sort((a, b) => (b.video ? 1 : 0) - (a.video ? 1 : 0)).slice(0, 12) })).filter((r) => r.items.length);
const tag = (x: (typeof startups)[number]) => x.deal?.made === true ? ['ok', s.deal] : x.deal?.made === false ? ['no', s.noDeal] : ['unk', ar ? 'غير مؤكدة' : 'Unconfirmed'];
const ar = lang === 'ar';
const first = (t: string) => t.split(/(?<=[.!?؟])\s/)[0];
const arName = new Map(founders.map((f) => [f.id, f.name.ar]));
// Search index per card: names, sector, founders, sharks, full description and product names, in both languages.
const indexText = (x: (typeof startups)[number]) => norm([x.name.en, x.name.ar, x.category, x.category && category(x.category, 'ar'),
  ...(x.founders ?? []).flatMap((n) => [n, arName.get(founderId(n))]), ...(x.deal?.sharks ?? []).flatMap((n) => [n, shark(n, 'ar')]), x.description.en, x.description.ar, ...((x as any).services?.en ?? []).map((v: any) => v.name), ...((x as any).services?.ar ?? []).map((v: any) => v.name)].join(' '));

const site = new URL(import.meta.env.BASE_URL, Astro.site).href;
const jsonld = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: s.title,
  itemListElement: startups.map((x, i) => ({ '@type': 'ListItem', position: i + 1, name: x.name[lang], url: `${ROOT}${lang}/${x.id}/`, item: { '@id': ID.startup(x.id) } })),
};
---
<Base lang={lang} jsonld={jsonld} card={listCard(s.title, s.tagline, startups, lang, lang === 'ar' ? 'كل المواسم والحلقات' : 'Every season and episode')} altPath={`/${lang === 'ar' ? 'en' : 'ar'}/`}>
  <section class="stage">
    {feat && <img class="bg" src={`https://i.ytimg.com/vi/${feat.video}/maxresdefault.jpg`} alt="" width="1280" height="720" fetchpriority="high" onerror={`this.onerror=null;this.src='${thumb(feat.video!)}'`} />}
    <div class="container stage-in">
      <div class="lead">
        <p class="kicker">{s.heroKicker}</p>
        <h1>{s.heroTitle}</h1>
        <p class="sub">{s.heroSub}</p>
        <label class="search">
          <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><circle cx="11" cy="11" r="7" fill="none" stroke="currentColor" stroke-width="2"/><path d="m20 20-3.5-3.5" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
          <span class="sr">{s.search}</span>
          <input id="q" dir="auto" type="search" placeholder={s.search} autocomplete="off" enterkeyhint="search" />
          <kbd aria-hidden="true">/</kbd>
        </label>
      </div>
      {feat && (
        <a class="feat" href={`${base}/${lang}/${feat.id}/`}>
          <span class="flag">{ar ? 'صفقة كبيرة' : 'Big deal'} · {seasonLabel(feat.season, lang)}</span>
          <strong>{feat.name[lang]}</strong>
          <span class="fterms">
            <span><b>{money(feat.deal!.amountEGP!, lang)}</b><small>{s.deal}</small></span>
            {feat.deal!.equityPct != null && <span><b>{pct(feat.deal!.equityPct, lang)}</b><small>{ar ? 'الحصة' : 'Equity'}</small></span>}
            {feat.episode != null && <span><b>{s.episode} {num(feat.episode, lang)}</b><small>{seasonLabel(feat.season, lang)}</small></span>}
          </span>
          <span class="watch">{ar ? 'شاهد العرض والتفاصيل' : 'Watch the pitch and the full story'}</span>
        </a>
      )}
    </div>
  </section>

  <div class="container">
    <dl class="stats">
      <div><dt>{s.statStartups}</dt><dd>{num(startups.length, lang)}</dd></div>
      <div><dt>{s.statSeasons}</dt><dd>{num(seasons.length, lang)}</dd></div>
      <div><dt>{s.statDeals}</dt><dd>{num(deals.length, lang)}</dd></div>
      {invested > 0 && <div><dt>{s.statInvested}</dt><dd>{money(invested, lang)}</dd></div>}
    </dl>

    <section class="panel" aria-labelledby="buying">
      <div class="sechead"><h2 id="buying">{ar ? 'مين بيستثمر؟' : "Who's buying?"}</h2><a href={`${base}/${lang}/sharks/`}>{ar ? 'كل المستثمرين' : 'All sharks'}</a></div>
      <p class="hint">{ar ? 'اختر مستثمرًا لترى كل شركة استثمر فيها.' : 'Pick a shark to see every startup they backed.'}</p>
      <ul class="chairs">
        {panel.map((p) => (
          <li><a href={`${base}/${lang}/sharks/${p.id}/`}>
            <Avatar name={p.name.en} seed={p.id} photo={p.photo} size={112} />
            <strong>{p.name[lang]}</strong>
            <em>{num(p.deals.length, lang)}</em>
            <small>{ar ? 'صفقة' : p.deals.length === 1 ? 'deal' : 'deals'}</small>
          </a></li>
        ))}
      </ul>
    </section>

    {rails.map((r) => (
      <section class="rail" aria-labelledby={`r${r.n}`}>
        <div class="sechead"><h2 id={`r${r.n}`}>{seasonLabel(r.n, lang)} <small>{num(startups.filter((x) => x.season === r.n).length, lang)} {ar ? 'عرض' : 'pitches'}</small></h2><a href={`${base}/${lang}/season/${r.n}/`}>{ar ? 'الكل' : 'See all'}</a></div>
        <ul class="strip">
          {r.items.map((x) => (
            <li><a class="poster" href={`${base}/${lang}/${x.id}/`}>
              <span class="pic"><Shot id={x.id} name={x.name[lang]} lang={lang} video={x.video} /><i class={tag(x)[0]}>{tag(x)[1]}</i></span>
              <strong>{x.name[lang]}</strong>
              <small>{x.episode != null ? `${s.episode} ${num(x.episode, lang)}` : seasonLabel(x.season, lang)}{x.category && ` · ${category(x.category, lang)}`}</small>
            </a></li>
          ))}
        </ul>
      </section>
    ))}
  </div>

  <section class="container" aria-labelledby="all">
    <div class="sechead"><h2 id="all">{s.allStartups}</h2></div>
    <div class="toolbar">
      <div class="chips" role="group" aria-label={s.season} data-key="s">
        <button type="button" class="chip" data-v="" aria-pressed="true">{s.all}</button>
        {[...seasons].sort((a, b) => (a.season || 99) - (b.season || 99)).map((x) => <button type="button" class="chip" data-v={x.season} aria-pressed="false">{seasonLabel(x.season, lang)}</button>)}
      </div>
      <div class="chips" role="group" aria-label={s.finalDeal} data-key="d">
        <button type="button" class="chip" data-v="" aria-pressed="true">{s.all}</button>
        <button type="button" class="chip" data-v="1" aria-pressed="false">{s.deal}</button>
        <button type="button" class="chip" data-v="0" aria-pressed="false">{s.noDeal}</button>
      </div>
      <div class="selects">
        <select id="c" aria-label={s.category}>
          <option value="">{s.allCategories}</option>
          {categories.map((c) => <option value={c}>{category(c, lang)}</option>)}
        </select>
        <select id="sh" aria-label={s.sharks}>
          <option value="">{s.allSharks}</option>
          {sharks.filter((p) => p.deals.length).map((p) => <option value={p.key}>{p.name[lang]}</option>)}
        </select>
        <select id="sort" aria-label={s.sort}>
          <option value="">{s.sortEpisode}</option>
          <option value="name">{s.sortName}</option>
          <option value="oldest">{s.sortOldest}</option>
          <option value="deal">{s.sortDeal}</option>
          <option value="ask">{s.sortAsk}</option>
        </select>
      </div>
    </div>
    <p class="count" aria-live="polite"><strong id="count">{num(startups.length, lang)}</strong> {s.results}</p>

    <ul class="grid" id="grid">
      {startups.map((x, i) => (
        <li
          data-i={i}
          hidden={i >= 24 /* = PAGE in the script: the first layout covers one page, not all 218 cards */}
          data-s={x.season}
          data-d={x.deal?.made == null ? '' : x.deal.made ? '1' : '0'}
          data-c={x.category ?? ''}
          data-name={x.name[lang]}
          data-amount={x.deal?.made ? x.deal.amountEGP ?? 0 : -1}
          data-ask={x.ask?.amountEGP ?? -1}
          data-sh={(x.deal?.made ? x.deal.sharks ?? [] : []).join('|')}
          data-text={indexText(x)}
        >
          <a class="card" href={`${base}/${lang}/${x.id}/`}>
            <span class="pic"><Shot id={x.id} name={x.name[lang]} lang={lang} video={x.video} />{x.deal?.made === true ? <i class="ok">{s.deal}</i> : x.deal?.made === false ? <i class="no">{s.noDeal}</i> : <i class="unk">{lang === 'ar' ? 'غير مؤكدة' : 'Unconfirmed'}</i>}</span>
            <div class="body">
              <div class="row">
                <span class="badge">{seasonLabel(x.season, lang, true)}{x.episode != null && ` · ${s.episode} ${num(x.episode, lang)}`}</span>
              </div>
              <h3>{x.name[lang]}</h3>
              <p class="desc">{digits(x.description[lang], lang)}</p>
              <div class="foot">
                {/* Requested vs agreed, always labelled the same way. */}
                <span class="terms">
                  {x.ask?.amountEGP != null && <span class="ask">{s.asked} {money(x.ask.amountEGP, lang)}{x.ask.equityPct != null && ` · ${pct(x.ask.equityPct, lang)}`}</span>}
                  {x.deal?.made && (x.deal.amountEGP != null || x.deal.equityPct != null) && <span class="amount">{s.deal}: {[x.deal.amountEGP != null && money(x.deal.amountEGP, lang), x.deal.equityPct != null && pct(x.deal.equityPct, lang)].filter(Boolean).join(' · ')}</span>}
                </span>
                {x.deal?.made && x.deal.sharks?.length ? <Sharks names={x.deal.sharks} lang={lang} /> : x.category && <span class="badge nile">{category(x.category, lang)}</span>}
              </div>
            </div>
          </a>
        </li>
      ))}
    </ul>

    <div class="more" id="more-wrap"><button type="button" class="btn btn-ghost" id="more">{s.showMore}</button></div>

    <div class="empty" id="empty" hidden>
      <h2>{s.emptyTitle}</h2>
      <p>{s.emptyText}</p>
      <div class="empty-actions">
        <button type="button" class="btn btn-ghost" id="reset">{s.reset}</button>
        <a class="btn btn-primary" href={suggestUrl}>{s.suggest}</a>
      </div>
    </div>

    <aside class="missing" id="missing">
      <div><h2>{s.missingTitle}</h2><p>{s.missingText}</p></div>
      <a class="btn btn-primary" href={suggestUrl}>{s.suggest}</a>
    </aside>
  </section>
</Base>

<script>
  import { matches } from '../../search.mjs';
  // Filters live in the URL (?q=&s=&d=&c=&sh=&sort=) so any view can be shared or bookmarked, and survive the back button.
  const grid = document.getElementById('grid')!;
  const items = [...grid.children] as HTMLElement[];
  const q = document.getElementById('q') as HTMLInputElement;
  const c = document.getElementById('c') as HTMLSelectElement;
  const sort = document.getElementById('sort') as HTMLSelectElement;
  const sh = document.getElementById('sh') as HTMLSelectElement;
  let order = '';
  let zeroTimer: ReturnType<typeof setTimeout>;
  const groups = [...document.querySelectorAll<HTMLElement>('.chips')];
  const fmt = new Intl.NumberFormat(document.documentElement.lang === 'ar' ? 'ar-EG' : 'en-US');
  const collator = new Intl.Collator(document.documentElement.lang);
  const params = new URLSearchParams(location.search);
  const PAGE = 24;
  let limit = PAGE;

  const chipValue = (key: string) => document.querySelector<HTMLElement>(`.chips[data-key="${key}"] [aria-pressed="true"]`)?.dataset.v ?? '';
  const setChip = (group: HTMLElement, v: string) =>
    group.querySelectorAll<HTMLElement>('.chip').forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.v === v)));

  function apply() {
    const state = { q: q.value.trim(), s: chipValue('s'), d: chipValue('d'), c: c.value, sh: sh.value, sort: sort.value };
    let n = 0;
    for (const li of items) {
      const d = li.dataset;
      const show = matches(d.text!, state.q) && (!state.s || d.s === state.s) && (!state.d || d.d === state.d) && (!state.c || d.c === state.c)
        && (!state.sh || d.sh!.split('|').includes(state.sh));
      li.dataset.match = show ? '1' : '';
      if (show) n++;
      li.hidden = !show;
    }
    const by = state.sort === 'name' ? (a: HTMLElement, b: HTMLElement) => collator.compare(a.dataset.name!, b.dataset.name!)
      : state.sort === 'deal' ? (a: HTMLElement, b: HTMLElement) => +b.dataset.amount! - +a.dataset.amount!
      : state.sort === 'ask' ? (a: HTMLElement, b: HTMLElement) => +b.dataset.ask! - +a.dataset.ask!
      : state.sort === 'oldest' ? (a: HTMLElement, b: HTMLElement) => +b.dataset.i! - +a.dataset.i!
      : (a: HTMLElement, b: HTMLElement) => +a.dataset.i! - +b.dataset.i!;
    const sorted = [...items].sort(by);
    // Re-insert the 218 cards only when the order changes (typing in search doesn't reorder).
    if (state.sort !== order) { grid.append(...sorted); order = state.sort; }
    // hide past the limit in display order, not source order
    let shown = 0;
    for (const li of sorted) if (li.dataset.match === '1') li.hidden = ++shown > limit;
    document.getElementById('count')!.textContent = fmt.format(n);
    // Zero-result searches tell us what people look for and don't find (only when analytics is on).
    clearTimeout(zeroTimer);
    if (!n && state.q) zeroTimer = setTimeout(() => (window as any).goatcounter?.count?.({ path: `search-zero/${state.q.toLowerCase()}`, title: state.q, event: true }), 1500);
    document.getElementById('more-wrap')!.hidden = n <= limit;
    document.getElementById('empty')!.hidden = n > 0;
    document.getElementById('missing')!.hidden = n === 0;

    const url = new URL(location.href);
    url.search = new URLSearchParams(Object.entries(state).filter(([, v]) => v)).toString();
    history.replaceState(null, '', url);
    // While searching or filtering, hide the browse sections so results sit right under the search box.
    document.body.classList.toggle('searching', !!(state.q || state.s || state.d || state.c || state.sh));
  }

  q.value = params.get('q') ?? '';
  c.value = params.get('c') ?? '';
  sort.value = params.get('sort') ?? '';
  sh.value = params.get('sh') ?? '';
  for (const g of groups) {
    setChip(g, params.get(g.dataset.key!) ?? '');
    g.addEventListener('click', (e) => {
      const b = (e.target as HTMLElement).closest<HTMLElement>('.chip');
      if (b) { setChip(g, b.dataset.v!); filter(); }
    });
  }
  const filter = () => { limit = PAGE; apply(); };
  document.getElementById('more')!.addEventListener('click', () => { limit += PAGE * 2; apply(); });
  q.addEventListener('input', filter);
  q.addEventListener('keydown', (e) => { if (e.key === 'Enter') document.getElementById('all')!.scrollIntoView({ behavior: 'smooth' }); });
  c.addEventListener('change', filter);
  sort.addEventListener('change', filter);
  sh.addEventListener('change', filter);
  document.getElementById('reset')!.addEventListener('click', () => {
    q.value = c.value = sort.value = sh.value = '';
    groups.forEach((g) => setChip(g, ''));
    apply();
    q.focus();
  });
  // The header's search button links here as #q.
  const toSearch = () => location.hash === '#q' && q.focus();
  toSearch(); addEventListener('hashchange', toSearch);
  // "/" jumps to search, like GitHub.
  addEventListener('keydown', (e) => {
    if (e.key === '/' && document.activeElement?.tagName !== 'INPUT') { e.preventDefault(); q.focus(); }
  });
  apply();
</script>

<style>
  .sr { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); }
  /* The stage: a pitch still behind the title, darkened towards the text. */
  .stage { position: relative; overflow: hidden; min-height: 560px; display: flex; align-items: flex-end; background: #2a1a14; }
  .stage .bg { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: center 30%; opacity: .5; }
  .stage::after { content: ''; position: absolute; inset: 0; background: radial-gradient(ellipse at center, rgb(42 26 20 / .55), rgb(42 26 20 / .85) 75%), linear-gradient(0deg, #2a1a14 0%, transparent 40%); }
    .stage-in { position: relative; z-index: 1; display: flex; flex-direction: column; align-items: center; gap: 26px; text-align: center; padding-block: 72px 40px; }
  .lead { display: flex; flex-direction: column; align-items: center; width: 100%; max-width: 760px; }
  .lead .search { width: 100%; }
  .feat { width: min(100%, 560px); align-items: center; text-align: center; }
  .feat .flag { align-self: center; }
  .fterms { justify-content: center; }
  :global(body.searching) .panel, :global(body.searching) .rail, :global(body.searching) .stats { display: none; }
  .kicker { margin: 0 0 12px; color: var(--gold); font-size: .78rem; font-weight: 700; text-transform: uppercase; letter-spacing: .16em; }
  :global([dir='rtl']) .kicker { text-transform: none; letter-spacing: 0; font-size: .95rem; }
  .stage h1 { color: #fff; font-size: clamp(2.4rem, 6vw, 4.4rem); line-height: 1; text-transform: uppercase; }
  :global([dir='rtl']) .stage h1 { text-transform: none; line-height: 1.25; }
  .sub { max-width: 54ch; margin: 16px auto 24px; color: #e8ddcf; font-size: 1.05rem; }
  .search { display: flex; align-items: center; gap: 10px; max-width: 600px; padding-inline: 14px 8px; background: #fff; border: 2px solid #fff; border-radius: var(--radius); color: var(--ink-2); }
  .search:focus-within { border-color: var(--gold); }
  .search input { flex: 1; min-width: 0; border: 0; outline: 0; background: none; font: inherit; font-size: 1.05rem; color: var(--ink); padding: 13px 0; }
  kbd { font: inherit; font-size: .78rem; padding: 0 7px; border: 1px solid var(--line); border-radius: 3px; color: var(--ink-2); margin-inline-end: 6px; }
  @media (hover: none) { kbd { display: none; } }
  .feat { display: flex; flex-direction: column; gap: 8px; padding: 18px 20px; border-radius: var(--radius); background: rgb(255 255 255 / .1); backdrop-filter: blur(8px); border: 1px solid rgb(255 255 255 / .25); color: #fff; text-decoration: none; }
  .feat:hover { border-color: var(--gold); }
  .flag { align-self: flex-start; background: var(--gold); color: #2a1a14; font-size: .72rem; font-weight: 800; padding: 3px 8px; border-radius: 3px; text-transform: uppercase; letter-spacing: .08em; }
  :global([dir='rtl']) .flag { text-transform: none; letter-spacing: 0; }
  .feat strong { font-size: 1.9rem; font-weight: 800; line-height: 1.1; }
  .fterms { display: flex; flex-wrap: wrap; gap: 8px 26px; }
  .fterms b { display: block; font-size: 1.25rem; }
  .fterms small { color: #cdbfb0; font-size: .74rem; text-transform: uppercase; letter-spacing: .08em; }
  .watch { color: var(--gold); font-weight: 600; font-size: .92rem; }
  @media (max-width: 860px) { .stage { min-height: 0; } .stage .bg { opacity: .3; height: 60%; } .stage::after { background: linear-gradient(0deg, #2a1a14 45%, rgb(42 26 20 / .6) 100%) !important; } .stage-in { gap: 22px; padding-block: 56px 28px; } }

  .stats { display: flex; flex-wrap: wrap; gap: 10px 0; margin: 26px 0 0; padding-bottom: 6px; border-bottom: 1px solid var(--line); }
  .stats div { display: flex; flex-direction: column-reverse; padding-inline-end: 28px; margin-inline-end: 28px; border-inline-end: 1px solid var(--line); }
  .stats div:last-child { border: 0; }
  .stats dt { color: var(--ink-2); font-size: .8rem; }
  .stats dd { margin: 0; font-size: 1.7rem; font-weight: 800; line-height: 1.15; }
  @media (max-width: 560px) { .stats div { padding-inline-end: 14px; margin-inline-end: 14px; } .stats dd { font-size: 1.3rem; } }

  .sechead { display: flex; align-items: baseline; justify-content: space-between; gap: 12px; margin-bottom: 14px; }
  .sechead h2 { font-size: 1.6rem; }
  .sechead h2 small { font-family: 'Readex Pro Variable', sans-serif; font-size: .85rem; font-weight: 400; color: var(--ink-2); margin-inline-start: 8px; }
  .sechead a { color: var(--sun-ink); font-size: .92rem; text-decoration: none; }
  .sechead a:hover { text-decoration: underline; }

  /* Who's buying: the panel of sharks, like the chairs on set. */
  .panel { margin-top: var(--gap-sec); padding: 26px 24px 22px; border-radius: 10px; background: var(--crimson); color: #f4efe6; --ink: #f4efe6; --ink-2: #ecd3cc; --sun-ink: #f4efe6; }
  .panel .sechead { margin-bottom: 2px; }
  .hint { margin: 0 0 18px; color: var(--ink-2); }
  .chairs { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(8, minmax(96px, 1fr)); gap: 14px; overflow-x: auto; scrollbar-width: none; }
  .chairs a { display: flex; flex-direction: column; align-items: center; text-align: center; color: var(--ink); text-decoration: none; }
  .chairs a :global(.person-avatar) { width: 100%; height: auto; max-width: 112px; aspect-ratio: 1; border: 3px solid rgb(244 239 230 / .45); transition: border-color .2s; }
  .chairs a:hover :global(.person-avatar) { border-color: var(--gold); }
  .chairs strong { margin-top: 10px; font-size: .9rem; font-weight: 600; line-height: 1.25; }
  .chairs em { font-style: normal; font-family: var(--serif); font-size: 1.9rem; font-weight: 700; color: #f6cf73; line-height: 1.1; margin-top: 4px; }
  .chairs small { color: var(--ink-2); font-size: .78rem; }
  @media (max-width: 860px) { .chairs { grid-template-columns: repeat(8, 104px); } .panel { padding: 20px 16px; } }

  /* Season rails: a row of pitch stills per season. */

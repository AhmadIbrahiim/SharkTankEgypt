---
import Base from '../../layouts/Base.astro';
import Shot from '../../components/Shot.astro';
import Sharks from '../../components/Sharks.astro';
import { langs, startups, seasons, t, num, money, pct, category, type Lang } from '../../config';

export const getStaticPaths = () => langs.map((lang) => ({ params: { lang } }));
const lang = Astro.params.lang as Lang;
const s = t[lang];
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const categories = [...new Set(startups.map((x) => x.category).filter(Boolean))].sort() as string[];
const deals = startups.filter((x) => x.deal?.made);
const invested = deals.reduce((sum, x) => sum + (x.deal?.amountEGP ?? 0), 0);

const site = new URL(import.meta.env.BASE_URL, Astro.site).href;
const jsonld = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: s.title,
  itemListElement: startups.map((x, i) => ({ '@type': 'ListItem', position: i + 1, name: x.name[lang], url: `${site}${lang}/${x.id}/` })),
};
---
<Base lang={lang} jsonld={jsonld} altPath={`/${lang === 'ar' ? 'en' : 'ar'}/`}>
  <section class="hero">
    <div class="container">
      <p class="kicker">🦈 {s.heroKicker}</p>
      <h1>{s.heroTitle}</h1>
      <p class="sub">{s.heroSub}</p>
      <label class="search">
        <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true"><circle cx="11" cy="11" r="7" fill="none" stroke="currentColor" stroke-width="2"/><path d="m20 20-3.5-3.5" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
        <span class="sr">{s.search}</span>
        <input id="q" type="search" placeholder={s.search} autocomplete="off" enterkeyhint="search" />
        <kbd aria-hidden="true">/</kbd>
      </label>
      <dl class="stats">
        <div><dt>{s.statStartups}</dt><dd>{num(startups.length, lang)}</dd></div>
        <div><dt>{s.statSeasons}</dt><dd>{num(seasons.length, lang)}</dd></div>
        <div><dt>{s.statDeals}</dt><dd>{num(deals.length, lang)}</dd></div>
        {invested > 0 && <div><dt>{s.statInvested}</dt><dd>{money(invested, lang)}</dd></div>}
      </dl>
    </div>
  </section>

  <section class="container" aria-label={s.results}>
    <div class="toolbar">
      <div class="chips" role="group" aria-label={s.season} data-key="s">
        <button type="button" class="chip" data-v="" aria-pressed="true">{s.all}</button>
        {seasons.map((x) => <button type="button" class="chip" data-v={x.season} aria-pressed="false">{s.season} {num(x.season, lang)}</button>)}
      </div>
      <div class="chips" role="group" aria-label={s.finalDeal} data-key="d">
        <button type="button" class="chip" data-v="" aria-pressed="true">{s.all}</button>
        <button type="button" class="chip" data-v="1" aria-pressed="false">🤝 {s.deal}</button>
        <button type="button" class="chip" data-v="0" aria-pressed="false">{s.noDeal}</button>
      </div>
      <div class="selects">
        <select id="c" aria-label={s.category}>
          <option value="">{s.allCategories}</option>
          {categories.map((c) => <option value={c}>{category(c, lang)}</option>)}
        </select>
        <select id="sort" aria-label={s.sort}>
          <option value="">{s.sortEpisode}</option>
          <option value="name">{s.sortName}</option>
          <option value="deal">{s.sortDeal}</option>
        </select>
      </div>
    </div>
    <p class="count" aria-live="polite"><strong id="count">{num(startups.length, lang)}</strong> {s.results}</p>

    <ul class="grid" id="grid">
      {startups.map((x, i) => (
        <li
          data-i={i}
          data-s={x.season}
          data-d={x.deal?.made == null ? '' : x.deal.made ? '1' : '0'}
          data-c={x.category ?? ''}
          data-name={x.name[lang]}
          data-amount={x.deal?.made ? x.deal.amountEGP ?? 0 : -1}
          data-text={[x.name.en, x.name.ar, x.category, x.category && category(x.category, 'ar'), ...(x.founders ?? []), ...(x.deal?.sharks ?? []), x.description.en, x.description.ar].join(' ').toLowerCase()}
        >
          <a class="card" href={`${base}/${lang}/${x.id}/`}>
            <Shot id={x.id} name={x.name[lang]} eager={i < 6} />
            <div class="body">
              <div class="row">
                <span class="badge">{s.seasonShort}{num(x.season, lang)}{x.episode != null && ` · ${s.episode} ${num(x.episode, lang)}`}</span>
                {x.deal?.made === true && <span class="badge ok">🤝 {s.deal}</span>}
              </div>
              <h2>{x.name[lang]}</h2>
              <p class="desc">{x.description[lang]}</p>
              <div class="foot">
                {x.deal?.made && x.deal.sharks?.length
                  ? <><Sharks names={x.deal.sharks} />{x.deal.amountEGP != null && <span class="amount">{money(x.deal.amountEGP, lang)}{x.deal.equityPct != null && ` · ${pct(x.deal.equityPct, lang)}`}</span>}</>
                  : x.category && <span class="badge nile">{category(x.category, lang)}</span>}
              </div>
            </div>
          </a>
        </li>
      ))}
    </ul>

    <div class="empty" id="empty" hidden>
      <div class="empty-fin" aria-hidden="true">🫧</div>
      <h2>{s.emptyTitle}</h2>
      <p>{s.emptyText}</p>
      <button type="button" class="btn btn-ghost" id="reset">{s.reset}</button>
    </div>
  </section>
</Base>

<script>
  // Filters live in the URL (?q=&s=&d=&c=&sort=) so any view can be shared or bookmarked.
  const grid = document.getElementById('grid')!;
  const items = [...grid.children] as HTMLElement[];
  const q = document.getElementById('q') as HTMLInputElement;
  const c = document.getElementById('c') as HTMLSelectElement;
  const sort = document.getElementById('sort') as HTMLSelectElement;
  const groups = [...document.querySelectorAll<HTMLElement>('.chips')];
  const fmt = new Intl.NumberFormat(document.documentElement.lang === 'ar' ? 'ar-EG' : 'en-US');
  const collator = new Intl.Collator(document.documentElement.lang);
  const params = new URLSearchParams(location.search);

  const chipValue = (key: string) => document.querySelector<HTMLElement>(`.chips[data-key="${key}"] [aria-pressed="true"]`)?.dataset.v ?? '';
  const setChip = (group: HTMLElement, v: string) =>
    group.querySelectorAll<HTMLElement>('.chip').forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.v === v)));

  function apply() {
    const state = { q: q.value.trim(), s: chipValue('s'), d: chipValue('d'), c: c.value, sort: sort.value };
    const needle = state.q.toLowerCase();
    let n = 0;
    for (const li of items) {
      const d = li.dataset;
      const show = (!needle || d.text!.includes(needle)) && (!state.s || d.s === state.s) && (!state.d || d.d === state.d) && (!state.c || d.c === state.c);
      li.hidden = !show;
      if (show) n++;
    }
    const by = state.sort === 'name' ? (a: HTMLElement, b: HTMLElement) => collator.compare(a.dataset.name!, b.dataset.name!)
      : state.sort === 'deal' ? (a: HTMLElement, b: HTMLElement) => +b.dataset.amount! - +a.dataset.amount!
      : (a: HTMLElement, b: HTMLElement) => +a.dataset.i! - +b.dataset.i!;
    grid.append(...[...items].sort(by));
    document.getElementById('count')!.textContent = fmt.format(n);
    document.getElementById('empty')!.hidden = n > 0;

    const url = new URL(location.href);
    url.search = new URLSearchParams(Object.entries(state).filter(([, v]) => v)).toString();
    history.replaceState(null, '', url);
  }

  q.value = params.get('q') ?? '';
  c.value = params.get('c') ?? '';
  sort.value = params.get('sort') ?? '';
  for (const g of groups) {
    setChip(g, params.get(g.dataset.key!) ?? '');
    g.addEventListener('click', (e) => {
      const b = (e.target as HTMLElement).closest<HTMLElement>('.chip');
      if (b) { setChip(g, b.dataset.v!); apply(); }
    });
  }
  q.addEventListener('input', apply);
  c.addEventListener('change', apply);
  sort.addEventListener('change', apply);
  document.getElementById('reset')!.addEventListener('click', () => {
    q.value = c.value = sort.value = '';
    groups.forEach((g) => setChip(g, ''));
    apply();
    q.focus();
  });
  // "/" jumps to search, like GitHub.
  addEventListener('keydown', (e) => {
    if (e.key === '/' && document.activeElement?.tagName !== 'INPUT') { e.preventDefault(); q.focus(); }
  });
  if (location.search) apply();
</script>

<style>
  .sr { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); }
  .hero { position: relative; overflow: hidden; padding-block: 56px 40px; text-align: center;
    background:
      radial-gradient(700px 320px at 85% -10%, color-mix(in srgb, var(--sun) 22%, transparent), transparent 70%),
      radial-gradient(600px 300px at 10% 110%, color-mix(in srgb, var(--nile) 16%, transparent), transparent 70%); }
  .kicker { display: inline-block; margin: 0 0 14px; padding: 5px 14px; border-radius: 999px; background: var(--sun-soft); color: var(--sun-ink); font-size: .9rem; font-weight: 500; }
  .hero h1 { font-size: clamp(2rem, 5.2vw, 3.4rem); max-width: 18ch; margin-inline: auto; letter-spacing: -.02em; }
  :global([dir='rtl']) .hero h1 { letter-spacing: 0; }
  .sub { max-width: 56ch; margin: 16px auto 28px; color: var(--ink-2); font-size: 1.08rem; }
  .search { position: relative; display: flex; align-items: center; gap: 10px; max-width: 640px; margin-inline: auto; padding-block: 6px; padding-inline: 18px 8px;
    background: var(--surface); border: 1.5px solid var(--line); border-radius: 999px; box-shadow: var(--shadow); color: var(--ink-2); transition: border-color .2s, box-shadow .2s; }
  .search:focus-within { border-color: var(--sun); box-shadow: 0 0 0 4px color-mix(in srgb, var(--sun) 18%, transparent), var(--shadow); }
  .search input { flex: 1; min-width: 0; border: 0; outline: 0; background: none; font: inherit; font-size: 1.05rem; color: var(--ink); padding: 10px 0; }
  .search input::-webkit-search-cancel-button { cursor: pointer; }
  kbd { font: inherit; font-size: .8rem; padding: 2px 9px; border-radius: 8px; background: var(--surface-2); color: var(--ink-2); margin-inline-end: 6px; }
  @media (hover: none) { kbd { display: none; } }
  .stats { display: flex; flex-wrap: wrap; justify-content: center; gap: 12px 40px; margin: 32px 0 0; }
  .stats div { display: flex; flex-direction: column-reverse; }
  .stats dt { color: var(--ink-2); font-size: .88rem; }
  .stats dd { margin: 0; font-size: 1.6rem; font-weight: 650; color: var(--ink); }

  .toolbar { display: flex; flex-wrap: wrap; align-items: center; gap: 12px 16px; padding-top: 12px; }
  .chips { display: flex; gap: 6px; flex-wrap: wrap; padding: 4px; background: var(--surface-2); border-radius: 999px; }
  .chip { font: inherit; font-size: .9rem; padding: 6px 14px; border: 0; border-radius: 999px; background: none; color: var(--ink-2); cursor: pointer; transition: background .2s, color .2s; }
  .chip:hover { color: var(--ink); }
  .chip[aria-pressed='true'] { background: var(--surface); color: var(--ink); font-weight: 500; box-shadow: 0 1px 3px rgb(60 35 15 / .12); }
  .selects { display: flex; gap: 8px; margin-inline-start: auto; }
  select { font: inherit; font-size: .9rem; padding: 8px 14px; border: 1px solid var(--line); border-radius: 999px; background: var(--surface); color: var(--ink); cursor: pointer; }
  @media (max-width: 720px) { .selects { margin-inline-start: 0; width: 100%; } .selects select { flex: 1; min-width: 0; } }
  .count { color: var(--ink-2); font-size: .9rem; margin: 18px 0 14px; }
  .count strong { color: var(--ink); }

  .grid { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 290px), 1fr)); gap: 22px; }
  .card { display: flex; flex-direction: column; height: 100%; padding: 10px; border-radius: var(--radius); background: var(--surface); box-shadow: var(--shadow); color: inherit; text-decoration: none; transition: transform .25s cubic-bezier(.2,.8,.2,1), box-shadow .25s; }
  .card:hover { transform: translateY(-4px); box-shadow: var(--shadow-lift); }
  .card :global(.shot) { transition: transform .5s cubic-bezier(.2,.8,.2,1); }
  .card:hover :global(.shot) { transform: scale(1.03); }
  .body { display: flex; flex-direction: column; flex: 1; padding: 14px 8px 6px; }
  .row { display: flex; gap: 6px; flex-wrap: wrap; }
  .body h2 { font-size: 1.15rem; margin: 10px 0 4px; }
  .desc { margin: 0; color: var(--ink-2); font-size: .93rem; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
  .foot { display: flex; align-items: center; justify-content: space-between; gap: 8px; margin-top: auto; padding-top: 14px; min-height: 42px; }
  .amount { font-weight: 600; font-size: .92rem; color: var(--ok); }

  .empty { text-align: center; padding: 48px 20px; }
  .empty-fin { font-size: 2.6rem; }
  .empty p { color: var(--ink-2); }
</style>

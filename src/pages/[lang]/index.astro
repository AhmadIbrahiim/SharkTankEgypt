---
import Base from '../../layouts/Base.astro';
import { ID, ROOT } from '../../schema';
import Shot from '../../components/Shot.astro';
import Sharks from '../../components/Sharks.astro';
import { langs, listCard, startups, seasons, sharks, founders, founderId, t, num, money, pct, category, seasonLabel, shark, suggestUrl, type Lang } from '../../config';
import { norm } from '../../search.mjs';

export const getStaticPaths = () => langs.map((lang) => ({ params: { lang } }));
const lang = Astro.params.lang as Lang;
const s = t[lang];
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const categories = [...new Set(startups.map((x) => x.category).filter(Boolean))].sort() as string[];
const deals = startups.filter((x) => x.deal?.made);
const invested = deals.reduce((sum, x) => sum + (x.deal?.amountEGP ?? 0), 0);
const first = (t: string) => t.split(/(?<=[.!?؟])\s/)[0];
const arName = new Map(founders.map((f) => [f.id, f.name.ar]));
// Search index per card: names, sector, founders and sharks in both languages, plus the first sentence of each description.
const indexText = (x: (typeof startups)[number]) => norm([x.name.en, x.name.ar, x.category, x.category && category(x.category, 'ar'),
  ...(x.founders ?? []).flatMap((n) => [n, arName.get(founderId(n))]), ...(x.deal?.sharks ?? []).flatMap((n) => [n, shark(n, 'ar')]), first(x.description.en), first(x.description.ar)].join(' '));

const site = new URL(import.meta.env.BASE_URL, Astro.site).href;
const jsonld = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: s.title,
  itemListElement: startups.map((x, i) => ({ '@type': 'ListItem', position: i + 1, name: x.name[lang], url: `${ROOT}${lang}/${x.id}/`, item: { '@id': ID.startup(x.id) } })),
};
---
<Base lang={lang} jsonld={jsonld} card={listCard(s.title, s.tagline, startups, lang, lang === 'ar' ? 'كل المواسم والحلقات' : 'Every season and episode')} altPath={`/${lang === 'ar' ? 'en' : 'ar'}/`}>
  <section class="hero">
    <div class="container">
      <p class="kicker">{s.heroKicker}</p>
      <h1>{s.heroTitle}</h1>
      <p class="sub">{s.heroSub}</p>
      <label class="search">
        <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true"><circle cx="11" cy="11" r="7" fill="none" stroke="currentColor" stroke-width="2"/><path d="m20 20-3.5-3.5" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
        <span class="sr">{s.search}</span>
        <input id="q" type="search" placeholder={s.search} autocomplete="off" enterkeyhint="search" />
        <kbd aria-hidden="true">/</kbd>
      </label>
      <dl class="stats">
        <div><dt>{s.statStartups}</dt><dd>{num(startups.length, lang)}</dd></div>
        <div><dt>{s.statSeasons}</dt><dd>{num(seasons.length, lang)}</dd></div>
        <div><dt>{s.statDeals}</dt><dd>{num(deals.length, lang)}</dd></div>
        {invested > 0 && <div><dt>{s.statInvested}</dt><dd>{money(invested, lang)}</dd></div>}
      </dl>
    </div>
  </section>

  <section class="container" aria-labelledby="all">
    <h2 id="all" class="sr">{s.allStartups}</h2>
    <div class="toolbar">
      <div class="chips" role="group" aria-label={s.season} data-key="s">
        <button type="button" class="chip" data-v="" aria-pressed="true">{s.all}</button>
        {[...seasons].sort((a, b) => (a.season || 99) - (b.season || 99)).map((x) => <button type="button" class="chip" data-v={x.season} aria-pressed="false">{seasonLabel(x.season, lang)}</button>)}
      </div>
      <div class="chips" role="group" aria-label={s.finalDeal} data-key="d">
        <button type="button" class="chip" data-v="" aria-pressed="true">{s.all}</button>
        <button type="button" class="chip" data-v="1" aria-pressed="false">{s.deal}</button>
        <button type="button" class="chip" data-v="0" aria-pressed="false">{s.noDeal}</button>
      </div>
      <div class="selects">
        <select id="c" aria-label={s.category}>
          <option value="">{s.allCategories}</option>
          {categories.map((c) => <option value={c}>{category(c, lang)}</option>)}
        </select>
        <select id="sh" aria-label={s.sharks}>
          <option value="">{s.allSharks}</option>
          {sharks.filter((p) => p.deals.length).map((p) => <option value={p.key}>{p.name[lang]}</option>)}
        </select>
        <select id="sort" aria-label={s.sort}>
          <option value="">{s.sortEpisode}</option>
          <option value="name">{s.sortName}</option>
          <option value="oldest">{s.sortOldest}</option>
          <option value="deal">{s.sortDeal}</option>
          <option value="ask">{s.sortAsk}</option>
        </select>
      </div>
    </div>
    <p class="count" aria-live="polite"><strong id="count">{num(startups.length, lang)}</strong> {s.results}</p>

    <ul class="grid" id="grid">
      {startups.map((x, i) => (
        <li
          data-i={i}
          hidden={i >= 24 /* = PAGE in the script: the first layout covers one page, not all 218 cards */}
          data-s={x.season}
          data-d={x.deal?.made == null ? '' : x.deal.made ? '1' : '0'}
          data-c={x.category ?? ''}
          data-name={x.name[lang]}
          data-amount={x.deal?.made ? x.deal.amountEGP ?? 0 : -1}
          data-ask={x.ask?.amountEGP ?? -1}
          data-sh={(x.deal?.made ? x.deal.sharks ?? [] : []).join('|')}
          data-text={indexText(x)}
        >
          <a class="card" href={`${base}/${lang}/${x.id}/`}>
            <Shot id={x.id} name={x.name[lang]} lang={lang} video={x.video} eager={i < 6} />
            <div class="body">
              <div class="row">
                <span class="badge">{seasonLabel(x.season, lang, true)}{x.episode != null && ` · ${s.episode} ${num(x.episode, lang)}`}</span>
                {/* One status badge for every card: deal, no deal, or not confirmed by any source. */}
                {x.deal?.made === true ? <span class="badge ok">{s.deal}</span> : x.deal?.made === false ? <span class="badge">{s.noDeal}</span> : <span class="badge unk">{s.unknownOutcome}</span>}
              </div>
              <h3>{x.name[lang]}</h3>
              <p class="desc">{x.description[lang]}</p>
              <div class="foot">
                {/* Requested vs agreed, always labelled the same way. */}
                <span class="terms">
                  {x.ask?.amountEGP != null && <span class="ask">{s.asked} {money(x.ask.amountEGP, lang)}{x.ask.equityPct != null && ` · ${pct(x.ask.equityPct, lang)}`}</span>}
                  {x.deal?.made && (x.deal.amountEGP != null || x.deal.equityPct != null) && <span class="amount">{s.deal}: {[x.deal.amountEGP != null && money(x.deal.amountEGP, lang), x.deal.equityPct != null && pct(x.deal.equityPct, lang)].filter(Boolean).join(' · ')}</span>}
                </span>
                {x.deal?.made && x.deal.sharks?.length ? <Sharks names={x.deal.sharks} lang={lang} /> : x.category && <span class="badge nile">{category(x.category, lang)}</span>}
              </div>
            </div>
          </a>
        </li>
      ))}
    </ul>

    <div class="more" id="more-wrap"><button type="button" class="btn btn-ghost" id="more">{s.showMore}</button></div>

    <div class="empty" id="empty" hidden>
      <h2>{s.emptyTitle}</h2>
      <p>{s.emptyText}</p>
      <div class="empty-actions">
        <button type="button" class="btn btn-ghost" id="reset">{s.reset}</button>
        <a class="btn btn-primary" href={suggestUrl}>{s.suggest}</a>
      </div>
    </div>

    <aside class="missing" id="missing">
      <div><h2>{s.missingTitle}</h2><p>{s.missingText}</p></div>
      <a class="btn btn-primary" href={suggestUrl}>{s.suggest}</a>
    </aside>
  </section>
</Base>

<script>
  import { matches } from '../../search.mjs';
  // Filters live in the URL (?q=&s=&d=&c=&sh=&sort=) so any view can be shared or bookmarked, and survive the back button.
  const grid = document.getElementById('grid')!;
  const items = [...grid.children] as HTMLElement[];
  const q = document.getElementById('q') as HTMLInputElement;
  const c = document.getElementById('c') as HTMLSelectElement;
  const sort = document.getElementById('sort') as HTMLSelectElement;
  const sh = document.getElementById('sh') as HTMLSelectElement;
  let order = '';
  let zeroTimer: ReturnType<typeof setTimeout>;
  const groups = [...document.querySelectorAll<HTMLElement>('.chips')];
  const fmt = new Intl.NumberFormat(document.documentElement.lang === 'ar' ? 'ar-EG' : 'en-US');
  const collator = new Intl.Collator(document.documentElement.lang);
  const params = new URLSearchParams(location.search);
  const PAGE = 24;
  let limit = PAGE;

  const chipValue = (key: string) => document.querySelector<HTMLElement>(`.chips[data-key="${key}"] [aria-pressed="true"]`)?.dataset.v ?? '';
  const setChip = (group: HTMLElement, v: string) =>
    group.querySelectorAll<HTMLElement>('.chip').forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.v === v)));

  function apply() {
    const state = { q: q.value.trim(), s: chipValue('s'), d: chipValue('d'), c: c.value, sh: sh.value, sort: sort.value };
    let n = 0;
    for (const li of items) {
      const d = li.dataset;
      const show = matches(d.text!, state.q) && (!state.s || d.s === state.s) && (!state.d || d.d === state.d) && (!state.c || d.c === state.c)
        && (!state.sh || d.sh!.split('|').includes(state.sh));
      li.dataset.match = show ? '1' : '';
      if (show) n++;
      li.hidden = !show;
    }
    const by = state.sort === 'name' ? (a: HTMLElement, b: HTMLElement) => collator.compare(a.dataset.name!, b.dataset.name!)
      : state.sort === 'deal' ? (a: HTMLElement, b: HTMLElement) => +b.dataset.amount! - +a.dataset.amount!
      : state.sort === 'ask' ? (a: HTMLElement, b: HTMLElement) => +b.dataset.ask! - +a.dataset.ask!
      : state.sort === 'oldest' ? (a: HTMLElement, b: HTMLElement) => +b.dataset.i! - +a.dataset.i!
      : (a: HTMLElement, b: HTMLElement) => +a.dataset.i! - +b.dataset.i!;
    const sorted = [...items].sort(by);
    // Re-insert the 218 cards only when the order changes (typing in search doesn't reorder).
    if (state.sort !== order) { grid.append(...sorted); order = state.sort; }
    // hide past the limit in display order, not source order
    let shown = 0;
    for (const li of sorted) if (li.dataset.match === '1') li.hidden = ++shown > limit;
    document.getElementById('count')!.textContent = fmt.format(n);
    // Zero-result searches tell us what people look for and don't find (only when analytics is on).
    clearTimeout(zeroTimer);
    if (!n && state.q) zeroTimer = setTimeout(() => (window as any).goatcounter?.count?.({ path: `search-zero/${state.q.toLowerCase()}`, title: state.q, event: true }), 1500);
    document.getElementById('more-wrap')!.hidden = n <= limit;
    document.getElementById('empty')!.hidden = n > 0;
    document.getElementById('missing')!.hidden = n === 0;

    const url = new URL(location.href);
    url.search = new URLSearchParams(Object.entries(state).filter(([, v]) => v)).toString();
    history.replaceState(null, '', url);
  }

  q.value = params.get('q') ?? '';
  c.value = params.get('c') ?? '';
  sort.value = params.get('sort') ?? '';
  sh.value = params.get('sh') ?? '';
  for (const g of groups) {
    setChip(g, params.get(g.dataset.key!) ?? '');
    g.addEventListener('click', (e) => {
      const b = (e.target as HTMLElement).closest<HTMLElement>('.chip');
      if (b) { setChip(g, b.dataset.v!); filter(); }
    });
  }
  const filter = () => { limit = PAGE; apply(); };
  document.getElementById('more')!.addEventListener('click', () => { limit += PAGE * 2; apply(); });
  q.addEventListener('input', filter);
  c.addEventListener('change', filter);
  sort.addEventListener('change', filter);
  sh.addEventListener('change', filter);
  document.getElementById('reset')!.addEventListener('click', () => {
    q.value = c.value = sort.value = sh.value = '';
    groups.forEach((g) => setChip(g, ''));
    apply();
    q.focus();
  });
  // The header's search button links here as #q.
  const toSearch = () => location.hash === '#q' && q.focus();
  toSearch(); addEventListener('hashchange', toSearch);
  // "/" jumps to search, like GitHub.
  addEventListener('keydown', (e) => {
    if (e.key === '/' && document.activeElement?.tagName !== 'INPUT') { e.preventDefault(); q.focus(); }
  });
  apply();
</script>

<style>
  .sr { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); }
  .hero { padding-block: 36px 30px; border-bottom: 1px solid var(--line); }
  .kicker { margin: 0 0 10px; color: var(--sun-ink); font-size: .78rem; font-weight: 600; text-transform: uppercase; letter-spacing: .14em; }
  :global([dir='rtl']) .kicker { text-transform: none; letter-spacing: 0; font-size: .9rem; }
  .hero h1 { font-size: clamp(2.1rem, 5vw, 3.4rem); max-width: 20ch; letter-spacing: -.02em; }
  :global([dir='rtl']) .hero h1 { letter-spacing: 0; }
  .sub { max-width: 60ch; margin: 12px 0 24px; color: var(--ink-2); font-size: 1.08rem; }
  .search { position: relative; display: flex; align-items: center; gap: 10px; max-width: 680px; padding-inline: 14px 8px;
    background: var(--surface); border: 1px solid var(--ink); color: var(--ink-2); }
  .search:focus-within { outline: 2px solid var(--sun); outline-offset: 1px; }
  .search input { flex: 1; min-width: 0; border: 0; outline: 0; background: none; font: inherit; font-size: 1.05rem; color: var(--ink); padding: 12px 0; }
  .search input::-webkit-search-cancel-button { cursor: pointer; }
  kbd { font: inherit; font-size: .78rem; padding: 0 7px; border: 1px solid var(--line); color: var(--ink-2); margin-inline-end: 6px; }
  @media (hover: none) { kbd { display: none; } }
  /* Figures read like a stats box in print: ruled columns, no cards. */
  .stats { display: flex; flex-wrap: wrap; margin: 26px 0 0; border-top: 1px solid var(--ink); }
  .stats div { display: flex; flex-direction: column-reverse; padding: 10px 28px 0 0; margin-inline-end: 28px; border-inline-end: 1px solid var(--line); }
  :global([dir='rtl']) .stats div { padding: 10px 0 0 28px; }
  .stats div:last-child { border: 0; }
  .stats dt { color: var(--ink-2); font-size: .82rem; }
  .stats dd { margin: 0; font-family: var(--serif); font-size: 1.75rem; font-weight: 700; color: var(--ink); line-height: 1.2; }
  @media (max-width: 560px) { .stats div { padding-inline-end: 16px; margin-inline-end: 16px; } :global([dir='rtl']) .stats div { padding: 10px 0 0 16px; } .stats dd { font-size: 1.35rem; } }

  .toolbar { display: flex; flex-wrap: wrap; align-items: center; gap: 12px 10px; padding-top: 12px; }
  .chips { display: flex; gap: 0; flex-wrap: wrap; border: 1px solid var(--line); }
  .chip { font: inherit; font-size: .88rem; padding: 5px 11px; border: 0; border-inline-end: 1px solid var(--line); background: none; color: var(--ink-2); cursor: pointer; }
  .chip:last-child { border-inline-end: 0; }
  .chip:hover { color: var(--ink); }
  .chip[aria-pressed='true'] { background: var(--ink); color: var(--bg); font-weight: 600; }
  .selects { display: flex; gap: 8px; margin-inline-start: auto; }
  select { font: inherit; font-size: .9rem; padding: 8px 10px; border: 1px solid var(--line); border-radius: 0; background: var(--surface); color: var(--ink); cursor: pointer; }
  @media (max-width: 720px) { .chips { flex-wrap: nowrap; overflow-x: auto; max-width: 100%; scrollbar-width: none; } .chip { white-space: nowrap; flex: none; } }
  @media (max-width: 720px) { .selects { margin-inline-start: 0; width: 100%; } .selects select { flex: 1; min-width: 0; } }
  .count { color: var(--ink-2); font-size: .9rem; margin: 18px 0 14px; }
  .count strong { color: var(--ink); }

  .grid { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 290px), 1fr)); gap: 34px 26px; }
  .card { display: flex; flex-direction: column; height: 100%; padding-top: 14px; border-top: 2px solid var(--ink); color: inherit; text-decoration: none; }
  .card:hover h3 { color: var(--sun-ink); text-decoration: underline; text-decoration-thickness: 1px; text-underline-offset: 4px; }
  .body { display: flex; flex-direction: column; flex: 1; padding: 12px 0 4px; }
  .row { display: flex; gap: 6px; flex-wrap: wrap; }
  .body h3 { font-family: var(--serif); font-size: 1.3rem; font-weight: 700; margin: 8px 0 4px; }
  .desc { margin: 0; color: var(--ink-2); font-size: .93rem; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
  .foot { display: flex; align-items: center; justify-content: space-between; gap: 8px; margin-top: auto; padding-top: 10px; min-height: 40px; border-top: 1px solid var(--line); }
  .amount { font-weight: 600; font-size: .92rem; color: var(--ok); }
  .terms { display: flex; flex-direction: column; gap: 2px; min-width: 0; }
  .ask { font-size: .85rem; color: var(--ink-2); }
  .badge.unk { border-style: dashed; font-style: italic; }
  .more { display: flex; justify-content: center; margin-top: 28px; }
  .more[hidden], .grid > li[hidden] { display: none; }

  .empty { text-align: center; padding: 48px 20px; }
    .empty p { color: var(--ink-2); }
  .empty-actions { display: flex; flex-wrap: wrap; justify-content: center; gap: 10px; }
  .missing { display: flex; flex-wrap: wrap; align-items: center; gap: 16px 20px; margin-top: var(--gap-sec); padding: 18px 0; border-block: 1px solid var(--ink); }
  .missing[hidden] { display: none; }
  .missing div { flex: 1 1 260px; }
  .missing h2 { font-size: 1.15rem; }
  .missing p { margin: 4px 0 0; color: var(--ink-2); }
</style>

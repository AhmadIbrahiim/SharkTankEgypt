---
import Base from '../../layouts/Base.astro';
import Shot from '../../components/Shot.astro';
import { langs, startups, giscus, t, terms, screenshot, type Lang, type Startup } from '../../config';

export const getStaticPaths = () =>
  langs.flatMap((lang) => startups.map((x) => ({ params: { lang, id: x.id }, props: { x } })));
const lang = Astro.params.lang as Lang;
const { x } = Astro.props as { x: Startup };
const s = t[lang];
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const num = (n: number) => n.toLocaleString(lang === 'ar' ? 'ar-EG' : 'en-US');
const commentsOn = giscus.repoId && giscus.categoryId;
const otherName = x.name[lang === 'ar' ? 'en' : 'ar'];
// Both names in the title so the page matches Arabic and English searches.
const pageTitle = `${x.name[lang]} (${otherName}) – ${s.season} ${num(x.season)}`;
const image = screenshot(x.id) ?? undefined;
const site = new URL(import.meta.env.BASE_URL, Astro.site).href;
const jsonld = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: x.name[lang],
  alternateName: otherName,
  description: x.description[lang],
  ...(x.website && { url: x.website }),
  ...(image && { image: new URL(image.slice(1), site).href }),
  ...(x.founders?.length && { founder: x.founders.map((name) => ({ '@type': 'Person', name })) }),
  subjectOf: { '@type': 'TVEpisode', partOfSeries: { '@type': 'TVSeries', name: 'Shark Tank Egypt', alternateName: 'شارك تانك مصر' },
    partOfSeason: { '@type': 'TVSeason', seasonNumber: x.season }, ...(x.episode != null && { episodeNumber: x.episode }) },
};
---
<Base lang={lang} title={pageTitle} description={x.description[lang]} image={image} jsonld={jsonld} altPath={`/${lang === 'ar' ? 'en' : 'ar'}/${x.id}/`}>
  <a href={`${base}/${lang}/`}>{s.back}</a>
  <article>
    <div class="shotwrap">
      {x.website ? <a href={x.website} target="_blank" rel="noopener"><Shot id={x.id} name={x.name[lang]} /></a> : <Shot id={x.id} name={x.name[lang]} />}
    </div>
    <div>
      <h1>{x.name[lang]} <small>{x.name[lang === 'ar' ? 'en' : 'ar']}</small></h1>
      <p class="meta">
        {s.season} {num(x.season)}{x.episode != null && ` · ${s.episode} ${num(x.episode)}`}
        {x.category && <span class="badge">{x.category}</span>}
        {x.deal?.made != null && <span class={`badge ${x.deal.made ? 'ok' : 'no'}`}>{x.deal.made ? s.deal : s.noDeal}</span>}
      </p>
      <p>{x.description[lang]}</p>
      <dl>
        {x.website && <><dt>{s.website}</dt><dd><a href={x.website} target="_blank" rel="noopener">{x.website.replace(/^https?:\/\/(www\.)?/, '').replace(/\/$/, '')}</a></dd></>}
        {x.founders?.length > 0 && <><dt>{s.founders}</dt><dd>{x.founders.join('، ')}</dd></>}
        <dt>{s.ask}</dt><dd>{terms(x.ask?.amountEGP, x.ask?.equityPct, lang)}</dd>
        {x.deal?.made && <><dt>{s.finalDeal}</dt><dd>{terms(x.deal.amountEGP, x.deal.equityPct, lang)}</dd></>}
        {x.deal?.sharks?.length > 0 && <><dt>{s.sharks}</dt><dd>{x.deal.sharks.join('، ')}</dd></>}
      </dl>
    </div>
  </article>

  <section>
    <h2>{s.comments}</h2>
    {commentsOn ? (
      <>
        <p class="muted">{s.rateHint}</p>
        {/* One discussion per startup, shared by both languages. */}
        <script src="https://giscus.app/client.js" data-repo={giscus.repo} data-repo-id={giscus.repoId}
          data-category={giscus.category} data-category-id={giscus.categoryId}
          data-mapping="specific" data-term={x.id} data-strict="1" data-reactions-enabled="1"
          data-emit-metadata="0" data-input-position="top" data-theme="preferred_color_scheme"
          data-lang={lang} data-loading="lazy" crossorigin="anonymous" async></script>
      </>
    ) : <p class="muted">{s.commentsOff}</p>}
  </section>

  {x.sources?.length > 0 && (
    <details>
      <summary>{s.sources}</summary>
      <ul>{x.sources.map((u) => <li><a href={u} target="_blank" rel="noopener">{u}</a></li>)}</ul>
    </details>
  )}
</Base>

<style>
  article { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 24px; margin: 16px 0 32px; }
  @media (max-width: 760px) { article { grid-template-columns: 1fr; } }
  .shotwrap a { text-decoration: none; }
  .shotwrap { border-radius: 14px; overflow: hidden; border: 1px solid var(--line); align-self: start; }
  h1 { margin: 0; line-height: 1.3; }
  h1 small { color: var(--muted); font-size: .55em; font-weight: 400; }
  .meta { color: var(--muted); display: flex; gap: 8px; flex-wrap: wrap; align-items: center; }
  .muted { color: var(--muted); }
  dl { display: grid; grid-template-columns: max-content 1fr; gap: 6px 16px; }
  dt { color: var(--muted); }
  dd { margin: 0; overflow-wrap: anywhere; }
  details { margin-top: 32px; color: var(--muted); overflow-wrap: anywhere; }
</style>

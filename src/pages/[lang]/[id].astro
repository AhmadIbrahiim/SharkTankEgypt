---
import Base from '../../layouts/Base.astro';
import Shot from '../../components/Shot.astro';
import Sharks from '../../components/Sharks.astro';
import Links from '../../components/Links.astro';
import Avatar from '../../components/Avatar.astro';
import { langs, startups, giscus, t, num, money, pct, valuation, screenshot, thumb, category, suggestUrl, founderId, founders as allFounders, seasonLabel, type Lang, type Startup } from '../../config';

export const getStaticPaths = () =>
  langs.flatMap((lang) => startups.map((x, i) => ({ params: { lang, id: x.id }, props: { i } })));
const lang = Astro.params.lang as Lang;
const { i } = Astro.props as { i: number };
const x: Startup = startups[i];
const prev = startups[i - 1], next = startups[i + 1];
const s = t[lang];
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const commentsOn = giscus.repoId && giscus.categoryId;
const otherName = x.name[lang === 'ar' ? 'en' : 'ar'];
// Both names in the title so the page matches Arabic and English searches.
const pageTitle = `${x.name[lang]} (${otherName}) – ${seasonLabel(x.season, lang)}`;
const image = screenshot(x.id) ?? (x.video ? thumb(x.video) : undefined);
const site = new URL(import.meta.env.BASE_URL, Astro.site).href;
const host = x.website?.replace(/^https?:\/\/(www\.)?/, '').replace(/\/$/, '');
const terms = [
  { label: s.ask, amount: x.ask?.amountEGP, equity: x.ask?.equityPct, tone: '' },
  ...(x.deal?.made ? [{ label: s.finalDeal, amount: x.deal.amountEGP, equity: x.deal.equityPct, tone: 'ok' }] : []),
].filter((d) => d.amount != null || d.equity != null);
// Every known profile, so search engines can tie them to this startup.
const sameAs = [x.website, ...Object.entries(x.links ?? {}).flatMap(([k, v]) => (k === 'other' ? (v as { url: string }[]).map((o) => o.url) : [v as string]))].filter(Boolean);
const missing = Object.entries({
  founders: !x.founders?.length, ask: x.ask?.amountEGP == null, deal: x.deal?.made == null,
  links: !x.website && !Object.keys(x.links ?? {}).length, video: !x.video,
}).filter(([, m]) => m).map(([k]) => s.missingLabels[k as keyof typeof s.missingLabels]);
// GitHub issue forms prefill fields from query params named after their ids.
const helpUrl = `${suggestUrl}&title=${encodeURIComponent(`[Update] ${x.name.en}`)}&name_en=${encodeURIComponent(x.name.en)}&name_ar=${encodeURIComponent(x.name.ar)}${x.episode != null ? `&episode=${x.episode}` : ''}`;
const services = (x as any).services as { en: { name: string; desc: string }[]; ar: { name: string; desc: string }[] } | undefined;
const pitchText = (x as any).pitch as { en: string; ar: string } | undefined;
const team = (x.founders ?? []).map((n) => allFounders.find((f) => f.id === founderId(n)) ?? { id: founderId(n), name: { en: n, ar: n } } as any);
const hasLinks = !!x.website || Object.keys(x.links ?? {}).length > 0;
const about = (x as any).about as { founded?: number; city?: { en: string; ar: string }; highlights?: { en: string[]; ar: string[] } } | undefined;
const jsonld = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: x.name[lang],
  alternateName: otherName,
  description: x.description[lang],
  ...(x.website && { url: x.website }),
  ...(sameAs.length && { sameAs }),
  ...(about?.founded && { foundingDate: String(about.founded) }),
  ...(about?.city && { address: { '@type': 'PostalAddress', addressLocality: about.city.en, addressCountry: 'EG' } }),
  ...(image && { image: image.startsWith('http') ? image : new URL(image.slice(1), site).href }),
  ...(x.founders?.length && { founder: x.founders.map((name) => ({ '@type': 'Person', name })) }),
  subjectOf: { '@type': 'TVEpisode', partOfSeries: { '@type': 'TVSeries', name: 'Shark Tank Egypt', alternateName: 'شارك تانك مصر' },
    partOfSeason: { '@type': 'TVSeason', seasonNumber: x.season }, ...(x.episode != null && { episodeNumber: x.episode }) },
};
const arrow = (dir: 'back' | 'fwd') => ((dir === 'back') === (lang === 'ar') ? '→' : '←');
---
<Base lang={lang} title={pageTitle} description={x.description[lang]} image={image} jsonld={jsonld} altPath={`/${lang === 'ar' ? 'en' : 'ar'}/${x.id}/`}>
  <div class="container">
    <nav class="crumbs" aria-label="breadcrumb">
      <a href={`${base}/${lang}/`}>{s.home}</a>
      <span aria-hidden="true">/</span>
      <a href={`${base}/${lang}/?s=${x.season}`}>{seasonLabel(x.season, lang)}</a>
      <span aria-hidden="true">/</span>
      <span aria-current="page">{x.name[lang]}</span>
    </nav>

    <article class="hero">
      <div class="info">
        <div class="row">
          <span class="badge">{seasonLabel(x.season, lang)}{x.episode != null && ` · ${s.episode} ${num(x.episode, lang)}`}</span>
          {x.category && <a class="badge nile" href={`${base}/${lang}/?c=${encodeURIComponent(x.category)}`}>{category(x.category, lang)}</a>}
          {x.deal?.made === true && <span class="badge ok">🤝 {s.deal}</span>}
          {x.deal?.made === false && <span class="badge">{s.noDeal}</span>}
        </div>
        <h1>{x.name[lang]}</h1>
        {otherName !== x.name[lang] && <p class="alt" lang={lang === 'ar' ? 'en' : 'ar'}>{otherName}</p>}
        {(about?.founded || about?.city) && (
          <p class="facts">
            {about.city && <span>📍 {s.basedIn}: {about.city[lang]}</span>}
            {about.founded && <span>🗓️ {s.founded} {num(about.founded, lang).replace(/[٬,]/g, '')}</span>}
          </p>
        )}
        <p class="lead">{x.description[lang].split(/(?<=[.!?؟])\s+/)[0]}</p>
        <div class="actions">
          {x.website && (
            <a class="btn btn-primary" href={x.website} target="_blank" rel="noopener">
              {s.visit}
              <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true" class="ext"><path d="M7 17 17 7M9 7h8v8" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </a>
          )}
          <a class="btn btn-ghost" href="#comments">💬 {s.comments}</a>
        </div>
      </div>
      <div class="visual">
        {x.video ? (
          <div class="player" data-video={x.video} data-title={`${s.watch}: ${x.name[lang]}`}>
            <button type="button" class="frame video" aria-label={`${s.watch}: ${x.name[lang]}`}>
              <img class="shot" src={thumb(x.video)} alt="" width="480" height="360" />
              <span class="play" aria-hidden="true"></span>
            </button>
          </div>
        ) : x.website ? (
          <a href={x.website} target="_blank" rel="noopener" aria-label={`${s.visit}: ${host}`}><Shot id={x.id} name={x.name[lang]} eager /></a>
        ) : <Shot id={x.id} name={x.name[lang]} eager />}
        {x.video ? <p class="cap">▶ {s.watch}</p> : host && <p class="host">{host}</p>}
      </div>
    </article>

    <nav class="secnav" aria-label={x.name[lang]}>
      <a href="#overview">{s.secOverview}</a>
      {services?.[lang]?.length > 0 && <a href="#services">{s.secServices}</a>}
      <a href="#pitch">{s.secPitch}</a>
      {team.length > 0 && <a href="#team">{s.secTeam}</a>}
      {hasLinks && <a href="#online">{s.secOnline}</a>}
    </nav>

    <section id="overview" class="sec">
      <h2>{s.secOverview}</h2>
      <p class="overview">{x.description[lang]}</p>
      {about?.highlights?.[lang]?.length > 0 && (
        <div class="glance">
          <h3>✨ {s.glance}</h3>
          <ul>{about.highlights[lang].map((h) => <li>{h}</li>)}</ul>
        </div>
      )}
    </section>

    {services?.[lang]?.length > 0 && (
      <section id="services" class="sec">
        <h2>{s.secServices}</h2>
        <ul class="services">
          {services[lang].map((it, i) => <li><span class="num">{num(i + 1, lang)}</span><h3>{it.name}</h3><p>{it.desc}</p></li>)}
        </ul>
      </section>
    )}

    <section id="pitch" class="sec">
      <h2>{s.secPitch}</h2>
      {pitchText && <p class="pitchtext">{pitchText[lang]}</p>}
      {terms.length > 0 && (
      <section class="terms">
        {terms.map((d) => {
          const v = valuation(d.amount, d.equity);
          return (
            <div class:list={['term', d.tone]}>
              <h2>{d.label}</h2>
              <p class="big">{money(d.amount, lang) ?? '—'}</p>
              <p class="small">
                {d.equity != null && <>{s.forEquity} <strong>{pct(d.equity, lang)}</strong></>}
                {v && <> · {s.valuation} {money(v, lang)}</>}
              </p>
            </div>
          );
        })}
        {x.deal?.sharks?.length > 0 && (
          <div class="term sharks">
            <h2>{s.sharks}</h2>
            <Sharks names={x.deal.sharks} lang={lang} labels />
          </div>
        )}
      </section>
    )}

    </section>

    {team.length > 0 && (
      <section id="team" class="sec">
        <h2>{s.secTeam}</h2>
        <ul class="team">
          {team.map((f) => (
            <li><a href={`${base}/${lang}/founders/${f.id}/`}>
              <Avatar name={f.name.en} seed={f.id} size={56} />
              <span><strong>{f.name[lang]}</strong>{f.title && <small>{f.title[lang]}</small>}</span>
            </a></li>
          ))}
        </ul>
      </section>
    )}

    {hasLinks && (
      <section id="online" class="sec">
        <Links website={x.website} links={x.links} lang={lang} label={s.secOnline} />
      </section>
    )}

    <aside class="help">
      <div>
        <h2>{s.helpTitle}</h2>
        <p>{s.helpText}</p>
        {missing.length > 0 && <p class="miss"><strong>{s.helpMissing}</strong> {missing.join(lang === 'ar' ? '، ' : ', ')}</p>}
      </div>
      <a class="btn btn-primary" href={helpUrl} target="_blank" rel="noopener">＋ {s.helpBtn}</a>
    </aside>

    <section id="comments" class="comments">
      <h2>💬 {s.comments}</h2>
      {commentsOn ? (
        <>
          <p class="hint">{s.rateHint}</p>
          {/* One discussion per startup, shared by both languages. */}
          <script src="https://giscus.app/client.js" data-repo={giscus.repo} data-repo-id={giscus.repoId}
            data-category={giscus.category} data-category-id={giscus.categoryId}
            data-mapping="specific" data-term={x.id} data-strict="1" data-reactions-enabled="1"
            data-emit-metadata="0" data-input-position="top" data-theme="preferred_color_scheme"
            data-lang={lang} data-loading="lazy" crossorigin="anonymous" async></script>
        </>
      ) : <p class="hint">{s.commentsOff}</p>}
    </section>

    <nav class="pager" aria-label={`${s.prev} / ${s.next}`}>
      {prev ? <a class="pg" href={`${base}/${lang}/${prev.id}/`}><small>{arrow('back')} {s.prev}</small><span>{prev.name[lang]}</span></a> : <span />}
      {next && <a class="pg next" href={`${base}/${lang}/${next.id}/`}><small>{s.next} {arrow('fwd')}</small><span>{next.name[lang]}</span></a>}
    </nav>

    {x.sources?.length > 0 && (
      <details class="sources">
        <summary>{s.sources} ({num(x.sources.length, lang)})</summary>
        <ul>{x.sources.map((u) => <li><a href={u} target="_blank" rel="noopener nofollow" dir="ltr">{u}</a></li>)}</ul>
      </details>
    )}
  </div>
</Base>

<script>
  // Load YouTube only on click: keeps the page fast and avoids tracking until the visitor opts in.
  for (const p of document.querySelectorAll<HTMLElement>('.player')) {
    p.querySelector('button')!.addEventListener('click', () => {
      const f = document.createElement('iframe');
      f.src = `https://www.youtube-nocookie.com/embed/${p.dataset.video}?autoplay=1&rel=0`;
      f.title = p.dataset.title!;
      f.allow = 'autoplay; encrypted-media; picture-in-picture; fullscreen';
      f.allowFullscreen = true;
      p.replaceChildren(f);
    });
  }
</script>

<style>
  .crumbs { display: flex; flex-wrap: wrap; gap: 8px; padding-top: 22px; font-size: .9rem; color: var(--ink-2); }
  .crumbs a { color: var(--ink-2); text-decoration: none; }
  .crumbs a:hover { color: var(--sun-ink); }
  .crumbs [aria-current] { color: var(--ink); }

  .hero { display: grid; grid-template-columns: 1fr 1.05fr; gap: 40px; align-items: center; padding-block: 28px 36px; }
  @media (max-width: 860px) { .hero { grid-template-columns: 1fr; gap: 24px; } .visual { order: -1; } }
  .row { display: flex; gap: 6px; flex-wrap: wrap; }
  a.badge { text-decoration: none; }
  h1 { font-size: clamp(2rem, 4.5vw, 3rem); margin-top: 14px; letter-spacing: -.02em; }
  :global([dir='rtl']) h1 { letter-spacing: 0; }
  .alt { margin: 4px 0 0; color: var(--ink-2); font-size: 1.1rem; }
  .facts { display: flex; flex-wrap: wrap; gap: 6px 16px; margin: 12px 0 0; color: var(--ink-2); font-size: .95rem; }
  .secnav { position: sticky; top: 64px; z-index: 5; display: flex; gap: 4px; overflow-x: auto; margin: 8px 0 4px; padding: 6px; border-radius: 999px; background: color-mix(in srgb, var(--surface) 88%, transparent); backdrop-filter: blur(10px); box-shadow: var(--shadow); scrollbar-width: none; }
  .secnav a { flex: none; padding: 7px 16px; border-radius: 999px; color: var(--ink-2); text-decoration: none; font-size: .92rem; }
  .secnav a:hover { background: var(--surface-2); color: var(--ink); }
  .sec { margin-top: 36px; scroll-margin-top: 130px; }
  .sec > h2 { font-size: 1.4rem; margin-bottom: 14px; }
  .overview { font-size: 1.08rem; max-width: 75ch; margin: 0 0 18px; }
  .pitchtext { font-size: 1.05rem; max-width: 75ch; margin: 0 0 18px; padding-inline-start: 16px; border-inline-start: 4px solid var(--sun); }
  .services { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 260px), 1fr)); gap: 14px; }
  .services li { position: relative; padding: 20px 20px 18px; border-radius: var(--radius); background: var(--surface); box-shadow: var(--shadow); }
  .services .num { display: inline-grid; place-items: center; width: 30px; height: 30px; border-radius: 10px; background: var(--sun-soft); color: var(--sun-ink); font-weight: 650; font-size: .9rem; }
  .services h3 { font-size: 1.02rem; margin: 12px 0 4px; }
  .services p { margin: 0; color: var(--ink-2); font-size: .93rem; }
  .team { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 260px), 1fr)); gap: 12px; }
  .team a { display: flex; align-items: center; gap: 14px; padding: 14px 16px; border-radius: 16px; background: var(--surface); box-shadow: var(--shadow); color: inherit; text-decoration: none; transition: transform .2s; }
  .team a:hover { transform: translateY(-2px); }
  .team span { display: flex; flex-direction: column; }
  .team small { color: var(--ink-2); font-size: .85rem; }
  .glance h3 { font-size: 1.05rem; margin-bottom: 12px; }
  .glance { margin-bottom: 16px; padding: 22px 26px; border-radius: var(--radius); background: var(--surface); box-shadow: var(--shadow); }
  .glance h2 { font-size: 1.1rem; margin-bottom: 12px; }
  .glance ul { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 10px 28px; }
  .glance li { position: relative; padding-inline-start: 28px; }
  .glance li::before { content: '✓'; position: absolute; inset-inline-start: 0; top: 1px; width: 20px; height: 20px; border-radius: 50%; display: grid; place-items: center; font-size: .75rem; font-weight: 700; color: var(--ok); background: var(--ok-soft); }
  .lead { font-size: 1.12rem; margin: 18px 0 24px; }
  .actions { display: flex; flex-wrap: wrap; gap: 10px; }
  :global([dir='rtl']) .ext { transform: scaleX(-1); }
  .founders { margin: 22px 0 0; color: var(--ink-2); }
  .founders span { font-weight: 500; color: var(--ink); margin-inline-end: 6px; }
  .visual { padding: 12px; border-radius: calc(var(--radius) + 6px); background: var(--surface); box-shadow: var(--shadow-lift); transform: rotate(-1deg); transition: transform .4s; }
  :global([dir='rtl']) .visual { transform: rotate(1deg); }
  .visual:hover, :global([dir='rtl']) .visual:hover { transform: rotate(0); }
  .visual a { text-decoration: none; }
  .visual :global(.ph) { font-size: clamp(1.8rem, 4vw, 2.6rem); }
  .player button { display: block; width: 100%; padding: 0; border: 0; cursor: pointer; }
  .player iframe { display: block; width: 100%; aspect-ratio: 16 / 9; border: 0; border-radius: 14px; }
  .player .play { width: 72px; height: 72px; }
  .cap { margin: 10px 4px 0; font-size: .85rem; color: var(--ink-2); text-align: center; }
  .host { margin: 10px 4px 0; font-size: .85rem; color: var(--ink-2); direction: ltr; text-align: center; }

  .terms { display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 16px; }
  .term { padding: 20px 22px; border-radius: var(--radius); background: var(--surface); box-shadow: var(--shadow); }
  .term.ok { background: var(--ok-soft); box-shadow: none; }
  .term h2 { font-size: .9rem; font-weight: 500; color: var(--ink-2); }
  .term.ok h2, .term.ok .big { color: var(--ok); }
  .big { font-size: 1.9rem; font-weight: 650; margin: 6px 0 2px; }
  .small { margin: 0; color: var(--ink-2); font-size: .92rem; }
  .small strong { color: var(--ink); font-weight: 600; }
  .sharks h2 { margin-bottom: 12px; }

  .help { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 16px 24px; margin-top: 28px; padding: 20px 24px; border-radius: var(--radius); border: 2px dashed color-mix(in srgb, var(--sun) 45%, var(--line)); background: color-mix(in srgb, var(--sun-soft) 55%, transparent); }
  .help div { flex: 1 1 280px; }
  .help h2 { font-size: 1.1rem; }
  .help p { margin: 4px 0 0; color: var(--ink-2); }
  .help .miss strong { color: var(--sun-ink); font-weight: 600; }
  .comments { margin-top: 40px; padding: 28px; border-radius: var(--radius); background: var(--surface); box-shadow: var(--shadow); scroll-margin-top: 80px; }
  .comments h2 { font-size: 1.35rem; }
  .hint { color: var(--ink-2); margin: 8px 0 20px; }

  .pager { display: flex; justify-content: space-between; gap: 16px; margin-top: 32px; }
  .pg { display: flex; flex-direction: column; max-width: 48%; padding: 14px 18px; border-radius: 16px; border: 1px solid var(--line); color: var(--ink); text-decoration: none; transition: border-color .2s, background .2s; }
  .pg:hover { border-color: var(--sun); background: var(--surface); }
  .pg small { color: var(--ink-2); }
  .pg span { font-weight: 500; }
  .pg.next { text-align: end; margin-inline-start: auto; }

  .sources { margin-top: 28px; color: var(--ink-2); font-size: .9rem; }
  .sources summary { cursor: pointer; }
  .sources ul { padding-inline-start: 20px; }
  .sources a { overflow-wrap: anywhere; color: var(--ink-2); }
</style>

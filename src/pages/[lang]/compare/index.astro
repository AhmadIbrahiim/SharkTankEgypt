---
// Compare two or more startups side by side. The selection lives in the URL (?ids=a,b,c) so a comparison can be shared.
import Base from '../../../layouts/Base.astro';
import { langs, startups, verification, category, seasonLabel, shark, type Lang } from '../../../config';

export const getStaticPaths = () => langs.map((lang) => ({ params: { lang } }));
const lang = Astro.params.lang as Lang;
const ar = lang === 'ar';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
// Compact data for the page (the full dataset is ~800KB).
const data = startups.map((x) => ({ id: x.id, n: x.name[lang], s: seasonLabel(x.season, lang), e: x.episode, c: x.category && category(x.category, lang),
  aa: x.ask?.amountEGP ?? null, ae: x.ask?.equityPct ?? null, d: x.deal?.made ?? null, da: x.deal?.amountEGP ?? null, de: x.deal?.equityPct ?? null,
  sh: (x.deal?.sharks ?? []).map((k) => shark(k, lang)), v: verification(x) }));
const L = ar
  ? { title: 'قارن بين الشركات', intro: 'اختر شركتين أو أكثر لمقارنة المجال والموسم والمبلغ المطلوب والصفقة والتقييم. الرابط يحفظ المقارنة لمشاركتها.', add: 'أضف شركة', pick: 'اكتب اسم شركة…', remove: 'إزالة',
      rows: ['المجال', 'الموسم', 'المبلغ المطلوب', 'الحصة المعروضة', 'التقييم المطلوب', 'النتيجة', 'مبلغ الصفقة', 'حصة الصفقة', 'التقييم بعد الاستثمار', 'التقييم قبل الاستثمار', 'المستثمرون', 'التحقق'],
      deal: 'صفقة', noDeal: 'بدون صفقة', unknown: 'غير معروف', empty: 'لم تختر أي شركة بعد.', v: { verified: 'تم التحقق', partially_verified: 'تحقق جزئي', unverified: 'غير موثّق' }, egp: 'ج.م', ep: 'الحلقة' }
  : { title: 'Compare startups', intro: 'Pick two or more startups to compare sector, season, ask, deal and valuation. The link keeps the comparison so you can share it.', add: 'Add a startup', pick: 'Type a startup name…', remove: 'Remove',
      rows: ['Sector', 'Season', 'Asked', 'Equity offered', 'Asking valuation', 'Outcome', 'Deal amount', 'Deal equity', 'Post-money valuation', 'Pre-money valuation', 'Sharks', 'Verification'],
      deal: 'Deal', noDeal: 'No deal', unknown: 'unknown', empty: 'No startups picked yet.', v: { verified: 'Verified', partially_verified: 'Partially verified', unverified: 'Unverified' }, egp: 'EGP', ep: 'Ep.' };
---
<Base lang={lang} title={L.title} description={L.intro} altPath={`/${ar ? 'en' : 'ar'}/compare/`}>
  <div class="container">
    <header class="intro"><h1>{L.title}</h1><p>{L.intro}</p></header>
    <form class="pick" id="pick" onsubmit="return false">
      <label class="sr" for="add">{L.add}</label>
      <input id="add" list="names" placeholder={L.pick} autocomplete="off" />
      <datalist id="names">{data.map((x) => <option value={x.n} />)}</datalist>
    </form>
    <div class="scroll"><table id="cmp"></table></div>
    <p id="none" class="note">{L.empty}</p>
  </div>
</Base>
<script is:inline define:vars={{ data, L, base, lang }}>
  const byId = new Map(data.map((x) => [x.id, x]));
  const byName = new Map(data.map((x) => [x.n.toLowerCase(), x]));
  const nf = new Intl.NumberFormat(lang === 'ar' ? 'ar-EG' : 'en-US', { notation: 'compact', maximumFractionDigits: 1 });
  const money = (n) => (n == null ? null : `${nf.format(n)} ${L.egp}`);
  const loc = lang === 'ar' ? 'ar-EG' : 'en-US', pf = new Intl.NumberFormat(loc, { style: 'percent', maximumFractionDigits: 1 }), inf = new Intl.NumberFormat(loc);
  const pct = (n) => (n == null ? null : pf.format(n / 100));
  const post = (a, e) => (a && e ? a / (e / 100) : null);
  const esc = (t) => String(t).replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' })[c]);
  let ids = (new URLSearchParams(location.search).get('ids') ?? '').split(',').filter((id) => byId.has(id));
  const render = () => {
    const xs = ids.map((id) => byId.get(id));
    const cell = (v) => (v == null || v === '' ? `<td class="unk">${L.unknown}</td>` : `<td>${esc(v)}</td>`);
    const rows = [
      (x) => x.c, (x) => `${x.s}${x.e != null ? ` · ${L.ep} ${inf.format(x.e)}` : ''}`, (x) => money(x.aa), (x) => pct(x.ae), (x) => money(post(x.aa, x.ae)),
      (x) => (x.d === true ? L.deal : x.d === false ? L.noDeal : null),
      (x) => (x.d ? money(x.da) : x.d === false ? '—' : null), (x) => (x.d ? pct(x.de) : x.d === false ? '—' : null),
      (x) => (x.d ? money(post(x.da, x.de)) : x.d === false ? '—' : null), (x) => (x.d ? money(post(x.da, x.de) != null ? post(x.da, x.de) - x.da : null) : x.d === false ? '—' : null),
      (x) => (x.d ? x.sh.join(lang === 'ar' ? '، ' : ', ') || null : x.d === false ? '—' : null), (x) => L.v[x.v],
    ];
    document.getElementById('cmp').innerHTML = xs.length ? `<thead><tr><th></th>${xs.map((x) => `<th><a href="${base}/${lang}/${x.id}/">${esc(x.n)}</a> <button type="button" data-rm="${x.id}" aria-label="${L.remove} ${esc(x.n)}">×</button></th>`).join('')}</tr></thead>
      <tbody>${rows.map((f, i) => `<tr><th scope="row">${L.rows[i]}</th>${xs.map((x) => cell(f(x))).join('')}</tr>`).join('')}</tbody>` : '';
    document.getElementById('none').hidden = xs.length > 0;
    const u = new URL(location.href); if (ids.length) u.searchParams.set('ids', ids.join(',')); else u.searchParams.delete('ids'); history.replaceState(null, '', u);
  };
  const add = document.getElementById('add');
  add.addEventListener('change', () => { const x = byName.get(add.value.trim().toLowerCase()); if (x && !ids.includes(x.id)) ids.push(x.id); add.value = ''; render(); });
  document.getElementById('cmp').addEventListener('click', (e) => { const id = e.target.closest('[data-rm]')?.dataset.rm; if (id) { ids = ids.filter((i) => i !== id); render(); } });
  render();
</script>
<style>
  .intro { margin: 28px 0 16px; text-align: center; }
  .intro h1 { font-size: clamp(1.9rem, 4.4vw, 2.9rem); margin-inline: auto; }
  .intro p { color: var(--ink-2); max-width: 70ch; margin-inline: auto; }
  .pick { text-align: center; }
  .pick input { font: inherit; width: min(100%, 420px); padding: 10px 14px; border: 1px solid var(--line); border-radius: 0; background: var(--surface); color: var(--ink); }
  .scroll { overflow-x: auto; margin-top: 16px; border-top: 2px solid var(--ink); border-bottom: 1px solid var(--ink); }
  .scroll:has(table:empty) { display: none; }
  :global(#cmp) { width: 100%; border-collapse: collapse; font-size: .93rem; }
  :global(#cmp th), :global(#cmp td) { padding: 9px 12px; border-top: 1px solid var(--line); text-align: start; white-space: nowrap; }
  :global(#cmp thead th) { border-top: 0; font-weight: 650; }
  :global(#cmp tbody th) { color: var(--ink-2); font-weight: 500; font-size: .86rem; }
  :global(#cmp td.unk) { color: var(--ink-2); font-style: italic; }
  :global(#cmp button) { border: 0; background: none; color: var(--ink-2); cursor: pointer; font-size: 1rem; padding: 0 4px; }
  .note { color: var(--ink-2); margin-top: 12px; }
</style>

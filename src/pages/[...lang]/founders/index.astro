---
import Base from '../../../layouts/Base.astro';
import Avatar from '../../../components/Avatar.astro';
import { langs, seg, pre, founders, seasons, seasonLabel, t, num, type Lang, digits } from '../../../config';

export const getStaticPaths = () => langs.map((lang) => ({ params: { lang: seg(lang) } }));
const lang = (Astro.params.lang ?? 'ar') as Lang;
const s = t[lang];
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<Base lang={lang} title={s.foundersTitle} description={s.foundersIntro} card={{ kind: 'list', title: s.foundersTitle, sub: s.foundersIntro, faces: founders.filter((p) => p.photo).map((p) => p.photo!.url) }} altPath={`${pre(lang === 'ar' ? 'en' : 'ar')}/founders/`}>
  <div class="container">
    <header class="intro">
      <h1>{s.foundersTitle}</h1>
      <p>{s.foundersIntro}</p>
      <input id="fq" type="search" placeholder={s.searchPeople} aria-label={s.searchPeople} />
      <div class="filters">
        <select id="fs" aria-label={s.season}><option value="">{lang === 'ar' ? 'كل المواسم' : 'All seasons'}</option>
          {[...seasons].sort((a, b) => (a.season || 99) - (b.season || 99)).map((x) => <option value={x.season}>{seasonLabel(x.season, lang)}</option>)}</select>
        <select id="fd" aria-label={s.finalDeal}><option value="">{s.all}</option><option value="1">{s.deal}</option><option value="0">{s.noDeal}</option></select>
      </div>
      <p class="count"><b id="fc">{num(founders.length, lang)}</b></p>
    </header>
    <ul class="people" id="fl">
      {founders.map((p) => (
        <li data-s={` ${[...new Set(p.startups.map((x) => x.season))].join(' ')} `} data-d={p.startups.some((x) => x.deal?.made) ? '1' : p.startups.some((x) => x.deal?.made === false) ? '0' : ''} data-text={[p.name.en, p.name.ar, ...p.startups.flatMap((x) => [x.name.en, x.name.ar])].join(' ').toLowerCase()}>
          <a href={`${base}${pre(lang)}/founders/${p.id}/`}>
            <Avatar name={p.name.en} seed={p.id} photo={p.photo} size={52} />
            <span>
              <strong>{p.name[lang]}</strong>
              <small>{digits(p.title?.[lang] ?? '', lang) || p.startups.map((x) => x.name[lang]).join(lang === 'ar' ? '، ' : ', ')}</small>
            </span>
            
          </a>
        </li>
      ))}
    </ul>
  </div>
</Base>
<script>
  const q = document.getElementById('fq') as HTMLInputElement;
  const items = [...document.querySelectorAll<HTMLElement>('#fl li')];
  const fmt = new Intl.NumberFormat(document.documentElement.lang === 'ar' ? 'ar-EG' : 'en-US');
  const fs = document.getElementById('fs') as HTMLSelectElement, fd = document.getElementById('fd') as HTMLSelectElement;
  const apply = () => {
    const v = q.value.trim().toLowerCase();
    let n = 0;
    for (const li of items) {
      const d = li.dataset;
      li.hidden = (!!v && !d.text!.includes(v)) || (!!fs.value && !d.s!.includes(` ${fs.value} `)) || (!!fd.value && d.d !== fd.value);
      if (!li.hidden) n++;
    }
    document.getElementById('fc')!.textContent = fmt.format(n);
  };
  q.addEventListener('input', apply);
  fs.addEventListener('change', apply);
  fd.addEventListener('change', apply);
</script>
<style>
  .intro { padding: 36px 0 18px; border-bottom: 1px solid var(--line); text-align: center; }
  .intro h1 { font-size: clamp(1.9rem, 4.4vw, 2.9rem); margin-inline: auto; }
  .intro p { color: var(--ink-2); max-width: 60ch; margin: 10px auto 0; }
  input { width: min(100%, 520px); margin-top: 20px; font: inherit; padding: 11px 14px; border: 1px solid var(--ink); background: var(--surface); color: var(--ink); }
  input:focus { outline: none; border-color: var(--sun); }
  .count { font-size: .9rem; }
  .filters { display: flex; justify-content: center; gap: 8px; margin-top: 12px; }
  select { font: inherit; font-size: .9rem; padding: 8px 14px; border: 1px solid var(--line); border-radius: 0; background: var(--surface); color: var(--ink); }
  #fl li[hidden] { display: none; }
  .people { list-style: none; padding: 0; margin: 20px 0 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 280px), 1fr)); gap: 0 26px; }
  .people a { display: flex; align-items: center; gap: 14px; height: 100%; padding: 10px 0; border-top: 1px solid var(--line); color: inherit; text-decoration: none; }
  .people a:hover strong, .people a:hover b { color: var(--sun-ink); text-decoration: underline; }
  .people span { display: flex; flex-direction: column; min-width: 0; }
  strong { font-weight: 600; }
  small { color: var(--ink-2); font-size: .82rem; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  i { margin-inline-start: auto; color: var(--sun); font-style: normal; }
</style>

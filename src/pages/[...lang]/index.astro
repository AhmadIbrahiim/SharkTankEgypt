---
import Base from '../../layouts/Base.astro';
import { ID, ROOT } from '../../schema';
import Shot from '../../components/Shot.astro';
import Sharks from '../../components/Sharks.astro';
import Avatar from '../../components/Avatar.astro';
import EpisodePreview from '../../components/EpisodePreview.astro';
import { langs, seg, pre, listCard, startups, seasons, sharks, founders, founderId, t, num, money, pct, category, seasonLabel, shark, suggestUrl, thumb, valuation, digits, type Lang, dir } from '../../config';
import { norm } from '../../search.mjs';

export const getStaticPaths = () => langs.map((lang) => ({ params: { lang: seg(lang) } }));
const lang = (Astro.params.lang ?? 'ar') as Lang;
const s = t[lang];
const ar = lang === 'ar';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const categories = [...new Set(startups.map((x) => x.category).filter(Boolean))].sort() as string[];
const deals = startups.filter((x) => x.deal?.made);
const invested = deals.reduce((sum, x) => sum + (x.deal?.amountEGP ?? 0), 0);
const featured = startups.find((x) => x.id === 'al-ahram-cookware');
const panel = sharks.filter((p) => p.deals.length).sort((a, b) => b.deals.length - a.deals.length).slice(0, 8);
// One tile per season: counts and money, linking to the season page (the startups themselves are in the grid below).
const seasonTiles = [...seasons].filter((x) => x.season > 0).sort((a, b) => b.season - a.season).map((x) => {
  const xs = startups.filter((y) => y.season === x.season), d = xs.filter((y) => y.deal?.made);
  return { n: x.season, year: x.year, count: xs.length, deals: d.length, invested: d.reduce((t, y) => t + (y.deal?.amountEGP ?? 0), 0) };
});
// The record board: extremes computed from the data, each linking to its page.
type S = (typeof startups)[number];
const pick = (xs: S[], f: (x: S) => number | null | undefined, dir: 1 | -1) => xs.filter((x) => f(x) != null).sort((a, b) => dir * (f(b)! - f(a)!))[0];
const dealVal = (x: S) => valuation(x.deal?.amountEGP, x.deal?.equityPct);
const big = pick(deals, (x) => x.deal?.amountEGP, 1), small = pick(deals, (x) => x.deal?.amountEGP, -1);
const topVal = pick(deals, dealVal, 1), bigAsk = pick(startups, (x) => x.ask?.amountEGP, 1);
const most = panel[0];
const records = [
  big && { k: ar ? 'أكبر صفقة' : 'Biggest deal', v: money(big.deal!.amountEGP!, lang), who: big.name[lang], href: `${base}${pre(lang)}/${big.id}/`, tone: 'gold' },
  topVal && { k: ar ? 'أعلى تقييم' : 'Highest valuation', v: money(dealVal(topVal)!, lang), who: topVal.name[lang], href: `${base}${pre(lang)}/${topVal.id}/`, tone: 'teal' },
  most && { k: ar ? 'أكثر مستثمر صفقات' : 'Most deals', v: `${num(most.deals.length, lang)} ${ar ? 'صفقة' : 'deals'}`, who: most.name[lang], href: `${base}${pre(lang)}/sharks/${most.id}/`, photo: most.photo, tone: 'crimson' },
  bigAsk && { k: ar ? 'أكبر طلب' : 'Biggest ask', v: money(bigAsk.ask!.amountEGP!, lang), who: bigAsk.name[lang], href: `${base}${pre(lang)}/${bigAsk.id}/`, tone: 'sand' },
  small && { k: ar ? 'أصغر صفقة' : 'Smallest deal', v: money(small.deal!.amountEGP!, lang), who: small.name[lang], href: `${base}${pre(lang)}/${small.id}/`, tone: 'green' },
].filter(Boolean) as { k: string; v: string; who: string; href: string; photo?: any; tone: string }[];
const tag = (x: (typeof startups)[number]) => x.deal?.made === true ? ['ok', s.deal] : x.deal?.made === false ? ['no', s.noDeal] : ['unk', ar ? 'غير مؤكدة' : 'Unconfirmed'];
const first = (t: string) => t.split(/(?<=[.!?؟])\s/)[0];
const arName = new Map(founders.map((f) => [f.id, f.name.ar]));
// Search index per card: names, sector, founders, sharks, full description and product names, in both languages.
const indexText = (x: (typeof startups)[number]) => norm([x.name.en, x.name.ar, x.category, x.category && category(x.category, 'ar'),
  ...(x.founders ?? []).flatMap((n) => [n, arName.get(founderId(n))]), ...(x.deal?.sharks ?? []).flatMap((n) => [n, shark(n, 'ar')]), x.description.en, x.description.ar, ...((x as any).services?.en ?? []).map((v: any) => v.name), ...((x as any).services?.ar ?? []).map((v: any) => v.name)].join(' '));

const site = new URL(import.meta.env.BASE_URL, Astro.site).href;
const jsonld = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: s.title,
  itemListElement: startups.map((x, i) => ({ '@type': 'ListItem', position: i + 1, name: x.name[lang], url: `${ROOT}${dir(lang)}${x.id}/`, item: { '@id': ID.startup(x.id) } })),
};
---
<Base lang={lang} jsonld={jsonld} card={listCard(s.title, s.tagline, startups, lang, lang === 'ar' ? 'كل المواسم والحلقات' : 'Every season and episode')} altPath={`${pre(lang === 'ar' ? 'en' : 'ar')}/`}>
  <section class="stage" aria-labelledby="hero-title">
    <div class="container stage-in">
      <div class="hero-copy">
        <h1 id="hero-title">{s.heroTitle.split(/(?<=،|\.)\s+/).map((line) => <span>{line}{' '}</span>)}</h1>
        <p class="sub">{s.heroSub}</p>
      </div>
      {featured && <figure class="hero-feature">
        <img class="hero-photo" src={`${base}/hero/al-ahram-cookware.webp`} width="640" height="720" alt={featured.founders?.map((n) => founders.find((f) => f.key === n)?.name[lang] ?? n).join(ar ? ' و' : ' and ')} loading="eager" fetchpriority="high" />
        <figcaption>
          <a class="feature-source" href={`https://www.youtube.com/watch?v=${featured.video}`}>CBC · {seasonLabel(featured.season, lang)}</a>
          <a class="feature-link" href={`${base}${pre(lang)}/${featured.id}/`}>
            <span><strong>{featured.name[lang]}</strong><small>{s.finalDeal} · {money(featured.deal?.amountEGP, lang)}</small></span>
            <svg class="feature-arrow" viewBox="0 0 24 24" width="24" height="24" aria-hidden="true"><path d="M4 12h16m-6-6 6 6-6 6" fill="none" stroke="currentColor" stroke-width="1.5" /></svg>
          </a>
        </figcaption>
      </figure>}
    </div>
    <div class="hero-tools">
      <div class="container tools-in">
        <div class="hero-search">
          <label class="search-label" for="q">{ar ? 'ابحث في الدليل' : 'Search the directory'}</label>
          <div class="search">
            <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><circle cx="11" cy="11" r="7" fill="none" stroke="currentColor" stroke-width="2"/><path d="m20 20-3.5-3.5" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
            <input id="q" type="search" placeholder={ar ? 'ابحث في التانك…' : 'Search the tank…'} autocomplete="off" enterkeyhint="search" />
            <kbd aria-hidden="true">/</kbd>
            <div class="suggest" id="suggest" role="listbox" hidden></div>
          </div>
        </div>
        <dl class="totals">
          <div><dt>{s.statStartups}</dt><dd>{num(startups.length, lang)}</dd></div>
          <div><dt>{s.statDeals}</dt><dd>{num(deals.length, lang)}</dd></div>
          <div><dt>{s.statInvested}</dt><dd>{money(invested, lang)}</dd></div>
        </dl>
      </div>
    </div>
  </section>

  <div class="container episode-notice"><EpisodePreview lang={lang} compact /></div>

  <section class="container" aria-labelledby="all">
    <div class="sechead"><h2 id="all">{s.allStartups}</h2></div>
    <div class="toolbar">
      <div class="chips" role="group" aria-label={s.season} data-key="s">
        <button type="button" class="chip" data-v="" aria-pressed="true">{s.all}</button>
        {[...seasons].sort((a, b) => (a.season || 99) - (b.season || 99)).map((x) => <button type="button" class="chip" data-v={x.season} aria-pressed="false">{seasonLabel(x.season, lang)}</button>)}
      </div>
      <div class="chips" role="group" aria-label={s.finalDeal} data-key="d">
        <button type="button" class="chip" data-v="" aria-pressed="true">{s.all}</button>
        <button type="button" class="chip" data-v="1" aria-pressed="false">{s.deal}</button>
        <button type="button" class="chip" data-v="0" aria-pressed="false">{s.noDeal}</button>
      </div>
      <div class="selects">
        <select id="c" aria-label={s.category}>
          <option value="">{s.allCategories}</option>
          {categories.map((c) => <option value={c}>{category(c, lang)}</option>)}
        </select>
        <select id="sh" aria-label={s.sharks}>
          <option value="">{s.allSharks}</option>
          {sharks.filter((p) => p.deals.length).map((p) => <option value={p.key}>{p.name[lang]}</option>)}
        </select>
        <select id="sort" aria-label={s.sort}>
          <option value="">{s.sortEpisode}</option>
          <option value="name">{s.sortName}</option>
          <option value="oldest">{s.sortOldest}</option>
          <option value="deal">{s.sortDeal}</option>
          <option value="ask">{s.sortAsk}</option>
        </select>
      </div>
    </div>
    <p class="count" aria-live="polite"><strong id="count">{num(startups.length, lang)}</strong> {s.results}</p>

    <ul class="grid" id="grid">
      {startups.map((x, i) => (
        <li
          data-i={i}
          hidden={i >= 24 /* = PAGE in the script: the first layout covers one page, not all 218 cards */}
          data-s={x.season}
          data-d={x.deal?.made == null ? '' : x.deal.made ? '1' : '0'}
          data-c={x.category ?? ''}
          data-name={x.name[lang]}
          data-amount={x.deal?.made ? x.deal.amountEGP ?? 0 : -1}
          data-ask={x.ask?.amountEGP ?? -1}
          data-sh={(x.deal?.made ? x.deal.sharks ?? [] : []).join('|')}
          data-text={indexText(x)}
        >
          <a class="card" href={`${base}${pre(lang)}/${x.id}/`}>
            <span class="pic"><Shot id={x.id} name={x.name[lang]} lang={lang} video={x.video} />{x.deal?.made === true ? <i class="ok">{s.deal}</i> : x.deal?.made === false ? <i class="no">{s.noDeal}</i> : <i class="unk">{ar ? 'غير مؤكدة' : 'Unconfirmed'}</i>}</span>
            <div class="body">
              <p class="meta">{seasonLabel(x.season, lang, true)}{x.episode != null && ` · ${s.episode} ${num(x.episode, lang)}`}{x.category && ` · ${category(x.category, lang)}`}</p>
              <h3>{x.name[lang]}</h3>
              <p class="desc">{digits(first(x.description[lang]), lang)}</p>
            </div>
            <dl class="nums">
              <div><dt>{s.asked}</dt><dd>{x.ask?.amountEGP != null ? <>{money(x.ask.amountEGP, lang)}{x.ask.equityPct != null && <small> · {pct(x.ask.equityPct, lang)}</small>}</> : '—'}</dd></div>
              <div><dt>{s.deal}</dt><dd class:list={[x.deal?.made && 'ok']}>{x.deal?.made ? (x.deal.amountEGP != null ? <>{money(x.deal.amountEGP, lang)}{x.deal.equityPct != null && <small> · {pct(x.deal.equityPct, lang)}</small>}</> : (ar ? 'غير معلنة' : 'Undisclosed')) : x.deal?.made === false ? (ar ? 'لا' : 'None') : '—'}</dd></div>
            </dl>
            {x.deal?.made && x.deal.sharks?.length ? <div class="by"><Sharks names={x.deal.sharks} lang={lang} /><span>{x.deal.sharks.map((n) => shark(n, lang)).join(ar ? '، ' : ', ')}</span></div> : null}
          </a>
        </li>
      ))}
    </ul>

    <div class="more" id="more-wrap"><button type="button" class="btn btn-ghost" id="more">{s.showMore}</button></div>

    <div class="empty" id="empty" hidden>
      <h2>{s.emptyTitle}</h2>
      <p>{s.emptyText}</p>
      <div class="empty-actions">
        <button type="button" class="btn btn-ghost" id="reset">{s.reset}</button>
        <a class="btn btn-primary" href={suggestUrl}>{s.suggest}</a>
      </div>
    </div>

    <aside class="missing" id="missing">
      <div><h2>{s.missingTitle}</h2><p>{s.missingText}</p></div>
      <a class="btn btn-primary" href={suggestUrl}>{s.suggest}</a>
    </aside>
  </section>

  <div class="container">
    <section class="panel" aria-labelledby="buying">
      <div class="sechead"><h2 id="buying">{ar ? 'مين بيستثمر؟' : "Who's buying?"}</h2><a href={`${base}${pre(lang)}/sharks/`}>{ar ? 'كل المستثمرين' : 'All sharks'}</a></div>
      <p class="hint">{ar ? 'اختر مستثمرًا لترى كل شركة استثمر فيها.' : 'Pick a shark to see every startup they backed.'}</p>
      <ul class="chairs">
        {panel.map((p) => (
          <li><a href={`${base}${pre(lang)}/sharks/${p.id}/`}>
            <Avatar name={p.name.en} seed={p.id} photo={p.photo} size={112} />
            <strong>{p.name[lang]}</strong>
            <em>{num(p.deals.length, lang)}</em>
            <small>{ar ? 'صفقة' : p.deals.length === 1 ? 'deal' : 'deals'}</small>
          </a></li>
        ))}
      </ul>
    </section>

    <section class="seasons" aria-labelledby="ssn">
      <div class="sechead"><h2 id="ssn">{ar ? 'المواسم' : 'Seasons'}</h2></div>
      <ul class="tiles">
        {seasonTiles.map((x) => (
          <li><a class="tile" href={`${base}${pre(lang)}/season/${x.n}/`}>
            <span class="tn">{seasonLabel(x.n, lang)}</span>
            <span class="ty">{digits(x.year, lang)}</span>
            <span class="tc"><b>{num(x.count, lang)}</b> {ar ? 'شركة' : 'startups'} · <b>{num(x.deals, lang)}</b> {ar ? 'صفقة' : 'deals'}</span>
            {x.invested > 0 && <span class="ti">{money(x.invested, lang)}</span>}
          </a></li>
        ))}
      </ul>
    </section>

    <section class="records-section" aria-labelledby="records">
      <div class="sechead"><h2 id="records">{ar ? 'أرقام قياسية' : 'Record figures'}</h2></div>
      <ul class="records">
        {records.map((r) => (
          <li><a class="rec" href={r.href}>
            <span class="rk">{r.k}</span>
            <span class="rv">{r.v}</span>
            <span class="rw">{r.photo && <Avatar name={r.who} seed={r.who} photo={r.photo} size={24} />}{r.who}</span>
          </a></li>
        ))}
      </ul>
    </section>
  </div>
</Base>

<script>
  import { matches } from '../../search.mjs';
  // Filters live in the URL (?q=&s=&d=&c=&sh=&sort=) so any view can be shared or bookmarked, and survive the back button.
  const grid = document.getElementById('grid')!;
  const items = [...grid.children] as HTMLElement[];
  const q = document.getElementById('q') as HTMLInputElement;
  const suggest = document.getElementById('suggest')!;
  const c = document.getElementById('c') as HTMLSelectElement;
  const sort = document.getElementById('sort') as HTMLSelectElement;
  const sh = document.getElementById('sh') as HTMLSelectElement;
  let order = '';
  let zeroTimer: ReturnType<typeof setTimeout>;
  const groups = [...document.querySelectorAll<HTMLElement>('.chips')];
  const fmt = new Intl.NumberFormat(document.documentElement.lang === 'ar' ? 'ar-EG' : 'en-US');
  const collator = new Intl.Collator(document.documentElement.lang);
  const params = new URLSearchParams(location.search);
  const PAGE = 24;
  let limit = PAGE;

  const chipValue = (key: string) => document.querySelector<HTMLElement>(`.chips[data-key="${key}"] [aria-pressed="true"]`)?.dataset.v ?? '';
  const setChip = (group: HTMLElement, v: string) =>
    group.querySelectorAll<HTMLElement>('.chip').forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.v === v)));

  function apply() {
    const state = { q: q.value.trim(), s: chipValue('s'), d: chipValue('d'), c: c.value, sh: sh.value, sort: sort.value };
    let n = 0;
    for (const li of items) {
      const d = li.dataset;
      const show = matches(d.text!, state.q) && (!state.s || d.s === state.s) && (!state.d || d.d === state.d) && (!state.c || d.c === state.c)
        && (!state.sh || d.sh!.split('|').includes(state.sh));
      li.dataset.match = show ? '1' : '';
      if (show) n++;
      li.hidden = !show;
    }
    const by = state.sort === 'name' ? (a: HTMLElement, b: HTMLElement) => collator.compare(a.dataset.name!, b.dataset.name!)
      : state.sort === 'deal' ? (a: HTMLElement, b: HTMLElement) => +b.dataset.amount! - +a.dataset.amount!
      : state.sort === 'ask' ? (a: HTMLElement, b: HTMLElement) => +b.dataset.ask! - +a.dataset.ask!
      : state.sort === 'oldest' ? (a: HTMLElement, b: HTMLElement) => +b.dataset.i! - +a.dataset.i!
      : (a: HTMLElement, b: HTMLElement) => +a.dataset.i! - +b.dataset.i!;
    const sorted = [...items].sort(by);
    // Re-insert the 218 cards only when the order changes (typing in search doesn't reorder).
    if (state.sort !== order) { grid.append(...sorted); order = state.sort; }
    // hide past the limit in display order, not source order
    let shown = 0;
    for (const li of sorted) if (li.dataset.match === '1') li.hidden = ++shown > limit;
    document.getElementById('count')!.textContent = fmt.format(n);
    // Zero-result searches tell us what people look for and don't find (only when analytics is on).
    clearTimeout(zeroTimer);
    if (!n && state.q) zeroTimer = setTimeout(() => (window as any).goatcounter?.count?.({ path: `search-zero/${state.q.toLowerCase()}`, title: state.q, event: true }), 1500);
    document.getElementById('more-wrap')!.hidden = n <= limit;
    document.getElementById('empty')!.hidden = n > 0;
    document.getElementById('missing')!.hidden = n === 0;

    const url = new URL(location.href);
    url.search = new URLSearchParams(Object.entries(state).filter(([, v]) => v)).toString();
    history.replaceState(null, '', url);
    // Keep the page focused on matching results while searching or filtering.
    document.body.classList.toggle('searching', !!(state.q || state.s || state.d || state.c || state.sh));
    // Live suggestions under the box: the first matches, right where the visitor is looking.
    if (state.q) {
      const hits = sorted.filter((li) => li.dataset.match === '1').slice(0, 6);
      suggest.replaceChildren(...hits.map((li) => {
        const a = document.createElement('a'), c = li.querySelector<HTMLAnchorElement>('a.card')!;
        a.href = c.href; a.setAttribute('role', 'option');
        a.innerHTML = `<b></b><small></small>`;
        a.querySelector('b')!.textContent = li.dataset.name!;
        a.querySelector('small')!.textContent = li.querySelector('.meta')?.textContent ?? '';
        return a;
      }));
      const all = document.createElement('button');
      all.type = 'button'; all.className = 'all';
      all.textContent = n ? (document.documentElement.lang === 'ar' ? `كل النتائج (${fmt.format(n)})` : `All results (${fmt.format(n)})`) : (document.documentElement.lang === 'ar' ? 'لا نتائج' : 'No results');
      all.addEventListener('mousedown', (e) => { e.preventDefault(); suggest.hidden = true; document.getElementById('all')!.scrollIntoView({ behavior: 'smooth' }); });
      suggest.append(all);
      suggest.hidden = document.activeElement !== q;
    } else suggest.hidden = true;
  }

  q.value = params.get('q') ?? '';
  c.value = params.get('c') ?? '';
  sort.value = params.get('sort') ?? '';
  sh.value = params.get('sh') ?? '';
  for (const g of groups) {
    setChip(g, params.get(g.dataset.key!) ?? '');
    g.addEventListener('click', (e) => {
      const b = (e.target as HTMLElement).closest<HTMLElement>('.chip');
      if (b) { setChip(g, b.dataset.v!); filter(); }
    });
  }
  const filter = () => { limit = PAGE; apply(); };
  document.getElementById('more')!.addEventListener('click', () => { limit += PAGE * 2; apply(); });
  q.addEventListener('input', filter);
  q.addEventListener('keydown', (e) => {
    if (e.key === 'Enter') { suggest.hidden = true; document.getElementById('all')!.scrollIntoView({ behavior: 'smooth' }); }
    if (e.key === 'Escape') suggest.hidden = true;
    if (e.key === 'ArrowDown') { e.preventDefault(); suggest.querySelector<HTMLElement>('a,button')?.focus(); }
  });
  suggest.addEventListener('keydown', (e) => {
    const els = [...suggest.querySelectorAll<HTMLElement>('a,button')], i = els.indexOf(document.activeElement as HTMLElement);
    if (e.key === 'ArrowDown') { e.preventDefault(); els[Math.min(i + 1, els.length - 1)]?.focus(); }
    if (e.key === 'ArrowUp') { e.preventDefault(); (i <= 0 ? q : els[i - 1]).focus(); }
    if (e.key === 'Escape') { suggest.hidden = true; q.focus(); }
  });
  q.addEventListener('focus', () => { if (q.value.trim()) suggest.hidden = false; });
  q.addEventListener('blur', () => setTimeout(() => { if (!suggest.contains(document.activeElement)) suggest.hidden = true; }, 120));
  c.addEventListener('change', filter);
  sort.addEventListener('change', filter);
  sh.addEventListener('change', filter);
  document.getElementById('reset')!.addEventListener('click', () => {
    q.value = c.value = sort.value = sh.value = '';
    groups.forEach((g) => setChip(g, ''));
    apply();
    q.focus();
  });
  // The header's search button links here as #q.
  const toSearch = () => location.hash === '#q' && q.focus();
  toSearch(); addEventListener('hashchange', toSearch);
  // "/" jumps to search, like GitHub.
  addEventListener('keydown', (e) => {
    if (e.key === '/' && document.activeElement?.tagName !== 'INPUT') { e.preventDefault(); q.focus(); }
  });
  apply();
</script>

<style>
  .stage { background: var(--navy); color: var(--on-dark); --focus: var(--focus-inverse); }
  .stage-in { display: grid; grid-template-columns: minmax(0, 1fr); align-items: center; gap: 24px; padding-block: 24px 32px; }
  .stage h1 { color: var(--on-dark); font-family: var(--serif); font-weight: 700; font-style: normal; font-size: clamp(2.75rem, 5.8vw, 5.25rem); line-height: 1.02; }
  .stage h1 span { display: block; }
  .stage h1 span + span { color: var(--gold-light); }
  :global([dir='rtl']) .stage h1 { line-height: 1.3; }
  :global([dir='rtl']) .stage h1 span:first-child { font-size: .68em; }
  .sub { max-width: 48ch; margin: 20px 0 0; color: var(--on-dark-muted); font-size: .9375rem; line-height: 1.7; }
  .hero-feature { display: grid; grid-template-columns: 88px minmax(0, 1fr); align-items: center; gap: 20px; min-width: 0; margin: 0; }
  .hero-photo { display: block; width: 88px; height: 88px; object-fit: cover; object-position: center 25%; filter: grayscale(1); }
  .hero-feature figcaption { min-width: 0; }
  .feature-source { display: inline-flex; align-items: center; min-height: 44px; color: var(--on-dark-muted); font-size: .75rem; text-decoration: none; white-space: nowrap; }
  .feature-link { display: flex; align-items: center; justify-content: space-between; gap: 16px; min-height: 48px; color: var(--on-dark); text-decoration: none; }

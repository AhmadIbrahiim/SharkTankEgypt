---
import Base from '../../../../../layouts/Base.astro';
import Listing from '../../../../../components/Listing.astro';
import Faq from '../../../../../components/Faq.astro';
import Chips from '../../../../../components/Chips.astro';
import { langs, seg, pre, listCard, seasonLabel, type Lang } from '../../../../../config';
import { sharkSeasons, sharkSeasonFaq } from '../../../../../faq';

export const getStaticPaths = () => langs.flatMap((lang) => sharkSeasons.map(({ p, n, items }) => ({ params: { lang: seg(lang), id: p.id, n: String(n) }, props: { p, n, items } })));
const lang = (Astro.params.lang ?? 'ar') as Lang;
const { p, n, items } = Astro.props as (typeof sharkSeasons)[number];
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const nm = p.name[lang], label = seasonLabel(n, lang);
const title = lang === 'ar' ? `صفقات ${nm} في شارك تانك مصر ${label}` : `${nm}'s deals in Shark Tank Egypt ${label}`;
const intro = lang === 'ar' ? `كل الشركات التي استثمر فيها ${nm} (${p.name.en}) في ${label} من شارك تانك مصر، مع قيمة كل صفقة والحصة.` : `Every startup ${nm} (${p.name.ar}) invested in during Shark Tank Egypt ${label}, with the amount and equity of each deal.`;
const others = sharkSeasons.filter((x) => x.p.id === p.id && x.n !== n).map((x) => ({ href: `${base}${pre(lang)}/sharks/${p.id}/season/${x.n}/`, label: seasonLabel(x.n, lang) }));
---
<Base lang={lang} title={title} description={intro} card={listCard(title, intro, items, lang, label)} image={p.photo?.url} altPath={`${pre(lang === 'ar' ? 'en' : 'ar')}/sharks/${p.id}/season/${n}/`}>
  <Listing lang={lang} title={title} intro={intro} items={items} />
  <div class="container">
    <Faq lang={lang} items={sharkSeasonFaq(p, n, lang)} />
    <Chips title={lang === 'ar' ? `صفقات ${nm} في مواسم أخرى` : `${nm} in other seasons`} links={[{ href: `${base}${pre(lang)}/sharks/${p.id}/`, label: nm }, ...others]} />
  </div>
</Base>

---
import Base from '../../../layouts/Base.astro';
import { ID, ROOT } from '../../../schema';
import Listing from '../../../components/Listing.astro';
import Faq from '../../../components/Faq.astro';
import Chips from '../../../components/Chips.astro';
import { langs, seg, pre, listCard, type Lang, dir } from '../../../config';
import { rankings } from '../../../faq';

export const getStaticPaths = () => langs.flatMap((lang) => rankings.map((r) => ({ params: { lang: seg(lang), id: r.id }, props: { r } })));
const lang = (Astro.params.lang ?? 'ar') as Lang;
const { r } = Astro.props as { r: (typeof rankings)[number] };
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const site = new URL(import.meta.env.BASE_URL, Astro.site).href;
const jsonld = { '@context': 'https://schema.org', '@type': 'ItemList', name: r.title[lang], description: r.intro[lang],
  itemListElement: r.items.map((x, i) => ({ '@type': 'ListItem', position: i + 1, name: x.name[lang], url: `${ROOT}${dir(lang)}${x.id}/`, item: { '@id': ID.startup(x.id) } })) };
---
<Base lang={lang} title={r.title[lang]} description={r.intro[lang]} card={listCard(r.title[lang], r.intro[lang], r.items, lang, lang === 'ar' ? 'قوائم شارك تانك مصر' : 'Shark Tank Egypt rankings')} jsonld={jsonld} altPath={`${pre(lang === 'ar' ? 'en' : 'ar')}/top/${r.id}/`}>
  <Listing lang={lang} title={r.title[lang]} intro={r.intro[lang]} items={r.items} ranked />
  <div class="container">
    <Faq lang={lang} items={r.faq(lang)} />
    <Chips title={lang === 'ar' ? 'قوائم أخرى' : 'More rankings'} links={rankings.filter((x) => x !== r).map((x) => ({ href: `${base}${pre(lang)}/top/${x.id}/`, label: x.title[lang] }))} />
  </div>
</Base>
